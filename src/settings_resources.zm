pub fn visible_rect(spec: &ControlSpec, canvas_width: f64, canvas_height: f64) -> ui.Rect:
    let height = if spec.closed_h > 0.0: spec.closed_h else: spec.h
    ui_geometry.settings_child_rect(canvas_width, canvas_height, spec.x, spec.y, spec.w, height)

pub fn checkbox_visual_state(enabled: bool, checked: bool, focused: bool, hovered: bool, pressed: bool) -> i64:
    if not enabled:
        if checked: return 3
        return 1
    if pressed and hovered:
        if checked: return 9
        return 8
    if hovered:
        if checked: return 7
        return 6
    if focused:
        if checked: return 5
        return 4
    if checked: return 2
    0

pub fn checkbox_result(enabled: bool, checked: bool) -> bool:
    if enabled: return not checked
    checked

pub fn combo_visual_state(enabled: bool, focused: bool, hovered: bool, pressed: bool, open: bool) -> i64:
    if not enabled: return 1
    if open: return 5
    if pressed and hovered: return 4
    if hovered: return 3
    if focused: return 2
    0

pub fn combo_item_visual_state(focused: bool, hovered: bool, pressed: bool) -> i64:
    if pressed and hovered: return 3
    if hovered: return 2
    if focused: return 1
    0

pub fn combo_arrow_pixel_rgb(row: i64, col: i64, dark: bool) -> i64:
    # 10x6 raster sampled from the enabled Windows 3.5.2 language combo.
    # The dark capture uses the same silhouette with its native dark palette.
    if row == 0 and (col == 1 or col == 8): return if dark: 0x5a5a5a else: 0xb3b3b3
    if row == 1:
        if col == 0 or col == 9: return if dark: 0x474747 else: 0xd5d5d5
        if col == 1 or col == 8: return if dark: 0x8f8f8f else: 0x565656
        if col == 2 or col == 7: return if dark: 0x676767 else: 0x9b9b9b
    if row == 2:
        if col == 1 or col == 8: return if dark: 0x474747 else: 0xd5d5d5
        if col == 2 or col == 7: return if dark: 0x8f8f8f else: 0x565656
        if col == 3 or col == 6: return if dark: 0x676767 else: 0x9b9b9b
    if row == 3:
        if col == 2 or col == 7: return if dark: 0x474747 else: 0xd5d5d5
        if col == 3 or col == 6: return if dark: 0x8f8f8f else: 0x565656
        if col == 4 or col == 5: return if dark: 0x676767 else: 0x9b9b9b
    if row == 4:
        if col == 3 or col == 6: return if dark: 0x474747 else: 0xd5d5d5
        if col == 4 or col == 5: return if dark: 0x8f8f8f else: 0x565656
    if row == 5 and (col == 4 or col == 5): return if dark: 0x474747 else: 0xd5d5d5
    0

fn test_manifest_and_dialog_templates_match_pinned_sources():
    let app_manifest = manifest()
    assert(app_manifest.common_controls_type == "win32")
    assert(app_manifest.common_controls_name == "Microsoft.Windows.Common-Controls")
    assert(app_manifest.common_controls_version == "6.0.0.0")
    assert(app_manifest.common_controls_processor_architecture == "*" and app_manifest.common_controls_language == "*")
    assert(app_manifest.common_controls_public_key_token == "6595b64144ccf1df")
    assert(app_manifest.requested_execution_level == "asInvoker" and not app_manifest.ui_access)
    assert(app_manifest.dpi_aware and app_manifest.dpi_awareness == "PerMonitorV2, PerMonitor")
    assert(app_manifest.disable_window_filtering and app_manifest.printer_driver_isolation)
    assert(app_manifest.long_path_aware and app_manifest.active_code_page == "UTF-8")
    assert(app_manifest.heap_type == "SegmentHeap")
    assert(app_manifest.max_version_tested == "10.0.19045.0" and app_manifest.supported_os_count == 4)
    assert(app_manifest.supported_os_ids == "35138b9a-5d96-4fbd-8e2d-a2440225f93a;4a2f28e3-53b9-4441-ba9c-d69d4a4a6e38;1f676c76-80e1-4239-95bb-83d0f6d0da78;8e0f7a12-bfb3-4fe8-b9a5-48fd50a15a9a")
    for page in 0..5:
        let spec = dialog(page)
        assert(spec.id == 101 + page)
        assert(spec.w == 260.0 and spec.h == 168.0)
        assert(spec.style == "WS_CHILD | WS_SYSMENU | WS_TABSTOP | WS_GROUP | DS_SHELLFONT | DS_CONTROL")
        assert(spec.exstyle == "WS_EX_CONTROLPARENT")
        assert(spec.font_points == 8.0 and spec.font_face == "Ms Shell Dlg")

fn test_every_control_in_each_settings_resource_has_a_fixture():
    let general = [107,116,117,118,120,119,121,108,122,123]
    let memory = [109,124,110,125,126,127,128,129,130,111,131,132]
    let appearance = [107,133,134,135,136,137,112,138,139,140]
    let tray = [113,141,142,143,144,145,146,114,147,148,149,150,115,152,151]
    let advanced = [107,153,154]
    for id in general:
        let spec = lookup(0, id)
        assert(spec.kind != "unknown" and spec.dialog_id == 101 and spec.state_source != "unknown")
        assert(spec.style != "" and spec.class_style != "")
        assert(spec.x >= 0.0 and spec.y >= 0.0 and spec.w >= 0.0 and spec.h >= 0.0)
    for id in memory:
        let spec = lookup(1, id)
        assert(spec.kind != "unknown" and spec.dialog_id == 102 and spec.state_source != "unknown")
        assert(spec.style != "" and spec.class_style != "")
        assert(spec.x >= 0.0 and spec.y >= 0.0 and spec.w >= 0.0 and spec.h >= 0.0)
    for id in appearance:
        let spec = lookup(2, id)
        assert(spec.kind != "unknown" and spec.dialog_id == 103 and spec.state_source != "unknown")
        assert(spec.style != "" and spec.class_style != "")
        assert(spec.x >= 0.0 and spec.y >= 0.0 and spec.w >= 0.0 and spec.h >= 0.0)
    for id in tray:
        let spec = lookup(3, id)
        assert(spec.kind != "unknown" and spec.dialog_id == 104 and spec.state_source != "unknown")
        assert(spec.style != "" and spec.class_style != "")
        assert(spec.x >= 0.0 and spec.y >= 0.0 and spec.w >= 0.0 and spec.h >= 0.0)
    for id in advanced:
        let spec = lookup(4, id)
        assert(spec.kind != "unknown" and spec.dialog_id == 105 and spec.state_source != "unknown")
        assert(spec.style != "" and spec.class_style != "")
        assert(spec.x >= 0.0 and spec.y >= 0.0 and spec.w >= 0.0 and spec.h >= 0.0)
    assert(lookup(0, 1000).kind == "unknown")

fn test_resource_classes_styles_rectangles_and_runtime_state_are_distinct():
    let group = lookup(0, 107)
    assert(group.kind == "groupbox" and group.class_name == "Button")
    assert(group.class_style == "BS_GROUPBOX" and group.style == "WS_CHILD | WS_VISIBLE | BS_GROUPBOX")
    assert(group.x == 0.0 and group.y == 0.0 and group.w == 260.0 and group.h == 90.0)
    let checkbox = lookup(1, 125)
    assert(checkbox.class_style == "BS_AUTOCHECKBOX | BS_MULTILINE")
    assert(checkbox.style == "WS_CHILD | WS_VISIBLE | WS_TABSTOP | BS_AUTOCHECKBOX | BS_MULTILINE")
    assert(checkbox.x == 8.0 and checkbox.y == 102.0 and checkbox.w == 194.0 and checkbox.h == 12.0)
    let hint = lookup(0, 122)
    assert(hint.class_name == "Static" and hint.class_style == "SS_CENTERIMAGE")
    assert(hint.style == "WS_CHILD | WS_VISIBLE | SS_CENTERIMAGE" and hint.x == 8.0 and hint.y == 104.0)
    let combo = lookup(0, 123)
    assert(combo.kind == "combobox" and combo.class_name == "ComboBox")
    assert(combo.class_style == "CBS_DROPDOWNLIST | CBS_HASSTRINGS | WS_VSCROLL | WS_TABSTOP")
    assert(combo.style == "WS_CHILD | WS_VISIBLE | CBS_DROPDOWNLIST | CBS_HASSTRINGS | WS_VSCROLL | WS_TABSTOP")
    assert(combo.x == 128.0 and combo.y == 104.0 and combo.w == 124.0 and combo.h == 30.0 and combo.closed_h == 13.0)
    assert(lookup(3, 148).closed_h == 12.0 and not lookup(3, 148).linux_enabled)
    let edit = lookup(1, 126)
    assert(edit.class_name == "Edit" and edit.w == 44.0)
    assert(edit.style == "WS_CHILD | WS_VISIBLE | ES_LEFT | WS_BORDER | WS_TABSTOP | ES_AUTOHSCROLL | ES_NUMBER | ES_MULTILINE")
    assert(lookup(1, 127).class_name == "msctls_updown32" and lookup(1, 127).w == 0.0)
    assert(lookup(1, 132).class_name == "msctls_hotkey32")
    assert(lookup(1, 124).class_name == "SysListView32")
    assert(lookup(2, 139).class_style == "BS_PUSHBUTTON")
    assert(lookup(2, 139).style == "WS_CHILD | WS_VISIBLE | WS_TABSTOP | BS_PUSHBUTTON")
    assert(group.resource_style_enabled and group.exstyle == "")

fn test_settingsproc_check_states_and_non_elevated_disables_are_recorded():
    assert(lookup(0, 120).checked and lookup(0, 120).state_source == "SettingsProc: IsShowReductConfirmation default TRUE")
    assert(lookup(2, 136).checked and lookup(3, 151).checked and lookup(3, 152).checked)
    assert(not lookup(0, 116).checked and not lookup(1, 125).checked and not lookup(4, 153).checked)
    assert(not lookup(0, 119).win32_non_elevated_enabled)
    for id in [125,126,127,128,129,130,131,132]:
        assert(not lookup(1, id).win32_non_elevated_enabled)
    assert(lookup(0, 116).resource_style_enabled and lookup(0, 116).win32_non_elevated_enabled and not lookup(0, 116).linux_enabled)
    assert(lookup(0, 123).resource_style_enabled and lookup(0, 123).win32_non_elevated_enabled and lookup(0, 123).linux_enabled)
    assert(lookup(1, 125).resource_style_enabled and not lookup(1, 125).win32_non_elevated_enabled and not lookup(1, 125).linux_enabled)

fn test_checkbox_visual_states_and_disabled_activation():
    assert(checkbox_visual_state(true, false, false, false, false) == 0)
    assert(checkbox_visual_state(false, false, false, true, true) == 1)
    assert(checkbox_visual_state(false, true, false, true, true) == 3)
    assert(checkbox_visual_state(true, false, true, false, false) == 4)
    assert(checkbox_visual_state(true, true, true, false, false) == 5)
    assert(checkbox_visual_state(true, false, false, true, false) == 6)
    assert(checkbox_visual_state(true, true, false, true, false) == 7)
    assert(checkbox_visual_state(true, false, false, true, true) == 8)
    assert(checkbox_visual_state(true, true, false, true, true) == 9)
    assert(checkbox_visual_state(true, false, false, false, true) == 0)
    assert(checkbox_result(false, true) and not checkbox_result(false, false))
    assert(checkbox_result(true, false) and not checkbox_result(true, true))

fn test_combo_visual_states_respect_press_hover_focus_and_disabled_semantics():
    assert(combo_visual_state(true, false, false, false, false) == 0)
    assert(combo_visual_state(false, true, true, true, true) == 1)
    assert(combo_visual_state(true, true, false, false, false) == 2)
    assert(combo_visual_state(true, false, true, false, false) == 3)
    assert(combo_visual_state(true, false, true, true, false) == 4)
    assert(combo_visual_state(true, false, false, true, false) == 0)
    assert(combo_visual_state(true, true, true, true, true) == 5)
    assert(combo_item_visual_state(false, false, false) == 0)
    assert(combo_item_visual_state(true, false, false) == 1)
    assert(combo_item_visual_state(false, true, false) == 2)
    assert(combo_item_visual_state(false, true, true) == 3)
    assert(combo_item_visual_state(false, false, true) == 0)

fn test_combo_arrow_raster_matches_pinned_light_and_dark_captures():
    let mut light_pixels = 0
    let mut dark_pixels = 0
    for row in 0..6:
        for col in 0..10:
            if combo_arrow_pixel_rgb(row, col, false) != 0: light_pixels += 1
            if combo_arrow_pixel_rgb(row, col, true) != 0: dark_pixels += 1
    assert(light_pixels == 26 and dark_pixels == 26)
    assert(combo_arrow_pixel_rgb(0, 1, false) == 0xb3b3b3)
    assert(combo_arrow_pixel_rgb(1, 1, false) == 0x565656)
    assert(combo_arrow_pixel_rgb(3, 4, false) == 0x9b9b9b)
    assert(combo_arrow_pixel_rgb(5, 5, false) == 0xd5d5d5)
    assert(combo_arrow_pixel_rgb(0, 1, true) == 0x5a5a5a)
    assert(combo_arrow_pixel_rgb(1, 1, true) == 0x8f8f8f)
    assert(combo_arrow_pixel_rgb(3, 4, true) == 0x676767)
    assert(combo_arrow_pixel_rgb(5, 5, true) == 0x474747)
    assert(combo_arrow_pixel_rgb(-1, 0, false) == 0)
    assert(combo_arrow_pixel_rgb(6, 9, true) == 0)

