# SPDX-License-Identifier: GPL-3.0-or-later
# Resource map transcribed from the pinned Mem Reduct v3.5.2 resources.
# Source: src/resource.rc, src/resource.h, src/res/manifest.xml, and
# SettingsProc::RM_INITIALIZE in src/main.c at
# 2f5c55d15f69a2c88859e036b16c6f4c971e1968.
# `resource_style_enabled` describes WS_DISABLED in the template; Win32's
# non-elevated runtime enablement and this Linux build's capability stay separate.
use std/ui
use ui_geometry

pub struct ControlSpec:
    page: i64
    dialog_id: i64
    id: i64
    symbol: string
    kind: string
    class_name: string
    class_style: string
    style: string
    exstyle: string
    x: f64
    y: f64
    w: f64
    h: f64
    closed_h: f64
    resource_style_enabled: bool
    win32_non_elevated_enabled: bool
    linux_enabled: bool
    checked: bool
    state_source: string

pub struct DialogSpec:
    id: i64
    symbol: string
    style: string
    exstyle: string
    x: f64
    y: f64
    w: f64
    h: f64
    font_points: f64
    font_face: string

pub struct ManifestSpec:
    common_controls_type: string
    common_controls_name: string
    common_controls_version: string
    common_controls_processor_architecture: string
    common_controls_language: string
    common_controls_public_key_token: string
    requested_execution_level: string
    ui_access: bool
    dpi_aware: bool
    dpi_awareness: string
    disable_window_filtering: bool
    printer_driver_isolation: bool
    long_path_aware: bool
    active_code_page: string
    heap_type: string
    max_version_tested: string
    supported_os_ids: string
    supported_os_count: i64

pub fn manifest() -> ManifestSpec:
    ManifestSpec(
        common_controls_type: "win32",
        common_controls_name: "Microsoft.Windows.Common-Controls",
        common_controls_version: "6.0.0.0",
        common_controls_processor_architecture: "*",
        common_controls_language: "*",
        common_controls_public_key_token: "6595b64144ccf1df",
        requested_execution_level: "asInvoker",
        ui_access: false,
        dpi_aware: true,
        dpi_awareness: "PerMonitorV2, PerMonitor",
        disable_window_filtering: true,
        printer_driver_isolation: true,
        long_path_aware: true,
        active_code_page: "UTF-8",
        heap_type: "SegmentHeap",
        max_version_tested: "10.0.19045.0",
        supported_os_ids: "35138b9a-5d96-4fbd-8e2d-a2440225f93a;4a2f28e3-53b9-4441-ba9c-d69d4a4a6e38;1f676c76-80e1-4239-95bb-83d0f6d0da78;8e0f7a12-bfb3-4fe8-b9a5-48fd50a15a9a",
        supported_os_count: 4
    )

pub fn dialog(page: i64) -> DialogSpec:
    let id = 101 + page
    let symbol = if page == 0: "IDD_SETTINGS_GENERAL" elif page == 1: "IDD_SETTINGS_MEMORY" elif page == 2: "IDD_SETTINGS_APPEARANCE" elif page == 3: "IDD_SETTINGS_TRAY" else: "IDD_SETTINGS_ADVANCED"
    DialogSpec(
        id: id,
        symbol: symbol,
        style: "WS_CHILD | WS_SYSMENU | WS_TABSTOP | WS_GROUP | DS_SHELLFONT | DS_CONTROL",
        exstyle: "WS_EX_CONTROLPARENT",
        x: 0.0,
        y: 0.0,
        w: 260.0,
        h: 168.0,
        font_points: 8.0,
        font_face: "Ms Shell Dlg"
    )

fn initial_check_state(page: i64, id: i64) -> bool:
    # Clean-profile preview values from the pinned Windows baseline. Some
    # upstream values are user/configuration-derived; state_source() records
    # that they are not encoded in the .rc template.
    if id == 120 or id == 121 or id == 136 or id == 151 or id == 152: return true
    false

fn check_state_source(page: i64, id: i64, is_checkbox: bool) -> string:
    if not is_checkbox: return "not-applicable"
    if page == 0:
        if id == 116: return "SettingsProc: AlwaysOnTop default FALSE"
        if id == 117: return "SettingsProc: _r_autorun_isenabled runtime state"
        if id == 118: return "SettingsProc: IsStartMinimized default FALSE"
        if id == 119: return "SettingsProc: _r_skipuac_isenabled; disabled when not elevated"
        if id == 120: return "SettingsProc: IsShowReductConfirmation default TRUE"
        if id == 121: return "SettingsProc: _r_update_isenabled runtime state"
    elif page == 1:
        if id == 125: return "SettingsProc: AutoreductEnable default FALSE"
        if id == 128: return "SettingsProc: AutoreductIntervalEnable default FALSE"
        if id == 131: return "SettingsProc: HotkeyCleanEnable default FALSE"
    elif page == 2:
        if id == 133: return "SettingsProc: TrayUseTransparency default FALSE"
        if id == 134: return "SettingsProc: TrayShowBorder default FALSE"
        if id == 135: return "SettingsProc: TrayRoundCorners default FALSE"
        if id == 136: return "SettingsProc: TrayChangeBg default TRUE"
        if id == 137: return "SettingsProc: TrayUseAntialiasing default FALSE"
    elif page == 3:
        if id == 151: return "SettingsProc: IsNotificationsSound default TRUE"
        if id == 152: return "SettingsProc: BalloonCleanResults default TRUE"
    elif page == 4:
        if id == 153: return "SettingsProc: IsAllowStandbyListCleanup default FALSE"
        if id == 154: return "SettingsProc: LogCleanResults default FALSE"
    "resource.rc does not encode checked state"

fn win32_non_elevated_enabled(page: i64, id: i64) -> bool:
    # main.c checks the actual token elevation at runtime. The manifest's
    # asInvoker request alone does not prove that the process is unelevated.
    # UAC and cleanup/automation controls are disabled in the non-elevated state;
    # buddy inputs follow their disabled parent.
    if id == 119: return false
    if page == 1 and (id == 125 or id == 126 or id == 127 or id == 128 or id == 129 or id == 130 or id == 131 or id == 132): return false
    true

fn effective_style(kind: &string, class_style: &string) -> string:
    let mut style = "WS_CHILD | WS_VISIBLE"
    if kind == "checkbox" or kind == "button":
        style = "WS_CHILD | WS_VISIBLE | WS_TABSTOP"
    elif kind == "edit":
        style = "WS_CHILD | WS_VISIBLE | ES_LEFT | WS_BORDER | WS_TABSTOP"
    f"{style} | {class_style}"

fn item(page: i64, id: i64, kind: string, class_name: string, symbol: string, style: string,
        x: f64, y: f64, w: f64, h: f64, closed_h: f64, linux_enabled: bool) -> ControlSpec:
    let is_checkbox = kind == "checkbox"
    let source = check_state_source(page, id, is_checkbox)
    let effective = effective_style(&kind, &style)
    ControlSpec(
        page: page,
        dialog_id: 101 + page,
        id: id,
        symbol: symbol,
        kind: kind,
        class_name: class_name,
        class_style: style,
        style: effective,
        exstyle: "",
        x: x,
        y: y,
        w: w,
        h: h,
        closed_h: closed_h,
        resource_style_enabled: true,
        win32_non_elevated_enabled: win32_non_elevated_enabled(page, id),
        linux_enabled: linux_enabled,
        checked: initial_check_state(page, id),
        state_source: source
    )

