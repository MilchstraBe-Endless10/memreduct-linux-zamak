# SPDX-License-Identifier: GPL-3.0-or-later
# Provisional conversion for the official Windows 3.5.2 DLU template.
# Calibration parameters are centralized here until authentic Windows font/DPI
# measurements are available; none of these values are pixel-acceptance claims.
use std/ui

pub fn x_dlu_to_logical_px(value: i64) -> i64:
    (value * 56) // 40

pub fn y_dlu_to_logical_px(value: i64) -> i64:
    (value * 12) // 8

pub fn main_client_width_px() -> i64:
    x_dlu_to_logical_px(224)

pub fn main_client_height_px() -> i64:
    y_dlu_to_logical_px(214)

pub fn menu_height_px() -> i64:
    24

pub fn gtk_content_inset_px() -> i64:
    # Total allowance: 12 px left and 12 px bottom after the GTK holder's
    # uniform border is replaced with asymmetric margins.
    24

pub fn main_window_width_px() -> i64:
    main_client_width_px() + gtk_content_inset_px()

pub fn main_window_height_px() -> i64:
    main_client_height_px() + menu_height_px() + gtk_content_inset_px()

fn dlu_x(value: f64) -> f64:
    value * 1.4

fn dlu_y(value: f64) -> f64:
    value * 1.5

fn x_scale(canvas_width: f64) -> f64:
    canvas_width / f64(main_client_width_px())

fn y_scale(canvas_height: f64) -> f64:
    (canvas_height - f64(menu_height_px())) / f64(main_client_height_px())

pub fn x_at_dlu(value: f64, canvas_width: f64) -> f64:
    dlu_x(value) * x_scale(canvas_width)

pub fn y_at_dlu(value: f64, canvas_height: f64) -> f64:
    f64(menu_height_px()) + dlu_y(value) * y_scale(canvas_height)

pub fn dlu_rect(canvas_width: f64, canvas_height: f64, x: f64, y: f64, w: f64, h: f64) -> ui.Rect:
    ui.rect(
        x_at_dlu(x, canvas_width),
        y_at_dlu(y, canvas_height),
        dlu_x(w) * x_scale(canvas_width),
        dlu_y(h) * y_scale(canvas_height)
    )

pub fn main_list_rect(canvas_width: f64, canvas_height: f64) -> ui.Rect:
    dlu_rect(canvas_width, canvas_height, 8.0, 8.0, 208.0, 174.0)

fn group_bit(group: i64) -> i64:
    if group == 0: return 1
    if group == 1: return 2
    4

pub fn group_is_collapsed(collapsed_groups: i64, group: i64) -> bool:
    (collapsed_groups // group_bit(group)) % 2 == 1

pub fn toggle_group_collapse(collapsed_groups: i64, group: i64) -> i64:
    let bit = group_bit(group)
    if group_is_collapsed(collapsed_groups, group): return collapsed_groups - bit
    collapsed_groups + bit

fn group_start_dlu(group: i64, collapsed_groups: i64) -> f64:
    let mut start = 8.0
    for previous in 0..group:
        # The collapsed height is a compact candidate until a Windows collapse-state capture is available.
        if group_is_collapsed(collapsed_groups, previous): start += 22.0
        elif previous == 0: start += 52.0
        else: start += 48.0
    start

pub fn group_title_y_for_mask(group: i64, canvas_height: f64, collapsed_groups: i64) -> f64:
    y_at_dlu(group_start_dlu(group, collapsed_groups), canvas_height)

pub fn metric_row_y_for_mask(group: i64, row: i64, canvas_height: f64, collapsed_groups: i64) -> f64:
    let row_offset = if group == 0: 14.0 else: 12.0
    y_at_dlu(group_start_dlu(group, collapsed_groups) + row_offset + f64(row) * 11.5, canvas_height)

pub fn group_header_rule_y_for_mask(group: i64, canvas_height: f64, collapsed_groups: i64) -> f64:
    # Measured from the official 3.5.2 main screenshot at 96 DPI. The second
    # GroupBox caption sits 3 px higher relative to its border than the others.
    let offset = if group == 1: 5.0 else: 8.0
    group_title_y_for_mask(group, canvas_height, collapsed_groups) + offset

pub fn group_disclosure_rect(group: i64, canvas_width: f64, canvas_height: f64, collapsed_groups: i64) -> ui.Rect:
    ui.rect(
        x_at_dlu(208.0, canvas_width),
        group_title_y_for_mask(group, canvas_height, collapsed_groups) + 1.0,
        dlu_x(10.0) * x_scale(canvas_width),
        12.0
    )

pub fn group_title_y(group: i64, canvas_height: f64) -> f64:
    group_title_y_for_mask(group, canvas_height, 0)

pub fn metric_row_y(group: i64, row: i64, canvas_height: f64) -> f64:
    metric_row_y_for_mask(group, row, canvas_height, 0)

pub fn metric_label_x(canvas_width: f64) -> f64:
    x_at_dlu(8.0, canvas_width)

pub fn metric_title_x(canvas_width: f64) -> f64:
    x_at_dlu(14.0, canvas_width)

pub fn metric_value_x(canvas_width: f64) -> f64:
    x_at_dlu(122.0, canvas_width)

pub fn main_column_rule_x_px(index: i64) -> f64:
    if index == 0: return 163.0
    319.0

pub fn main_column_rule_top_y_px() -> f64:
    36.0

pub fn main_column_rule_bottom_y_px() -> f64:
    318.0

pub fn group_selection_rect(group: i64, canvas_width: f64, canvas_height: f64, collapsed_groups: i64) -> ui.Rect:
    let title_y = group_title_y_for_mask(group, canvas_height, collapsed_groups)
    ui.rect(8.0, title_y - 1.0, min(311.0, canvas_width - 8.0), 21.0)

pub fn metric_row_label_x(canvas_width: f64, row: i64, zh: bool) -> f64:
    let width = if zh: 20.0 elif row == 0: 29.0 elif row == 1: 46.0 else: 74.0
    metric_value_x(canvas_width) - 12.0 - width

pub fn list_right_x(canvas_width: f64) -> f64:
    x_at_dlu(216.0, canvas_width)

pub fn menu_bar_item_rect(index: i64) -> ui.Rect:
    if index == 1: return ui.rect(4.0, 1.0, 40.0, 21.0)
    if index == 2: return ui.rect(44.0, 1.0, 44.0, 21.0)
    if index == 3: return ui.rect(88.0, 1.0, 66.0, 21.0)
    ui.rect(154.0, 1.0, 48.0, 21.0)

pub fn clean_arrow_width_px() -> f64:
    17.0

pub fn menu_row_height_px() -> f64:
    22.0

pub fn root_menu_row_count(menu: i64) -> i64:
    if menu == 1: return 3
    if menu == 2: return 5
    if menu == 3: return 4
    return 3

pub fn root_menu_separator(menu: i64, row: i64) -> bool:
    (menu == 1 and row == 1) or (menu == 2 and row == 3)

fn root_menu_slot_height(menu: i64, row: i64) -> f64:
    if root_menu_separator(menu, row): return 7.0
    menu_row_height_px()

fn root_menu_content_height(menu: i64) -> f64:
    let mut height = 0.0
    for row in 0..root_menu_row_count(menu):
        height += root_menu_slot_height(menu, row)
    height

pub fn clean_row_height_px() -> f64:
    21.0

pub fn popup_inset_px() -> f64:
    2.0

pub fn root_menu_item_rect(root: &ui.Rect, menu: i64, row: i64) -> ui.Rect:
    let inset = popup_inset_px()
    let mut y = root.y + inset
    for previous in 0..row:
        y += root_menu_slot_height(menu, previous)
    ui.rect(root.x + inset, y, root.w - inset * 2.0, root_menu_slot_height(menu, row))

pub fn language_menu_item_rect(popup: &ui.Rect, row: i64) -> ui.Rect:
    let inset = popup_inset_px()
    let row_h = menu_row_height_px()
    ui.rect(popup.x + inset, popup.y + inset + f64(row) * row_h, popup.w - inset * 2.0, row_h)

pub fn clean_menu_item_rect(popup: &ui.Rect, row: i64) -> ui.Rect:
    let inset = popup_inset_px()
    let row_h = clean_row_height_px()
    ui.rect(popup.x + inset, popup.y + inset + f64(row) * row_h, popup.w - inset * 2.0, row_h)

pub fn clean_button_rect(canvas_width: f64, canvas_height: f64) -> ui.Rect:
    let x = x_at_dlu(8.0, canvas_width)
    let right = canvas_width - 6.0
    ui.rect(x, canvas_height - 22.0, right - x, 21.0)

pub fn clean_button_label_x(canvas_width: f64, canvas_height: f64, text_width: f64) -> f64:
    let button = clean_button_rect(canvas_width, canvas_height)
    button.x + (button.w - clean_arrow_width_px() - text_width) / 2.0

# Windows v.3.5.2 release measured at 96 DPI: outer settings window 574x374,
# client area 558x335; child page 390x273 for 260x168 DLU. Linux uses the same
# client target, excluding native decorations and without GTK's default inset.
# This is a measured layout baseline, not cross-theme pixel acceptance.
pub fn settings_page_width_dlu() -> i64:
    260

pub fn settings_page_height_dlu() -> i64:
    168

pub fn settings_client_width_px() -> i64:
    558

pub fn settings_client_height_px() -> i64:
    335

pub fn settings_window_width_px() -> i64:
    settings_client_width_px()

pub fn settings_window_height_px() -> i64:
    settings_client_height_px()

fn settings_page_x_dlu(value: f64) -> f64:
    value * 390.0 / f64(settings_page_width_dlu())

fn settings_page_y_dlu(value: f64) -> f64:
    value * 273.0 / f64(settings_page_height_dlu())

fn settings_x(value: f64, canvas_width: f64) -> f64:
    settings_page_x_dlu(value) * canvas_width / f64(settings_client_width_px())

fn settings_y(value: f64, canvas_height: f64) -> f64:
    settings_page_y_dlu(value) * canvas_height / f64(settings_client_height_px())

fn settings_reference_rect(canvas_width: f64, canvas_height: f64, x: f64, y: f64, w: f64, h: f64) -> ui.Rect:
    ui.rect(
        x * canvas_width / f64(settings_client_width_px()),
        y * canvas_height / f64(settings_client_height_px()),
        w * canvas_width / f64(settings_client_width_px()),
        h * canvas_height / f64(settings_client_height_px())
    )

pub fn settings_dlu_rect(canvas_width: f64, canvas_height: f64, x: f64, y: f64, w: f64, h: f64) -> ui.Rect:
    ui.rect(
        settings_x(x, canvas_width),
        settings_y(y, canvas_height),
        settings_x(w, canvas_width),
        settings_y(h, canvas_height)
    )

pub fn settings_page_rect(canvas_width: f64, canvas_height: f64) -> ui.Rect:
    settings_reference_rect(canvas_width, canvas_height, 156.0, 10.0, 390.0, 273.0)

pub fn settings_nav_rect(canvas_width: f64, canvas_height: f64) -> ui.Rect:
    settings_reference_rect(canvas_width, canvas_height, 12.0, 10.0, 132.0, 312.0)

pub fn settings_nav_item_rect(canvas_width: f64, canvas_height: f64, index: i64) -> ui.Rect:
    settings_reference_rect(canvas_width, canvas_height, 12.0, 10.0 + f64(index) * 20.0, 132.0, 20.0)

pub fn settings_nav_selection_rect(canvas_width: f64, canvas_height: f64, index: i64, zh: bool) -> ui.Rect:
    # Screenshot-measured v3.5.2 TreeView selection bounds at 96 DPI / 100% scale.
    let width = if zh:
        if index == 1 or index == 3: 56.0 else: 32.0
    else:
        if index == 0: 45.0 elif index == 1: 88.0 elif index == 2: 66.0 elif index == 3: 52.0 else: 56.0
    ui.rect(
        27.0 * canvas_width / f64(settings_client_width_px()),
        (12.0 + f64(index) * 20.0) * canvas_height / f64(settings_client_height_px()),
        width * canvas_width / f64(settings_client_width_px()),
        20.0 * canvas_height / f64(settings_client_height_px())
    )

pub fn settings_child_rect(canvas_width: f64, canvas_height: f64, x: f64, y: f64, w: f64, h: f64) -> ui.Rect:
    let page = settings_page_rect(canvas_width, canvas_height)
    let sx = canvas_width / f64(settings_client_width_px())
    let sy = canvas_height / f64(settings_client_height_px())
    ui.rect(page.x + settings_page_x_dlu(x) * sx, page.y + settings_page_y_dlu(y) * sy, settings_page_x_dlu(w) * sx, settings_page_y_dlu(h) * sy)

pub fn settings_list_item_rect(canvas_width: f64, canvas_height: f64, x: f64, y: f64, w: f64, h: f64, row: i64, scrollbar_width: f64) -> ui.Rect:
    let list = settings_child_rect(canvas_width, canvas_height, x, y, w, h)
    # Win32 ListView item bounds have a 2 px inset; the region list reserves its native scrollbar.
    ui.rect(list.x + 2.0, list.y + 2.0 + f64(row) * 17.0, list.w - 4.0 - scrollbar_width, 17.0)

pub fn settings_checkbox_size_px() -> f64:
    13.0

pub fn settings_checkbox_label_inset_px() -> f64:
    14.0

pub fn settings_list_checkbox_inset_px() -> f64:
    4.0

pub fn settings_list_label_inset_px() -> f64:
    21.0

pub fn settings_feedback_rect(canvas_width: f64, canvas_height: f64) -> ui.Rect:
    settings_reference_rect(canvas_width, canvas_height, 156.0, 285.0, 390.0, 12.0)

pub fn settings_reset_rect(canvas_width: f64, canvas_height: f64) -> ui.Rect:
    settings_reference_rect(canvas_width, canvas_height, 153.0, 299.0, 75.0, 23.0)

pub fn settings_close_rect(canvas_width: f64, canvas_height: f64) -> ui.Rect:
    settings_reference_rect(canvas_width, canvas_height, 471.0, 299.0, 75.0, 23.0)

pub fn settings_reset_modal_rect(canvas_width: f64, canvas_height: f64) -> ui.Rect:
    settings_dlu_rect(canvas_width, canvas_height, 112.0, 72.0, 252.0, 72.0)

pub fn settings_modal_button_rect(canvas_width: f64, canvas_height: f64, confirm: bool) -> ui.Rect:
    if confirm: return settings_dlu_rect(canvas_width, canvas_height, 226.0, 118.0, 58.0, 16.0)
    settings_dlu_rect(canvas_width, canvas_height, 292.0, 118.0, 58.0, 16.0)

pub fn menu_root_rect(canvas_width: f64, canvas_height: f64, menu: i64) -> ui.Rect:
    let mut x = 154.0
    let mut w = 198.0
    if menu == 1:
        x = 8.0
        w = 153.0
    elif menu == 2:
        x = 44.0
        w = 256.0
    elif menu == 3:
        x = 88.0
        # Windows measures 337 px; the 313 px production Canvas can safely
        # expose at most 309 px while retaining a 2 px edge inset.
        w = 309.0
    fit_popup_rect(canvas_width, canvas_height, x, 24.0, w, root_menu_content_height(menu) + 4.0)

pub fn language_popup_rect(canvas_width: f64, canvas_height: f64) -> ui.Rect:
    let parent = menu_root_rect(canvas_width, canvas_height, 2)
    let width = 110.0
    let height = 2.0 * menu_row_height_px() + 4.0
    let right_x = parent.right() - popup_inset_px()
    let mut x = right_x
    if x + width > canvas_width - 2.0:
        let left_x = parent.x - width + popup_inset_px()
        if left_x >= 2.0:
            x = left_x
        else:
            x = canvas_width - width - 2.0
    let parent_y = root_menu_item_rect(&parent, 2, 4).y
    fit_popup_rect(canvas_width, canvas_height, x, parent_y, width, height)

pub fn clean_popup_rect(canvas_width: f64, canvas_height: f64, button: &ui.Rect) -> ui.Rect:
    let width = 248.0
    let height = 8.0 * clean_row_height_px() + 4.0
    fit_popup_rect(canvas_width, canvas_height, canvas_width - width - 6.0, button.y - height - 6.0, width, height)

pub fn fit_popup_rect(view_width: f64, view_height: f64, x: f64, y: f64, w: f64, h: f64) -> ui.Rect:
    let width = min(w, max(0.0, view_width - 4.0))
    let height = min(h, max(0.0, view_height - 4.0))
    let left = min(max(2.0, x), max(2.0, view_width - width - 2.0))
    let top = min(max(2.0, y), max(2.0, view_height - height - 2.0))
    ui.rect(left, top, width, height)

fn test_official_main_template_uses_central_dlu_conversion():
    assert(x_dlu_to_logical_px(224) == 313)
    assert(y_dlu_to_logical_px(214) == 321)
    assert(main_client_width_px() == 313)
    assert(main_client_height_px() == 321)

fn test_production_window_is_not_ci_probe_default():
    assert(main_window_width_px() == 337)
    assert(main_window_height_px() == 369)
    assert(main_window_width_px() != 336)
    assert(main_window_height_px() != 348)

fn test_three_group_rows_are_vertical_and_separated():
    for group in 0..3:
        assert(group_title_y(group, 357.0) < metric_row_y(group, 0, 357.0))
        assert(metric_row_y(group, 0, 357.0) < metric_row_y(group, 1, 357.0))
        assert(metric_row_y(group, 1, 357.0) < metric_row_y(group, 2, 357.0))
        let rule_y = group_header_rule_y_for_mask(group, 357.0, 0)
        assert(rule_y > group_title_y(group, 357.0) + 4.0)
        assert(rule_y < group_title_y(group, 357.0) + 9.0)
        if group < 2:
            assert(metric_row_y(group, 2, 357.0) < group_title_y(group + 1, 357.0))

fn test_main_layout_matches_official_96dpi_capture():
    # Coordinates are measured on the verified 3.5.2 screenshot after aligning
    # the Windows HWND client surface with the 337x369 GTK application surface.
    assert(group_title_y(0, 357.0) > 36.0 and group_title_y(0, 357.0) < 37.0)
    assert(group_title_y(1, 357.0) > 117.0 and group_title_y(1, 357.0) < 118.0)
    assert(group_title_y(2, 357.0) > 191.0 and group_title_y(2, 357.0) < 193.0)
    assert(group_header_rule_y_for_mask(0, 357.0, 0) > 44.0 and group_header_rule_y_for_mask(0, 357.0, 0) < 45.0)
    assert(group_header_rule_y_for_mask(1, 357.0, 0) > 122.0 and group_header_rule_y_for_mask(1, 357.0, 0) < 123.0)
    assert(group_header_rule_y_for_mask(2, 357.0, 0) > 199.0 and group_header_rule_y_for_mask(2, 357.0, 0) < 201.0)
    assert(metric_row_y(0, 0, 357.0) > 58.0 and metric_row_y(0, 0, 357.0) < 59.0)
    assert(metric_row_y(1, 0, 357.0) > 135.0 and metric_row_y(1, 0, 357.0) < 137.0)
    assert(metric_row_y(2, 0, 357.0) > 210.0 and metric_row_y(2, 0, 357.0) < 212.0)

fn test_main_metric_columns_follow_compact_reference_alignment():
    let width = 325.0
    let value_x = metric_value_x(width)
    assert(value_x > 177.3 and value_x < 177.5)
    assert(metric_title_x(width) > 20.3 and metric_title_x(width) < 20.4)
    assert(metric_title_x(width) < list_right_x(width) - 20.0)
    assert(metric_row_label_x(width, 2, false) < metric_row_label_x(width, 1, false))
    assert(metric_row_label_x(width, 1, false) < metric_row_label_x(width, 0, false))
    for row in 0..3:
        assert(metric_row_label_x(width, row, true) < value_x - 12.0)

fn test_main_list_separators_and_selected_header_match_official_capture():
    assert(main_column_rule_x_px(0) == 163.0)
    assert(main_column_rule_x_px(1) == 319.0)
    assert(main_column_rule_top_y_px() == 36.0)
    assert(main_column_rule_bottom_y_px() == 318.0)
    let selected = group_selection_rect(2, 325.0, 357.0, 0)
    assert(selected.x == 8.0 and selected.right() == 319.0)
    assert(selected.y > 191.0 and selected.y < 193.0)
    assert(selected.h == 21.0)

fn test_clean_button_matches_official_main_capture():
    let button = clean_button_rect(325.0, 357.0)
    assert(button.x > 11.0 and button.x < 12.0)
    assert(button.right() == 319.0)
    assert(button.y == 335.0 and button.h == 21.0)
    assert(clean_arrow_width_px() == 17.0)
    let text_width = 80.0
    let text_x = clean_button_label_x(325.0, 357.0, text_width)
    assert(text_x - button.x == (button.w - clean_arrow_width_px() - text_width) / 2.0)

fn test_group_collapse_packs_later_groups_and_toggles_cleanly():
    let height = 357.0
    assert(not group_is_collapsed(0, 0))
    let collapsed_first = toggle_group_collapse(0, 0)
    assert(group_is_collapsed(collapsed_first, 0))
    assert(group_title_y_for_mask(0, height, collapsed_first) == group_title_y_for_mask(0, height, 0))
    assert(group_title_y_for_mask(1, height, collapsed_first) < group_title_y_for_mask(1, height, 0))
    assert(group_title_y_for_mask(2, height, collapsed_first) < group_title_y_for_mask(2, height, 0))
    assert(not group_is_collapsed(toggle_group_collapse(collapsed_first, 0), 0))
    assert(toggle_group_collapse(collapsed_first, 1) == 3)

fn test_group_disclosure_and_header_rules_stay_inside_compact_window():
    let width = 325.0
    let height = 357.0
    for mask in 0..8:
        for group in 0..3:
            let disclosure = group_disclosure_rect(group, width, height, mask)
            assert(disclosure.x >= 0.0 and disclosure.right() <= width)
            assert(disclosure.y >= 24.0 and disclosure.bottom() <= height)
            let header_rule = group_header_rule_y_for_mask(group, height, mask)
            assert(header_rule < clean_button_rect(width, height).y)

fn test_all_popup_rectangles_fit_viewport():
    let language = language_popup_rect(325.0, 357.0)
    assert(language.x >= 2.0 and language.y >= 2.0)
    assert(language.right() <= 323.0 and language.bottom() <= 355.0)
    let narrow = language_popup_rect(180.0, 100.0)
    assert(narrow.x >= 2.0 and narrow.y >= 2.0)
    assert(narrow.right() <= 178.0 and narrow.bottom() <= 98.0)
    let button = clean_button_rect(325.0, 357.0)
    let clean = clean_popup_rect(325.0, 357.0, &button)
    assert(clean.x >= 2.0 and clean.y >= 2.0)
    assert(clean.right() <= 323.0 and clean.bottom() <= 355.0)
    for menu in 1..5:
        let root = menu_root_rect(325.0, 357.0, menu)
        assert(root.x >= 2.0 and root.y >= 2.0)
        assert(root.right() <= 323.0 and root.bottom() <= 355.0)

fn test_main_menu_separators_have_distinct_noninteractive_rows():
    assert(root_menu_row_count(1) == 3)
    assert(root_menu_row_count(2) == 5)
    assert(root_menu_row_count(3) == 4)
    assert(root_menu_row_count(4) == 3)
    assert(root_menu_separator(1, 1))
    assert(root_menu_separator(2, 3))
    assert(not root_menu_separator(3, 3))
    let file = menu_root_rect(325.0, 357.0, 1)
    let file_settings = root_menu_item_rect(&file, 1, 0)
    let file_separator = root_menu_item_rect(&file, 1, 1)
    let file_exit = root_menu_item_rect(&file, 1, 2)
    assert(file_settings.bottom() <= file_separator.y)
    assert(file_separator.bottom() <= file_exit.y)
    assert(file_exit.bottom() <= file.bottom() - popup_inset_px())

fn test_resize_keeps_content_inside_compact_canvas():
    let list = main_list_rect(260.0, 270.0)
    let button = clean_button_rect(260.0, 270.0)
    assert(list.x >= 0.0 and list.right() <= 260.0)
    assert(button.x >= 0.0 and button.right() <= 260.0)
    assert(button.bottom() <= 270.0)

fn test_settings_child_template_and_shell_are_distinct():
    assert(settings_page_width_dlu() == 260)
    assert(settings_page_height_dlu() == 168)
    assert(settings_window_width_px() == 558)
    assert(settings_window_height_px() == 335)
    assert(settings_window_width_px() != x_dlu_to_logical_px(260))

fn test_settings_geometry_matches_measured_child_template():
    let w = f64(settings_client_width_px())
    let h = f64(settings_client_height_px())
    let nav = settings_nav_rect(w, h)
    let page = settings_page_rect(w, h)
    let reset = settings_reset_rect(w, h)
    let close = settings_close_rect(w, h)
    assert(page.x == 156.0 and page.y == 10.0 and page.w == 390.0 and page.h == 273.0)
    assert(nav.x == 12.0 and nav.y == 10.0 and nav.w == 132.0 and nav.h == 312.0)
    assert(nav.bottom() == 322.0)
    assert(settings_nav_item_rect(w, h, 4).bottom() < nav.bottom())
    assert(page.right() == 546.0 and page.right() <= w)
    assert(reset.x == 153.0 and reset.y == 299.0 and reset.w == 75.0 and reset.h == 23.0)
    assert(close.x == 471.0 and close.y == 299.0 and close.w == 75.0 and close.h == 23.0)
    assert(close.right() == 546.0 and close.right() <= w)

fn test_settings_navigation_selection_matches_windows_raster_bounds():
    let w = f64(settings_client_width_px())
    let h = f64(settings_client_height_px())
    let english = settings_nav_selection_rect(w, h, 2, false)
    let chinese = settings_nav_selection_rect(w, h, 2, true)
    assert(english.x == 27.0 and english.y == 52.0 and english.w == 66.0 and english.h == 20.0)
    assert(chinese.x == 27.0 and chinese.y == 52.0 and chinese.w == 32.0 and chinese.h == 20.0)

fn test_settings_shell_contains_page_navigation_and_actions():
    let w = f64(settings_client_width_px())
    let h = f64(settings_client_height_px())
    let nav = settings_nav_rect(w, h)
    let page = settings_page_rect(w, h)
    let reset = settings_reset_rect(w, h)
    let close = settings_close_rect(w, h)
    assert(nav.x >= 0.0 and nav.right() < page.x)
    assert(page.right() <= w)
    assert(page.bottom() < reset.y)
    assert(reset.right() <= close.x)
    assert(close.right() <= w)

fn test_settings_checkmark_geometry_matches_native_metrics():
    assert(settings_checkbox_size_px() == 13.0)
    assert(settings_checkbox_label_inset_px() == 14.0)
    assert(settings_list_checkbox_inset_px() == 4.0)
    assert(settings_list_label_inset_px() == 21.0)
