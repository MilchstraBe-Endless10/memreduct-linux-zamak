    if s.xproc_simulation: return 0
    mr_cand_snapshot_verify(
        s.xproc_request_id, s.xproc_target_pid, s.xproc_target_start_time,
        s.xproc_target_uid, s.xproc_target_identity_token,
        s.xproc_target_scope_hash, s.xproc_target_region_digest,
