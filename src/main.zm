extern fn mr_bal_bridge_result_stop_code() -> i64
extern fn mr_bal_bridge_result_requested_value() -> i64
extern fn mr_bal_bridge_result_accepted_value() -> i64
# Execute path: discovering that this needs no privilege is the point. Every
# app scope in this user's slice has a memory.reclaim owned by this user, so the
# balanced clean opens one exact scope by fd and writes the measured-safe form.
extern fn mr_bal_bridge_scope_root() -> string
