# SPDX-License-Identifier: GPL-3.0-or-later
# Mem Reduct Linux — production main window candidate.
# The original Mem Reduct 3.5.2 resources are the layout and interaction source.
# Clean memory runs through the fixed pagecache helper only when this build was
# compiled with MEMREDUCT_ENABLE_PRODUCTION_CLEAN=1 (see ADR 0005). The default
# build keeps the action disabled and says so in the button and status line.
use std/ui
use memory
use ui_geometry
use settings_ui

# Balanced clean (Issue #12): every string the entry point shows comes from a
# pure helper, so the wording is testable without a window and no two paths can
# describe the same run differently. Zamak's FFI is scalar-only, hence the
# set-then-read bridge instead of passing the plan struct.
extern fn mr_bal_bridge_entry(built_in: i64, gate: i64, helper: i64, busy: i64, no_target: i64) -> i64
extern fn mr_bal_bridge_plan_set(state: i64, action: i64, request_bytes: i64, evidence: i64) -> i64
extern fn mr_bal_bridge_plan_action(zh: i64) -> string
