struct MainWindow:
    canvas: ui.Canvas
    settings_canvas: ui.Canvas
    width: f64
    height: f64
    zh: bool
    dark: bool
    menu: i64
    popup: i64
    hover: f64
    pressed: f64
    focus: f64
    menu_focus: f64
    collapsed_groups: i64
    selected_group: i64
    status: string
    mem_total: i64
    mem_available: i64
    swap_total: i64
    swap_free: i64
    page_cache_estimate: i64
    sample_ok: bool
    draw_logged: bool
    test_mode: bool
    test_timeout_ms: i64
    elapsed_ms: i64
    ci_sample_failure_latched: bool
    sample_failure_draw_logged: bool
    clean_simulation: bool
    clean_production: bool
    clean_self: bool
    clean_state: i64
    clean_confirm_focus: i64
    clean_before_available: i64
    # Balanced clean (Issue #12). The plan is built before the menu is drawn so
    # the entry row can say whether there is anything worth doing, and the
    # result is kept separately so a second redraw cannot re-describe the run.
    bal_state: i64
    bal_action: i64
    bal_request_bytes: i64
    bal_evidence: i64
    bal_result_status: i64
    bal_result_stop: i64
    bal_result_requested: i64
    bal_result_accepted: i64
    bal_result_batches_ok: i64
    bal_result_batches_rejected: i64
    bal_result_available_delta: i64
    bal_view: i64
    # The scope the user picked. -1 means none, and no run may happen then.
    bal_scope_index: i64
    bal_scope_count: i64
    xproc_simulation: bool
    main_close_guard_ready: bool
    xproc_view: i64
    xproc_state: i64
    xproc_cancel_status: i64
    xproc_selected: i64
    xproc_scroll: i64
    xproc_focus: i64
    xproc_budget_choice: i64
    xproc_mode_choice: i64
    xproc_target_scope_bytes: i64
    xproc_target_rss_bytes: i64
    xproc_target_private_resident_bytes: i64
    xproc_preflight: i64
    xproc_scan_status: i64
    xproc_target_pid: i64
    xproc_target_start_time: i64
    xproc_target_uid: i64
    xproc_target_identity_token: i64
    xproc_request_id: i64
    xproc_target_scope_hash: i64
    xproc_target_region_digest: i64
    xproc_target_bytes: i64
    xproc_target_regions: i64
    xproc_target_name: string
    xproc_target_app_name: string
    xproc_before_available: i64
    xproc_after_available: i64
    xproc_advised_bytes: i64
    xproc_requested_bytes: i64
    xproc_regions: i64
    xproc_error_code: i64
    xproc_call_count: i64
    xproc_target_rss_before_kib: i64
    xproc_target_rss_after_kib: i64
    xproc_target_swap_before_kib: i64
    xproc_target_swap_after_kib: i64
    xproc_scope_current_before_bytes: i64
    xproc_scope_current_after_bytes: i64
    xproc_scope_anon_before_bytes: i64
    xproc_scope_anon_after_bytes: i64
    xproc_scope_file_before_bytes: i64
    xproc_scope_file_after_bytes: i64
    xproc_scope_swap_before_bytes: i64
    xproc_scope_swap_after_bytes: i64
    preferences_load_status: i64
    settings_open: bool
    settings: settings_ui.State

fn label(zh: bool, en: string, cn: string) -> string:
    if zh: return cn
    return en

fn normalized_key_name(name: string) -> string:
    if name == "\t": return "Tab"
    if name == "\r" or name == "\n": return "Enter"
    if name == "\x1b": return "Escape"
    if name == "Page_Up" or name == "Prior": return "PageUp"
    if name == "Page_Down" or name == "Next": return "PageDown"
    name

fn next_focus_index(focus: f64) -> f64:
    let next = focus + 1.0
    if next > 4.0: return 0.0
    next

fn menu_item_has_keyboard_focus(focus: f64, index: i64) -> bool:
    focus == f64(index)

fn settings_canvas_needs_redraw(settings_open: bool, target: f64) -> bool:
    settings_open and (target == 202.0 or target == 601.0 or target == 602.0)

fn font_policy_name(policy: i64) -> string:
    if policy == 1: return "Liberation Sans"
    if policy == 2: return "system-default"
    "unavailable"

fn preferences_load_feedback(zh: bool, status: i64) -> string:
    if status == 0 or status == 1: return ""
    if status == 2: return label(zh, "Preferences are damaged; defaults are active and saving is blocked.", "设置文件已损坏；当前使用默认值并禁止保存。")
    if status == 3: return label(zh, "Preferences cannot be read; saving is blocked.", "无法读取设置文件；保存已禁用。")
    if status == 4: return label(zh, "Preferences were written by a newer version; this version will not overwrite them.", "设置来自较新版本；当前版本不会覆盖。")
    if status == 5: return label(zh, "Unsafe settings file or path; no settings were followed or changed.", "设置文件或路径不安全；未跟随或更改任何文件。")
    if status == 6: return label(zh, "Settings ownership or permissions are unsafe; saving is blocked.", "设置文件归属或权限不安全；保存已禁用。")
    if status == 7: return label(zh, "User configuration directory is unavailable; settings are not saved.", "用户配置目录不可用；设置不会保存。")
    label(zh, "Settings could not be loaded; saving is blocked.", "无法加载设置；保存已禁用。")

fn preferences_store_feedback(zh: bool, status: i64) -> string:
    if status == 0: return label(zh, "Preference saved", "设置已保存")
    if status == 1: return label(zh, "No preference change", "设置未变化")
    if status == 2: return label(zh, "Not saved; the previous preference file is unchanged.", "未保存；原设置文件保持不变。")
    if status == 3: return label(zh, "Current preference file blocked this change; reload or recover it first.", "当前设置文件阻止了此次修改；请先重新加载或恢复。")
    if status == 4: return label(zh, "New settings are visible, but crash durability is uncertain.", "新设置已可见，但断电持久性无法确认。")
    if status == 5: return label(zh, "Settings recovery is required; the existing file was preserved.", "需要恢复设置；现有文件已保留。")
    if status == 6: return label(zh, "Invalid preference value; nothing was saved.", "设置值无效；未保存。")
    label(zh, "Settings could not be saved.", "设置保存失败。")

fn preferences_store_may_apply(status: i64, values_known: bool) -> bool:
    status == 0 or status == 1 or (status == 4 and values_known)

fn apply_stored_preferences(s: &mut MainWindow, status: i64):
    let known = mr_preferences_values_known() != 0
    if preferences_store_may_apply(status, known):
        let language = mr_preferences_language()
        let theme = mr_preferences_theme()
        if language == 0 or language == 1:
            if theme == 0 or theme == 1:
                s.zh = language == 1
                s.dark = theme == 1
                s.preferences_load_status = 1
                mr_gui_set_main_background(if s.dark: 1 else: 0)
                s.status = preferences_store_feedback(s.zh, status)
                if s.settings_open: s.settings.status = s.status
                s.canvas.redraw()
                if s.settings_open: s.settings_canvas.redraw()
                return
    s.status = preferences_store_feedback(s.zh, status)
    if s.settings_open: s.settings.status = s.status
    s.canvas.redraw()
    if s.settings_open: s.settings_canvas.redraw()

fn persist_language(s: &mut MainWindow, language: i64):
    let result = mr_preferences_set_language(language)
    if s.test_mode: mr_runtime_emit(f"CI_PREFERENCE_SAVE field=language value={language} status={result} known={mr_preferences_values_known() != 0}")
    apply_stored_preferences(s, result)

fn persist_theme(s: &mut MainWindow, theme: i64):
    let result = mr_preferences_set_theme(theme)
    if s.test_mode: mr_runtime_emit(f"CI_PREFERENCE_SAVE field=theme value={theme} status={result} known={mr_preferences_values_known() != 0}")
    apply_stored_preferences(s, result)

fn reset_preferences(s: &mut MainWindow):
    let result = mr_preferences_reset()
    if s.test_mode: mr_runtime_emit(f"CI_PREFERENCE_RESET status={result} known={mr_preferences_values_known() != 0}")
    apply_stored_preferences(s, result)

fn root_menu_target(menu: i64, row: i64) -> f64:
    if menu == 1:
        if row == 0: return 101.0
        if row == 2: return 102.0
    elif menu == 2:
        if row == 0: return 201.0
        if row == 1: return 202.0
        if row == 2: return 203.0
        if row == 4: return 204.0
    elif menu == 3:
        if row == 0: return 301.0
        if row == 1: return 302.0
        if row == 2: return 303.0
        if row == 3: return 304.0
    elif menu == 4:
        if row == 0: return 401.0
        if row == 1: return 402.0
        if row == 2: return 403.0
    return 0.0

fn first_root_menu_target(menu: i64) -> f64:
    for row in 0..ui_geometry.root_menu_row_count(menu):
        let target = root_menu_target(menu, row)
        if target != 0.0: return target
    0.0

fn menu_rect(s: &MainWindow) -> ui.Rect:
    ui_geometry.menu_root_rect(s.width, s.height, s.menu)

fn language_rect(s: &MainWindow) -> ui.Rect:
    ui_geometry.language_popup_rect(s.width, s.height)

fn button_rect(s: &MainWindow) -> ui.Rect:
    ui_geometry.clean_button_rect(s.width, s.height)

fn list_y(s: &MainWindow, dlu: f64) -> f64:
    ui_geometry.y_at_dlu(dlu, s.height)

fn clean_popup_rect(s: &MainWindow) -> ui.Rect:
    let b = button_rect(s)
    ui_geometry.clean_popup_rect(s.width, s.height, &b)

fn clean_confirm_panel(s: &MainWindow) -> ui.Rect:
    ui.rect((s.width - 249.0) / 2.0, (s.height - 104.0) / 2.0, 249.0, 104.0)

fn clean_confirm_button(confirm: bool) -> ui.Rect:
    if confirm: return ui.rect(112.0, 200.0, 78.0, 24.0)
    ui.rect(197.0, 200.0, 70.0, 24.0)

# The balanced entry is offered only when the backend is in this binary AND the
# production gate is open AND the privileged helper answered preflight AND no
# other run is in flight AND at least one eligible scope was found. The last
# condition is the one that stops a "nothing to do" click from looking like a
# successful clean: when there is no target the row is drawn disabled and says
# why, rather than running and reporting zero.
# Refresh the plan from the machine. Called before the menu is drawn and before
# the row is acted on, so the plan a user sees and the plan that runs are the
# same evaluation.
fn bal_refresh(s: &mut MainWindow) -> bool:
    let probe = mr_bal_bridge_plan_probe()
    if probe != 1:
        s.bal_evidence = 0
        s.bal_state = 0
        s.bal_action = 0
        s.bal_request_bytes = 0
        return false
    s.bal_evidence = 1
    s.bal_state = mr_bal_bridge_plan_state_code()
    s.bal_action = mr_bal_bridge_plan_action_code()
    s.bal_request_bytes = mr_bal_bridge_plan_request_bytes()
    return true

fn bal_entry_state(s: &MainWindow) -> i64:
    let busy = if clean_operation_busy(s.clean_state) or xproc_operation_busy(s): 1 else: 0
    # The balanced clean needs neither a privileged helper nor the page-cache
    # gate: it writes memory.reclaim in the user's own cgroup slice, which the
    # kernel already permits. Tying its availability to clean_production hid
    # the row in every build that had not opened the page-cache gate.
    let built_in = 1
    let gate = 1
    # The helper slot stays for the cross-process path; this one is always ready.
    let helper = 1
    let no_target = if s.bal_action == 0: 1 else: 0
    mr_bal_bridge_entry(built_in, gate, helper, busy, no_target)

fn bal_plan_publish(s: &MainWindow) -> bool:
    let evidence = if s.bal_evidence != 0: 1 else: 0
    mr_bal_bridge_plan_set(s.bal_state, s.bal_action, s.bal_request_bytes, evidence) != 0

fn bal_plan_action_text(s: &MainWindow) -> string:
    let zh: i64 = if s.zh: 1 else: 0
    if not bal_plan_publish(s): return label(s.zh, "Balanced clean unavailable.", "均衡清理不可用。")
    mr_bal_bridge_plan_action(zh)

fn bal_plan_why_text(s: &MainWindow) -> string:
    let zh: i64 = if s.zh: 1 else: 0
    if not bal_plan_publish(s): return label(s.zh, "No plan was produced.", "未生成计划。")
    mr_bal_bridge_plan_why(zh)

fn bal_plan_budget_text(s: &MainWindow) -> string:
    let zh: i64 = if s.zh: 1 else: 0
    if not bal_plan_publish(s): return ""
    mr_bal_bridge_plan_budget(zh)

# Running the balanced clean. The scope is chosen by the user before this is
# called; nothing here enumerates and picks on the user's behalf.
fn bal_scope_label(index: i64) -> string:
    if index < 0: return ""
    mr_bal_bridge_scope_label(index)

fn bal_run_selected(s: &mut MainWindow) -> bool:
    if s.bal_scope_index < 0: return false
    if s.bal_action == 0 or s.bal_request_bytes <= 0: return false
    let started = mr_bal_bridge_run(s.bal_scope_index, s.bal_request_bytes, 0, 0, 400)
    if started == 0:
        s.status = label(s.zh, "Balanced clean could not start; the scope refused or changed.", "均衡清理无法开始；作用域拒绝或已变化。")
        return false
    s.bal_result_status = mr_bal_bridge_result_status_code()
    s.bal_result_stop = mr_bal_bridge_result_stop_code()
    s.bal_result_requested = mr_bal_bridge_result_requested_value()
    s.bal_result_accepted = mr_bal_bridge_result_accepted_value()
    s.status = mr_bal_bridge_result_headline(if s.zh: 1 else: 0)
    if s.test_mode:
        mr_runtime_emit(f"CI_BALANCED_RUN scope={bal_scope_label(s.bal_scope_index)} status={s.bal_result_status} stop={s.bal_result_stop} requested={s.bal_result_requested} accepted={s.bal_result_accepted}")
    return true

# Choose the scope with the largest reclaimable file-page share. Reads only.
fn pick_balanced_scope() -> i64:
    if mr_bal_bridge_scan_scopes() <= 0: return -1
    let mut best: i64 = -1
    let mut best_file: i64 = -1
    let count = mr_bal_bridge_scan_scopes()
    for i in 0..count:
        let f = mr_bal_bridge_scope_file_bytes(i)
        if f > best_file:
            best_file = f
            best = i
    if best_file <= 0: return -1
    best

fn bal_plan_skips_text(s: &MainWindow) -> string:
    let zh: i64 = if s.zh: 1 else: 0
    if not bal_plan_publish(s): return ""
    mr_bal_bridge_plan_skips(zh)

fn clean_operation_busy(state: i64) -> bool:
    state == 2 or state == 3 or state == 9 or state == 11

fn xproc_picker_busy(state: i64) -> bool:
    state == 2 or state == 3

fn xproc_operation_busy(s: &MainWindow) -> bool:
    xproc_picker_busy(s.xproc_state) and s.xproc_view == 3

fn xproc_available(s: &MainWindow) -> bool:
    s.xproc_simulation or (s.main_close_guard_ready and mr_xproc_enabled() != 0)

fn xproc_budget_limit(choice: i64) -> i64:
    if choice == 1: return 536870912
    if choice == 2: return 1073741824
    268435456

fn xproc_pageout_capacity(candidate_bytes: i64, rss_bytes: i64, private_resident_bytes: i64) -> i64:
    if candidate_bytes <= 0 or rss_bytes <= 0 or private_resident_bytes <= 0: return 0
    min(min(candidate_bytes, rss_bytes), private_resident_bytes)

fn xproc_budget(candidate_bytes: i64, rss_bytes: i64, private_resident_bytes: i64, scope_bytes: i64, choice: i64, mode: i64) -> i64:
    let capacity = if mode == 1: scope_bytes else: xproc_pageout_capacity(candidate_bytes, rss_bytes, private_resident_bytes)
    if capacity <= 0: return 0
    min(capacity, xproc_budget_limit(choice))

fn xproc_budget_limit_text(zh: bool, candidate_bytes: i64, rss_bytes: i64, private_resident_bytes: i64, scope_bytes: i64, choice: i64, mode: i64) -> string:
    let requested = xproc_budget_limit(choice)
    if mode == 1:
        if scope_bytes < requested: return label(zh, "cap: app-scope charge", "限幅：应用作用域计费")
        return label(zh, "cap: selected budget", "限幅：所选预算")
    if private_resident_bytes < requested and private_resident_bytes <= candidate_bytes and private_resident_bytes <= rss_bytes:
        return label(zh, "cap: private resident", "限幅：私有驻留估算")
    if rss_bytes < requested and rss_bytes <= candidate_bytes:
        return label(zh, "cap: RSS", "限幅：RSS")
    if candidate_bytes < requested:
        return label(zh, "cap: mapping length", "限幅：符合条件的映射长度")
    if private_resident_bytes < requested:
        return label(zh, "cap: private resident", "限幅：私有驻留估算")
    if rss_bytes < requested:
        return label(zh, "cap: RSS", "限幅：RSS")
    label(zh, "cap: selected budget", "限幅：所选预算")

fn xproc_selection_scope_text(zh: bool, mode: i64) -> string:
    if mode == 0:
        return label(zh, "PAGEOUT selects present, exclusive private pages only.", "PAGEOUT 只选择已驻留且独占映射的私有页。")
    label(zh, "memory.reclaim is bounded to this exact app scope.", "memory.reclaim 限定在此应用作用域内。")

fn xproc_budget_label(bytes: i64) -> string:
    if bytes >= 1073741824: return "1 GiB"
    if bytes >= 1048576:
        let tenths = bytes * 10 // 1048576
        return f"{tenths // 10} MiB"
    f"{bytes} bytes"

fn xproc_confirmation_start_time(zh: bool, start_time: i64) -> string:
    label(zh, f"Start time: {start_time}", f"启动时间：{start_time}")

fn xproc_result_state(poll: i64) -> i64:
    if poll == 0: return 10
    if poll == 1: return 11
    if poll == 2: return 12
    if poll == 3: return 13
    if poll == 4: return 14
    if poll == 5: return 15
    if poll == 6: return 16
    if poll == 7: return 17
    if poll == 8: return 18
    if poll == 9: return 19
    if poll == 10: return 20
    if poll == 11: return 24
    if poll == 12: return 25
    if poll == 13: return 27
    19

fn xproc_result_name(state: i64) -> string:
    if state == 10: return "accepted"
    if state == 11: return "partial"
    if state == 12: return "helper-refused"
    if state == 13: return "permission-denied"
    if state == 14: return "target-gone"
    if state == 15: return "unsupported"
    if state == 16: return "no-regions"
    if state == 17: return "authorization-unattributed"
    if state == 18: return "launch-failed"
    if state == 19: return "outcome-unknown"
    if state == 20: return "local-refusal"
    if state == 21: return "confirmation-cancelled"
    if state == 22: return "sample-unavailable"
    if state == 23: return "busy"
    if state == 24: return "authorization-cancelled"
    if state == 25: return "authorization-failed"
    if state == 26: return "target-identity-changed"
    if state == 27: return "cancelled-outcome-uncertain"
    "in-progress"

fn xproc_result_text(zh: bool, state: i64, simulated: bool, mode: i64) -> string:
    if state == 10:
        if simulated: return label(zh, "Simulation: helper accepted its selected request.", "模拟：helper 已接受实际选定的请求。")
        if mode == 1: return label(zh, "memory.reclaim request write completed.", "memory.reclaim 请求写入已完成。")
        return label(zh, "Kernel accepted the helper-selected request.", "内核已接受 helper 实际选定的请求。")
    if state == 11:
        if simulated: return label(zh, "Simulation: helper accepted only part of its request.", "模拟：helper 只接受了部分请求。")
        if mode == 1: return label(zh, "Kernel reported a scope reclaim shortfall.", "内核报告作用域回收未达请求量。")
        return label(zh, "Kernel accepted only part of the helper-selected request.", "内核只接受了 helper 实际选定请求的一部分。")
    if state == 12:
        if mode == 1: return label(zh, "The helper refused this app scope before writing.", "helper 在写入前拒绝了此应用作用域。")
        return label(zh, "The helper refused this target before advising it.", "helper 在发出回收建议前拒绝了此目标。")
    if state == 13:
        if simulated: return label(zh, "Simulation: the mock helper reported a permission denial.", "模拟：测试 helper 返回权限拒绝。")
        return label(zh, "The kernel denied permission for this target.", "内核拒绝了此目标的权限请求。")
    if state == 14: return label(zh, "The selected process exited before the request completed.", "所选进程在请求完成前已退出。")
    if state == 15:
        if simulated: return label(zh, "Simulation: the mock backend reports this operation unsupported.", "模拟：测试后端报告此操作不受支持。")
        return label(zh, "This kernel does not support the requested operation.", "当前内核不支持该操作。")
    if state == 16: return label(zh, "The helper found no eligible memory regions.", "helper 未找到符合条件的内存区域。")
    if state == 17: return label(zh, "Authorization was dismissed or could not be attributed; no retry was made.", "授权被取消或无法确认原因；未重试。")
    if state == 18: return label(zh, "Could not start the fixed authorization helper.", "无法启动固定授权 helper。")
    if state == 19: return label(zh, "The result is uncertain; do not repeat automatically.", "结果不确定；不会自动重试。")
    if state == 20: return label(zh, "The request was refused locally; no authorization was started.", "本地安全检查拒绝了请求；未启动授权。")
    if state == 21: return label(zh, "Confirmation cancelled; no request was started.", "已取消确认；未启动请求。")
    if state == 22: return label(zh, "Memory sampling failed; no request was started.", "内存采样失败；未启动请求。")
    if state == 23: return label(zh, "Another memory operation is already running.", "已有其他内存操作正在运行。")
    if state == 24: return label(zh, "Authorization was cancelled; no helper result was received and no retry was made.", "已取消授权；未收到 helper 结果，也不会自动重试。")
    if state == 25: return label(zh, "Polkit could not authorize or start the fixed helper; no retry was made.", "Polkit 未能授权或启动固定 helper；不会自动重试。")
    if state == 26: return label(zh, "The selected process changed or disappeared; no request was started.", "所选进程身份已变化或退出；未启动请求。")
    if state == 27:
        if simulated: return label(zh, "Simulation: the mock request was cancelled; no helper or kernel action ran.", "模拟：测试请求已取消；未运行 helper 或内核操作。")
        return label(zh, "The request was stopped, but authorization may already have started the helper; the result is unknown. Do not retry automatically.", "已请求停止，但授权可能已启动 helper；结果不确定，不会自动重试。")
    label(zh, "Cross-process reclaim is in progress.", "跨进程回收正在进行。")

fn xproc_exit_detail(zh: bool, exit_code: i64, signal: i64) -> string:
    if signal > 0:
        return label(zh, f"pkexec child ended by signal {signal}; result is unknown.", f"pkexec 子进程被信号 {signal} 终止；结果不确定。")
    if exit_code == 126: return label(zh, "pkexec exit 126: authorization was dismissed.", "pkexec 退出码 126：授权对话已取消。")
    if exit_code == 127: return label(zh, "pkexec exit 127: authorization or launch failed.", "pkexec 退出码 127：授权或启动失败。")
    if exit_code >= 0: return f"pkexec exit code {exit_code}"
    ""

fn xproc_advised_bytes_label(zh: bool, simulated: bool) -> string:
    if simulated: return label(zh, "Mock bytes advised:", "模拟建议字节：")
    label(zh, "Bytes advised:", "建议字节：")

fn xproc_kib(value: i64) -> string:
    if value < 0: return "unavailable"
    f"{value} KiB"

fn xproc_kib_text(zh: bool, value: i64) -> string:
    if value < 0: return label(zh, "unavailable", "不可用")
    f"{value} KiB"

fn xproc_mib_bytes(value: i64) -> string:
    if value < 0: return "unavailable"
    let tenths = value * 10 // 1048576
    f"{tenths // 10}.{tenths % 10} MiB"

fn xproc_mib_bytes_text(zh: bool, value: i64) -> string:
    if value < 0: return label(zh, "unavailable", "不可用")
    let tenths = value * 10 // 1048576
    f"{tenths // 10}.{tenths % 10} MiB"

fn xproc_mib_compact(value: i64) -> string:
    if value < 0: return "—"
    let whole = value // 1048576
    let tenths = (value % 1048576) * 10 // 1048576
    f"{whole}.{tenths}"

fn xproc_helper_calls_label(zh: bool, simulated: bool) -> string:
    if simulated: return label(zh, "Mock helper calls:", "模拟 helper 调用：")
    label(zh, "Helper calls:", "helper 调用：")

fn xproc_waiting_text(zh: bool, state: i64, simulation: bool) -> string:
    if simulation:
        if state == 2: return label(zh, "Waiting for simulated authorization…", "正在等待模拟授权……")
        if state == 3: return label(zh, "Mock helper is running…", "模拟 helper 正在运行……")
    if state == 2: return label(zh, "Waiting for Polkit authorization…", "正在等待 Polkit 授权……")
    label(zh, "The cross-process helper is running…", "跨进程 helper 正在运行……")

fn xproc_preflight_text(zh: bool, enabled: i64, preflight: i64, scan_status: i64) -> string:
    if enabled == 0: return label(zh, "This build has cross-process reclaim disabled.", "此构建未启用跨进程回收。")
    if preflight == 1: return label(zh, "The fixed cross-process helper is not installed.", "固定的跨进程 helper 未安装。")
    if preflight == 2: return label(zh, "The dedicated Polkit action is not installed.", "专用 Polkit action 未安装。")
    if preflight == 3: return label(zh, "pkexec is not available.", "pkexec 不可用。")
    if preflight == 4: return label(zh, "This kernel lacks pidfd/process_madvise support.", "当前内核缺少 pidfd/process_madvise 支持。")
    if preflight == 5: return label(zh, "The installed cross-process helper has an incompatible protocol; reinstall the matching package.", "已安装的跨进程 helper 协议不兼容，请重新安装匹配版本。")
    if scan_status != 0: return label(zh, "The process list could not be read safely.", "无法安全读取进程列表。")
    ""

fn xproc_panel(s: &MainWindow) -> ui.Rect:
    ui.rect((s.width - 304.0) / 2.0, (s.height - 256.0) / 2.0, 304.0, 256.0)

fn xproc_row_rect(slot: i64, panel: &ui.Rect) -> ui.Rect:
    ui.rect(panel.x + 8.0, panel.y + 53.0 + f64(slot) * 35.0, panel.w - 16.0, 33.0)

fn xproc_picker_refresh_rect(panel: &ui.Rect) -> ui.Rect:
    ui.rect(panel.x + 10.0, panel.bottom() - 30.0, 68.0, 22.0)

fn xproc_picker_continue_rect(panel: &ui.Rect) -> ui.Rect:
    ui.rect(panel.x + 86.0, panel.bottom() - 30.0, 124.0, 22.0)

fn xproc_picker_cancel_rect(panel: &ui.Rect) -> ui.Rect:
    ui.rect(panel.x + 216.0, panel.bottom() - 30.0, 78.0, 22.0)

fn xproc_confirm_accept_rect(panel: &ui.Rect) -> ui.Rect:
    ui.rect(panel.x + 82.0, panel.bottom() - 30.0, 126.0, 22.0)

fn xproc_budget_rect(choice: i64, panel: &ui.Rect) -> ui.Rect:
    ui.rect(panel.x + 10.0 + f64(choice) * 97.0, panel.y + 114.0, 90.0, 20.0)

fn xproc_mode_rect(choice: i64, panel: &ui.Rect) -> ui.Rect:
    ui.rect(panel.x + 10.0 + f64(choice) * 142.0, panel.y + 140.0, 132.0, 20.0)

fn xproc_confirm_cancel_rect(panel: &ui.Rect) -> ui.Rect:
    ui.rect(panel.x + 216.0, panel.bottom() - 30.0, 78.0, 22.0)

fn xproc_result_close_rect(panel: &ui.Rect) -> ui.Rect:
    ui.rect(panel.x + 216.0, panel.bottom() - 30.0, 78.0, 22.0)

fn xproc_running_cancel_rect(panel: &ui.Rect) -> ui.Rect:
    xproc_result_close_rect(panel)

