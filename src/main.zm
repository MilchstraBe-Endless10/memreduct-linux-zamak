extern fn mr_bal_bridge_result_headline(zh: i64) -> string
extern fn mr_bal_bridge_result_counters(zh: i64) -> string
extern fn mr_bal_bridge_result_stop(zh: i64) -> string
extern fn mr_bal_bridge_result_observed(zh: i64) -> string
