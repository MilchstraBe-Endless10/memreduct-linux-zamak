        return mr_runtime_xproc_audit_confirmation(
            s.xproc_request_id, s.xproc_target_pid, s.xproc_target_start_time,
            s.xproc_target_uid, s.xproc_target_scope_hash,
            s.xproc_target_identity_token, s.xproc_target_region_digest)
    mr_xproc_audit_confirmation(
        s.xproc_request_id, s.xproc_target_pid, s.xproc_target_start_time,
        s.xproc_target_uid, s.xproc_target_scope_hash,
        s.xproc_target_identity_token, s.xproc_target_region_digest)

fn xproc_candidate_state_text(zh: bool, state: i64) -> string:
    if state == 82: return label(zh, "running", "运行中")
    if state == 83: return label(zh, "sleeping", "休眠中")
    if state == 68: return label(zh, "disk sleep", "不可中断睡眠")
    if state == 84: return label(zh, "stopped", "已停止")
    if state == 116: return label(zh, "tracing stop", "跟踪暂停")
    if state == 73: return label(zh, "idle", "空闲")
    if state == 87: return label(zh, "waking", "唤醒中")
    if state == 75: return label(zh, "wake-kill", "唤醒终止")
    if state == 80: return label(zh, "parked", "已挂起")
    label(zh, "unknown", "未知")

fn xproc_scan(s: &mut MainWindow):
    mr_cand_snapshot_clear()
    s.xproc_selected = -1
    s.xproc_scroll = 0
    s.xproc_target_pid = -1
    s.xproc_target_start_time = -1
    s.xproc_target_uid = -1
    s.xproc_target_identity_token = -1
    s.xproc_request_id = -1
    s.xproc_target_scope_hash = -1
    s.xproc_target_region_digest = -1
    s.xproc_target_bytes = -1
    s.xproc_target_scope_bytes = -1
    s.xproc_target_rss_bytes = -1
    s.xproc_target_private_resident_bytes = -1
    s.xproc_target_regions = -1
    s.xproc_target_name = ""
    s.xproc_target_app_name = ""
    s.xproc_preflight = -1
    s.xproc_scan_status = -1
    s.xproc_state = 0
    s.status = ""
    if s.xproc_simulation:
        s.xproc_preflight = 0
        s.xproc_scan_status = 0
    elif mr_xproc_enabled() != 0:
        s.xproc_preflight = mr_xproc_preflight()
        if s.xproc_preflight == 0:
            s.xproc_scan_status = mr_cand_scan_run()
    s.xproc_view = 1
    s.xproc_focus = 0
    if s.test_mode: mr_runtime_emit(f"CI_XPROC_PICKER open=true candidates={xproc_count(s)} selected={s.xproc_selected} preflight={s.xproc_preflight} scan={s.xproc_scan_status} mock={s.xproc_simulation} no_privilege_request=true")
    if s.test_mode:
        let panel = xproc_panel(s)
        let row = xproc_row_rect(0, &panel)
        mr_runtime_emit(f"CI_XPROC_PANEL x={panel.x} y={panel.y} w={panel.w} h={panel.h} row0_x={row.x} row0_y={row.y} canvas={s.width}x{s.height}")
    s.canvas.redraw()

fn xproc_set_selected(s: &mut MainWindow, index: i64):
    let count = xproc_count(s)
    if index < 0 or index >= count: return
    let pid = xproc_pid(s, index)
    let start_time = xproc_start_time(s, index)
    let uid = xproc_uid(s, index)
    let identity_token = xproc_candidate_identity_token(s, index)
    let scope_hash = xproc_candidate_scope_hash(s, index)
    let region_digest = xproc_candidate_region_digest(s, index)
    let candidate_bytes = xproc_candidate_bytes(s, index)
    let candidate_scope_bytes = xproc_candidate_scope_bytes(s, index)
    let candidate_rss_bytes = xproc_candidate_rss_bytes(s, index)
    let private_resident_bytes = xproc_candidate_private_resident_bytes(s, index)
    let regions = xproc_candidate_regions(s, index)
    let name = xproc_candidate_name(s, index)
    let app_name = xproc_candidate_app_name(s, index)
    if pid < 2 or start_time <= 0 or uid <= 0 or identity_token <= 0 or scope_hash <= 0 or region_digest <= 0 or candidate_bytes <= 0 or private_resident_bytes < 0 or regions <= 0:
        s.xproc_selected = -1
        s.status = label(s.zh, "This process snapshot is incomplete; refresh the list.", "进程快照不完整；请刷新列表。")
        if s.test_mode: mr_runtime_emit(f"CI_XPROC_SELECT rejected=true index={index} reason=incomplete-snapshot helper_calls=0")
        s.canvas.redraw()
        return
    if not s.xproc_simulation and mr_cand_snapshot_select(index) != 0:
        s.xproc_selected = -1
        s.xproc_target_pid = -1
        s.xproc_target_start_time = -1
        s.xproc_target_uid = -1
        s.xproc_target_identity_token = -1
        s.xproc_request_id = -1
        s.xproc_target_scope_hash = -1
        s.xproc_target_region_digest = -1
        s.xproc_target_bytes = -1
        s.xproc_target_scope_bytes = -1
        s.xproc_target_rss_bytes = -1
        s.xproc_target_private_resident_bytes = -1
        s.xproc_target_regions = -1
        s.xproc_target_name = ""
        s.xproc_target_app_name = ""
        s.status = label(s.zh, "This process changed; refresh the list and select it again.", "进程状态已变化；请刷新列表后重新选择。")
        if s.test_mode: mr_runtime_emit(f"CI_XPROC_SELECT rejected=true index={index} reason=stale-at-selection pid={pid} helper_calls=0")
        s.canvas.redraw()
        return
    let request_id = if s.xproc_simulation: mr_runtime_xproc_request_id_new() else: mr_xproc_request_id_new()
    if request_id <= 0 or (not s.xproc_simulation and mr_cand_snapshot_bind_request(request_id) != 0):
        mr_cand_snapshot_clear()
        s.xproc_selected = -1
        s.xproc_request_id = -1
        s.status = label(s.zh, "A request ID could not be created; select the process again.", "无法创建请求编号；请重新选择进程。")
        if s.test_mode: mr_runtime_emit(f"CI_XPROC_SELECT rejected=true index={index} reason=request-id-unavailable helper_calls=0")
        s.canvas.redraw()
        return
    s.xproc_selected = index
    s.xproc_budget_choice = 0
    s.xproc_mode_choice = 0
    s.xproc_target_pid = pid
    s.xproc_target_start_time = start_time
    s.xproc_target_uid = uid
    s.xproc_target_identity_token = identity_token
    s.xproc_request_id = request_id
    s.xproc_target_scope_hash = scope_hash
    s.xproc_target_region_digest = region_digest
    s.xproc_target_bytes = candidate_bytes
    s.xproc_target_scope_bytes = candidate_scope_bytes
    s.xproc_target_rss_bytes = candidate_rss_bytes
    s.xproc_target_private_resident_bytes = private_resident_bytes
    s.xproc_target_regions = regions
    s.xproc_target_name = name
    s.xproc_target_app_name = app_name
    if index < s.xproc_scroll: s.xproc_scroll = index
    if index >= s.xproc_scroll + 4: s.xproc_scroll = index - 3
    if s.test_mode: mr_runtime_emit(f"CI_XPROC_AUDIT phase=selection request_id={request_id} pid={pid} uid={uid} start_time={start_time} scope_hash={scope_hash} identity_hash={identity_token} region_digest={region_digest}")
    if s.test_mode: mr_runtime_emit(f"CI_XPROC_SELECT index={index} pid={pid} uid={uid} start_time={start_time} request_id={request_id} scope_hash={scope_hash} identity_hash={identity_token} region_digest={region_digest} process={s.xproc_target_name} app={s.xproc_target_app_name} process_state={xproc_candidate_state_text(false, xproc_candidate_state(s, index))} regions={regions} candidate_bytes={candidate_bytes} private_resident_bytes={private_resident_bytes} rss_bytes={candidate_rss_bytes} scope_anon_file_bytes={candidate_scope_bytes} selected=true snapshot=pinned")

fn xproc_local_failure(s: &mut MainWindow, state: i64):
    s.xproc_state = state
    s.xproc_view = 4
    s.xproc_after_available = -1
    s.xproc_advised_bytes = 0
    s.xproc_requested_bytes = 0
    s.xproc_regions = 0
    s.xproc_error_code = 0
    s.xproc_call_count = 0
    s.status = xproc_result_text(s.zh, state, s.xproc_simulation, s.xproc_mode_choice)
    if s.test_mode: mr_runtime_emit(f"CI_XPROC_RESULT state={xproc_result_name(state)} authorization_started=false call_count=0 no_system_write={s.xproc_simulation}")
    s.canvas.redraw()

fn xproc_finish(s: &mut MainWindow, result: i64):
    s.xproc_state = xproc_result_state(result)
    s.xproc_cancel_status = 0
    s.xproc_advised_bytes = if s.xproc_simulation: mr_runtime_xproc_result_advised_bytes() else: mr_xproc_result_advised_bytes()
    s.xproc_requested_bytes = if s.xproc_simulation: mr_runtime_xproc_result_requested_bytes() else: mr_xproc_result_requested_bytes()
    s.xproc_regions = if s.xproc_simulation: mr_runtime_xproc_result_regions() else: mr_xproc_result_regions()
    s.xproc_error_code = if s.xproc_simulation: 0 else: mr_xproc_result_error_code()
    s.xproc_call_count = if s.xproc_simulation: mr_runtime_xproc_result_call_count() else: mr_xproc_result_call_count()
    s.xproc_mode_choice = if s.xproc_simulation: mr_runtime_xproc_result_mode() else: mr_xproc_result_mode()
    s.xproc_target_rss_before_kib = if s.xproc_simulation: -1 else: mr_xproc_result_target_rss_before_kib()
    s.xproc_target_rss_after_kib = if s.xproc_simulation: -1 else: mr_xproc_result_target_rss_after_kib()
    s.xproc_target_swap_before_kib = if s.xproc_simulation: -1 else: mr_xproc_result_target_swap_before_kib()
    s.xproc_target_swap_after_kib = if s.xproc_simulation: -1 else: mr_xproc_result_target_swap_after_kib()
    s.xproc_scope_current_before_bytes = if s.xproc_simulation: -1 else: mr_xproc_result_scope_current_before_bytes()
    s.xproc_scope_current_after_bytes = if s.xproc_simulation: -1 else: mr_xproc_result_scope_current_after_bytes()
    s.xproc_scope_anon_before_bytes = if s.xproc_simulation: -1 else: mr_xproc_result_scope_anon_before_bytes()
    s.xproc_scope_anon_after_bytes = if s.xproc_simulation: -1 else: mr_xproc_result_scope_anon_after_bytes()
    s.xproc_scope_file_before_bytes = if s.xproc_simulation: -1 else: mr_xproc_result_scope_file_before_bytes()
    s.xproc_scope_file_after_bytes = if s.xproc_simulation: -1 else: mr_xproc_result_scope_file_after_bytes()
    s.xproc_scope_swap_before_bytes = if s.xproc_simulation: -1 else: mr_xproc_result_scope_swap_before_bytes()
    s.xproc_scope_swap_after_bytes = if s.xproc_simulation: -1 else: mr_xproc_result_scope_swap_after_bytes()
    let child_exit = if s.xproc_simulation: -1 else: mr_xproc_result_exit_code()
    let child_signal = if s.xproc_simulation: 0 else: mr_xproc_result_signal()
    s.xproc_after_available = -1
    s.xproc_view = 4
    let after = memory.sample() catch e:
        let reason = if s.xproc_simulation: "simulated-partial" else: mr_xproc_result_reason()
        if s.test_mode: mr_runtime_emit(f"CI_XPROC_RESULT state={xproc_result_name(s.xproc_state)} mode={s.xproc_mode_choice} poll={result} advised_bytes={s.xproc_advised_bytes} requested_bytes={s.xproc_requested_bytes} regions={s.xproc_regions} error_code={s.xproc_error_code} call_count={s.xproc_call_count} pkexec_exit_code={child_exit} child_signal={child_signal} reason={reason} memavailable_before_kib={s.xproc_before_available} memavailable_after_kib=unavailable causal_attribution=none no_retry=true mock={s.xproc_simulation} no_system_write={s.xproc_simulation}")
        if s.test_mode: mr_runtime_emit(f"CI_XPROC_AFTER_SAMPLE available=false error={e}")
        s.status = label(s.zh, "Result recorded; after-sample unavailable", "结果已记录；无法取得操作后采样")
        s.canvas.redraw()
        return
    s.mem_total = after.total
    s.mem_available = after.available
    s.swap_total = after.swap_total
    s.swap_free = after.swap_free
    s.page_cache_estimate = after.page_cache
    s.sample_ok = true
    s.xproc_after_available = after.available
    s.status = xproc_result_text(s.zh, s.xproc_state, s.xproc_simulation, s.xproc_mode_choice)
    if s.test_mode: mr_runtime_emit(f"CI_XPROC_RESULT state={xproc_result_name(s.xproc_state)} mode={s.xproc_mode_choice} poll={result} advised_bytes={s.xproc_advised_bytes} requested_bytes={s.xproc_requested_bytes} regions={s.xproc_regions} error_code={s.xproc_error_code} call_count={s.xproc_call_count} pkexec_exit_code={child_exit} child_signal={child_signal} memavailable_before_kib={s.xproc_before_available} memavailable_after_kib={s.xproc_after_available} causal_attribution=none no_retry=true mock={s.xproc_simulation} no_system_write={s.xproc_simulation}")
    s.canvas.redraw()

fn xproc_start_selected(s: &mut MainWindow):
    if xproc_operation_busy(s) or clean_operation_busy(s.clean_state):
        xproc_local_failure(s, 23)
        return
    if s.xproc_selected < 0 or s.xproc_request_id <= 0 or s.xproc_target_pid <= 0 or s.xproc_target_start_time <= 0 or s.xproc_target_uid <= 0 or s.xproc_target_identity_token <= 0 or s.xproc_target_scope_hash <= 0 or s.xproc_target_region_digest <= 0 or s.xproc_target_bytes <= 0 or s.xproc_target_regions <= 0:
        xproc_local_failure(s, 20)
        return
    let budget = xproc_budget(s.xproc_target_bytes, s.xproc_target_rss_bytes, s.xproc_target_private_resident_bytes, s.xproc_target_scope_bytes, s.xproc_budget_choice, s.xproc_mode_choice)
    if budget <= 0:
        xproc_local_failure(s, 20)
        return
    let before = memory.sample() catch e:
        if s.test_mode: mr_runtime_emit(f"CI_XPROC_START blocked=sample-unavailable error={e} authorization_started=false call_count=0")
        s.xproc_state = 22
        s.xproc_view = 4
        s.xproc_before_available = -1
        s.xproc_after_available = -1
        s.status = xproc_result_text(s.zh, 22, s.xproc_simulation, s.xproc_mode_choice)
        s.canvas.redraw()
        return
    s.xproc_before_available = before.available
    let snapshot_status = xproc_snapshot_verify(s)
    if snapshot_status != 0:
        xproc_local_failure(s, 26)
        if s.test_mode: mr_runtime_emit(f"CI_XPROC_START blocked=target-snapshot-changed request_id={s.xproc_request_id} status={snapshot_status} selected_pid={s.xproc_target_pid} selected_start_time={s.xproc_target_start_time} selected_uid={s.xproc_target_uid} scope_hash={s.xproc_target_scope_hash} identity_hash={s.xproc_target_identity_token} region_digest={s.xproc_target_region_digest} helper_calls=0 authorization_started=false")
        return
    let start_result = if s.xproc_simulation:
        mr_runtime_xproc_start(s.xproc_request_id, s.xproc_mode_choice, s.xproc_target_pid, s.xproc_target_start_time, s.xproc_target_uid, s.xproc_target_identity_token, s.xproc_target_scope_hash, s.xproc_target_region_digest, s.xproc_target_bytes, s.xproc_target_regions, budget)
    else:
        mr_xproc_start(s.xproc_request_id, s.xproc_mode_choice, s.xproc_target_pid, s.xproc_target_start_time, s.xproc_target_uid, s.xproc_target_identity_token, s.xproc_target_scope_hash, s.xproc_target_region_digest, s.xproc_target_bytes, s.xproc_target_regions, budget)
    if start_result != 0:
        let mut state = 20
        if start_result == 1: state = 23
        elif start_result == 3: state = 18
        xproc_local_failure(s, state)
        if s.test_mode: mr_runtime_emit(f"CI_XPROC_START started=false start_state={start_result} authorization_started=false call_count=0 mock={s.xproc_simulation}")
        return
    s.xproc_state = 2
    s.xproc_view = 3
    s.xproc_focus = 1
    s.xproc_cancel_status = 0
    s.status = xproc_waiting_text(s.zh, s.xproc_state, s.xproc_simulation)
    if s.test_mode:
        let backend = if s.xproc_simulation: "mock" else: "pkexec"
        mr_runtime_emit(f"CI_XPROC_AUDIT phase=bridge_argv request_id={s.xproc_request_id} pid={s.xproc_target_pid} uid={s.xproc_target_uid} start_time={s.xproc_target_start_time} scope_hash={s.xproc_target_scope_hash} identity_hash={s.xproc_target_identity_token} region_digest={s.xproc_target_region_digest}")
        mr_runtime_emit(f"CI_XPROC_START started=true backend={backend} mode={s.xproc_mode_choice} request_id={s.xproc_request_id} pid={s.xproc_target_pid} uid={s.xproc_target_uid} start_time={s.xproc_target_start_time} identity_hash={s.xproc_target_identity_token} scope_hash={s.xproc_target_scope_hash} region_digest={s.xproc_target_region_digest} max_bytes={budget} reviewed_candidate_bytes={s.xproc_target_bytes} reviewed_regions={s.xproc_target_regions} observed_memavailable_before_kib={s.xproc_before_available} authorization_each_run=true automatic_retry=false")
    s.canvas.redraw()

fn choose_xproc_budget(s: &mut MainWindow, choice: i64):
    if choice < 0 or choice > 2: return
    s.xproc_budget_choice = choice
    if s.test_mode: mr_runtime_emit(f"CI_XPROC_BUDGET choice={choice} limit_bytes={xproc_budget_limit(choice)} effective_bytes={xproc_budget(s.xproc_target_bytes, s.xproc_target_rss_bytes, s.xproc_target_private_resident_bytes, s.xproc_target_scope_bytes, choice, s.xproc_mode_choice)}")

fn choose_xproc_mode(s: &mut MainWindow, mode: i64):
    if mode < 0 or mode > 1: return
    if mode == 1 and s.xproc_target_scope_bytes <= 0: return
    s.xproc_mode_choice = mode
    if s.test_mode:
        let action = if mode == 0: "process-pageout" else: "app-scope-memory-reclaim"
        mr_runtime_emit(f"CI_XPROC_MODE choice={mode} action={action} target_pid={s.xproc_target_pid}")

fn xproc_confirm_cancel(s: &mut MainWindow):
    s.xproc_state = 21
    s.xproc_view = 4
    s.status = xproc_result_text(s.zh, 21, s.xproc_simulation, s.xproc_mode_choice)
    if s.test_mode: mr_runtime_emit(f"CI_XPROC_RESULT state=confirmation-cancelled authorization_started=false call_count=0 mock={s.xproc_simulation}")
    s.canvas.redraw()

fn xproc_request_cancel(s: &mut MainWindow):
    if not xproc_operation_busy(s): return
    let result = if s.xproc_simulation: mr_runtime_xproc_cancel() else: mr_xproc_cancel()
    if result == 0:
        s.xproc_cancel_status = 1
        s.status = label(s.zh, "Cancellation requested; waiting for the request to stop.", "已请求取消；正在等待请求停止。")
    else:
        s.xproc_cancel_status = 2
        s.status = label(s.zh, "Could not signal the authorization process; the request is still active.", "无法向授权进程发送停止信号；请求仍在运行。")
    if s.test_mode: mr_runtime_emit(f"CI_XPROC_CANCEL requested=true signal_sent={result == 0} helper_may_have_started=true")
    s.canvas.redraw()

fn clean_progress_status(simulation: bool, zh: bool, state: i64) -> string:
    if simulation:
        if state == 2: return label(zh, "Waiting for simulated authorization", "正在等待模拟授权")
        if state == 3: return label(zh, "Mock authorization accepted", "模拟授权已接受")
        return label(zh, "Mock helper running", "模拟 helper 正在运行")
    if state == 2: return label(zh, "Waiting for authorization", "正在等待授权")
    if state == 3: return label(zh, "Authorization accepted; helper running", "授权已接受；helper 正在运行")
    label(zh, "Reclaim helper running", "回收 helper 正在运行")

fn clean_result_status_for(simulation: bool, zh: bool, state: i64) -> string:
    if state == 4 and not simulation:
        return label(zh, "Kernel accepted the page cache reclaim request", "内核已接受页缓存回收请求")
    clean_result_status(zh, state)

fn clean_result_state(result: i64) -> i64:
    if result == 0: return 4
    if result == 1: return 6
    if result == 2: return 7
    if result == 3 or result == 4: return 8
    if result == 5 or result == 6 or result == 7: return 10
    if result < 0: return 10
    7

fn clean_start_failure_state(result: i64) -> i64:
    if result == 1: return 11
    7

# Names the component the privileged chain is missing. Issue #13 M0 requires
# this to be visible in the window, not only in CI markers.
fn clean_preflight_status(zh: bool, preflight: i64) -> string:
    if preflight == 1: return label(zh, "Component not installed: the reclaim helper (/usr/libexec/memreduct-zamak-helper)", "组件未安装：回收 helper（/usr/libexec/memreduct-zamak-helper）")
    if preflight == 2: return label(zh, "Component not installed: the Polkit action for this program", "组件未安装：本程序的 Polkit 授权策略")
    if preflight == 3: return label(zh, "Component not installed: pkexec", "组件未安装：pkexec")
    return clean_result_status(zh, 10)

fn clean_result_status(zh: bool, state: i64) -> string:
    if state == 4: return label(zh, "Simulation complete; no system changes", "模拟完成；未更改系统")
    if state == 5: return label(zh, "Confirmation cancelled", "已取消确认")
    if state == 6: return label(zh, "Authorization or execution not confirmed", "授权或执行结果未确认")
    if state == 7: return label(zh, "Authorization or helper launch failed", "授权失败或 helper 无法启动")
    if state == 8: return label(zh, "The helper reported failure", "helper 执行失败")
    if state == 10: return label(zh, "Result is uncertain; do not retry automatically", "结果不确定；不会自动重试")
    if state == 11: return label(zh, "Another operation is already running", "已有操作正在运行")
    if state == 12: return label(zh, "Memory sample unavailable; simulation was not started", "内存采样不可用；未启动模拟")
    label(zh, "Operation is in progress", "操作正在进行")

# ADR-0006 action 2 result states. Kept separate from the page-cache states
# because the two actions have different costs and different guarantees.
fn clean_self_status_name(state: i64) -> string:
    if state == 20: return "self-trimmed"
    if state == 21: return "unsupported"
    if state == 22: return "failed"
    "not-started"

fn clean_self_status_text(zh: bool, state: i64) -> string:
    if state == 20: return label(zh, "This app's own memory was paged out", "已释放本程序自身内存")
    if state == 21: return label(zh, "This kernel cannot page out memory", "当前内核不支持释放内存")
    if state == 22: return label(zh, "This app's memory could not be paged out", "无法释放本程序内存")
    label(zh, "Trimming this app's memory...", "正在释放本程序内存……")

fn clean_self_state_for(result: i64) -> i64:
    if result == 0: return 20
    if result == 1: return 21
    22

fn clean_result_name(state: i64) -> string:
    if state == 4: return "accepted"
    if state == 5: return "confirmation-cancelled"
    if state == 6: return "authorization-unconfirmed"
    if state == 7: return "authorization-failed"
    if state == 8: return "execution-failed"
    if state == 10: return "uncertain"
    if state == 11: return "already-running"
    if state == 12: return "not-started-sample-unavailable"
    "in-progress"

# ADR-0006 action 2, self mode: page out this process's own memory. It needs no
# privilege, cannot reach another process, and is therefore always available.
fn clean_self_can_start(state: i64) -> bool:
    state != 1 and not clean_operation_busy(state)

# Runs ADR-0006 action 2 in self mode. No helper, no authorization, no other
# process: mr_self_reclaim only ever targets this process. The byte count is the
# length the kernel accepted, not a measurement, so it is reported as such.
fn run_self_reclaim(s: &mut MainWindow):
    let result = mr_self_reclaim()
    let state = clean_self_state_for(result)
    s.clean_state = state
    # The self trim never touches another process, so it is also the natural
    # moment to run the read-only cross-process planner (ADR-0007): same
    # unprivileged context, no advice issued, output purely observational. The
    # status line reports what a FUTURE gated advise would have considered,
    # which is the review-required visibility the cross-process work must show
    # before any writable path is ever enabled.
    let plan_status = mr_crossproc_plan_status()
    let preview = label(s.zh, " cross-process preview: ", " 跨进程预览：")
    # 0 OK and 5 NO_CANDIDATES are both completed scans -- 5 is the honest
    # answer when every process belongs to another user. 3 stops at a budget
    # but the plan is still usable. Only a genuinely failed scan (procfs
    # unreadable, reentrant call, bad argument) shows "unavailable".
    if plan_status == 0 or plan_status == 5 or plan_status == 3:
        let bytes = mr_crossproc_plan_bytes()
        let mb = bytes / 1048576
        let targets = mr_crossproc_plan_targets()
        let regions = mr_crossproc_plan_regions()
        let detail_en = f"{targets} processes / {regions} regions / ~{mb} MiB candidate (read-only)"
        let detail_zh = f"{targets} 进程 / {regions} 区域 / 约 {mb} MiB 候选（只读）"
        let body = label(s.zh, detail_en, detail_zh)
        s.status = clean_self_status_text(s.zh, state) + preview + body
    else:
        # The scan itself failed; say so instead of showing a stale count.
        let body = label(s.zh, "scan unavailable", "扫描不可用")
        s.status = clean_self_status_text(s.zh, state) + preview + body
    if s.test_mode:
        mr_runtime_emit(f"CI_CLEAN_SELF result={clean_self_status_name(state)} result_state={state} status={result} accepted_bytes={mr_self_reclaim_bytes()} failed_batches={mr_self_reclaim_failed_batches()} error={mr_self_reclaim_error()} target=self only other_processes=false no_privilege=true")
        mr_runtime_emit(f"CI_CROSSPROC_PREVIEW status={plan_status} targets={mr_crossproc_plan_targets()} regions={mr_crossproc_plan_regions()} bytes={mr_crossproc_plan_bytes()} error={mr_crossproc_plan_error()} skipped_shared={mr_crossproc_plan_skipped(7)} skipped_writable={mr_crossproc_plan_skipped(8)} readonly=true no_advice_issued=true")
    # Issue #12 M1.1: enumerate the user's own processes so the surface can name
    # a target instead of showing a count. Still strictly read-only: no pidfd, no
    # advice, no signal. Reported separately from the planner above because the
    # two use different selection policies and must not be conflated.
    let mut scan_ok = true
    if not s.xproc_simulation: scan_ok = mr_cand_scan_run() == 0
    let cands = if s.xproc_simulation: 0 else: mr_cand_count()
    let xproc_built = if s.xproc_simulation or not s.main_close_guard_ready: 0 else: mr_xproc_enabled()
    let xproc_ready = if s.xproc_simulation: 0 else: mr_xproc_preflight()
    if s.test_mode:
        # One row per candidate (bounded to 8) plus a summary. The row carries
        # the start_time the helper will verify, so a reviewer can see that the
        # GUI is passing an identity, not just a number.
        let scan_source = if s.xproc_simulation: "fixed-fixture-only" else: "procfs-read-only"
        let scanned = if s.xproc_simulation: 0 else: mr_cand_scanned()
        let skipped_other_uid = if s.xproc_simulation: 0 else: mr_cand_skipped(4)
        let skipped_protected = if s.xproc_simulation: 0 else: mr_cand_skipped(6)
        let skipped_no_regions = if s.xproc_simulation: 0 else: mr_cand_skipped(8)
        mr_runtime_emit(f"CI_CROSSPROC_CANDIDATES scan_ok={scan_ok} count={cands} scanned={scanned} skipped_other_uid={skipped_other_uid} skipped_protected={skipped_protected} skipped_no_regions={skipped_no_regions} built={xproc_built} preflight={xproc_ready} source={scan_source} readonly=true no_advice_issued=true")
        let mut row = 0
        while row < cands and row < 8:
            mr_runtime_emit(f"CI_CROSSPROC_CANDIDATE row={row} pid={mr_cand_pid(row)} start_time={mr_cand_start_time(row)} regions={mr_cand_regions(row)} bytes={mr_cand_reclaimable_bytes(row)}")
            row = row + 1
    s.canvas.redraw()

fn clean_simulation_can_start(state: i64) -> bool:
    state != 1 and not clean_operation_busy(state)

fn log_popup(s: &MainWindow, kind: string, r: &ui.Rect):
    if not s.test_mode: return
    let fits = r.x >= 2.0 and r.y >= 2.0 and r.right() <= s.width - 2.0 and r.bottom() <= s.height - 2.0
    let locale = label(s.zh, "en", "zh-CN")
    mr_runtime_emit(f"CI_POPUP kind={kind} menu={s.menu} locale={locale} x={r.x} y={r.y} w={r.w} h={r.h} canvas={s.width}x{s.height} fits={fits}")

fn menu_item_at(s: &MainWindow, x: f64, y: f64) -> f64:
    if s.popup == 2:
        let r = clean_popup_rect(s)
        # The bound comes from the geometry constant, not a literal: adding a
        # menu row without widening this loop makes the new row unclickable
        # while it still draws, which is the worst of both.
        for row in 0..ui_geometry.CLEAN_MENU_ROWS:
            if ui_geometry.clean_menu_item_rect(&r, row).contains(x, y): return 500.0 + f64(row)
        return 0.0
    if s.popup == 3:
        let r = language_rect(s)
        for row in 0..2:
            if ui_geometry.language_menu_item_rect(&r, row).contains(x, y): return 601.0 + f64(row)
        return 0.0
    if s.popup == 1 and s.menu > 0:
        let r = menu_rect(s)
        for row in 0..ui_geometry.root_menu_row_count(s.menu):
            let target = root_menu_target(s.menu, row)
            if target != 0.0 and ui_geometry.root_menu_item_rect(&r, s.menu, row).contains(x, y): return target
    return 0.0

fn xproc_hit(s: &MainWindow, x: f64, y: f64) -> f64:
    let panel = xproc_panel(s)
    if s.xproc_view == 1:
        for row in 0..4:
            let index = s.xproc_scroll + row
            if index < xproc_count(s) and xproc_row_rect(row, &panel).contains(x, y): return 900.0 + f64(index)
        if xproc_picker_refresh_rect(&panel).contains(x, y): return 810.0
        if xproc_picker_continue_rect(&panel).contains(x, y): return 811.0
        if xproc_picker_cancel_rect(&panel).contains(x, y): return 812.0
    elif s.xproc_view == 2:
        for choice in 0..3:
            if xproc_budget_rect(choice, &panel).contains(x, y): return 822.0 + f64(choice)
        for mode in 0..2:
            if xproc_mode_rect(mode, &panel).contains(x, y): return 825.0 + f64(mode)
        if xproc_confirm_accept_rect(&panel).contains(x, y): return 820.0
        if xproc_confirm_cancel_rect(&panel).contains(x, y): return 821.0
    elif s.xproc_view == 3 and xproc_running_cancel_rect(&panel).contains(x, y):
        return 841.0
    elif s.xproc_view == 4 and xproc_result_close_rect(&panel).contains(x, y):
        return 840.0
    0.0

fn hit(s: &MainWindow, x: f64, y: f64) -> f64:
    if s.xproc_view != 0: return xproc_hit(s, x, y)
    if s.clean_state == 1:
        if clean_confirm_button(true).contains(x, y): return 710.0
        if clean_confirm_button(false).contains(x, y): return 711.0
        return 0.0
    if y >= 0.0 and y < 24.0:
        for index in 1..5:
            if ui_geometry.menu_bar_item_rect(index).contains(x, y): return f64(index)
    let item = menu_item_at(s, x, y)
    if item != 0.0: return item
    if s.popup == 1 or s.popup == 2 or s.popup == 3:
        if s.popup == 1 and menu_rect(s).contains(x, y): return 0.0
        if s.popup == 2 and clean_popup_rect(s).contains(x, y): return 0.0
        if s.popup == 3 and language_rect(s).contains(x, y): return 0.0
    for group in 0..3:
        if ui_geometry.group_disclosure_rect(group, s.width, s.height, s.collapsed_groups).contains(x, y):
            return 30.0 + f64(group)
        if ui_geometry.group_selection_rect(group, s.width, s.height, s.collapsed_groups).contains(x, y):
            return 40.0 + f64(group)
    let b = button_rect(s)
    if b.contains(x, y):
        if x >= b.right() - ui_geometry.clean_arrow_width_px(): return 20.0
        return 19.0
    return 0.0

fn draw_outline(p: &ui.Painter, r: &ui.Rect, color: &ui.Color):
    p.begin()
    p.add_rect(r)
    p.stroke(color, 1.0)

fn draw_menu_item(s: &MainWindow, p: &ui.Painter, r: &ui.Rect, target: f64, text: string, enabled: bool, fg: &ui.Color, disabled: &ui.Color, hot: &ui.Color):
    if enabled and (s.hover == target or s.menu_focus == target):
        p.fill_rect(r, hot)
    if enabled:
        p.text(r.x + 8.0, r.y + 5.0, text, fg, size=8.0)
    else:
        p.text(r.x + 8.0, r.y + 5.0, text, disabled, size=8.0)

fn draw_menu_shortcut(p: &ui.Painter, r: &ui.Rect, shortcut: string, color: &ui.Color):
    let width = ui.text_width(shortcut, size=8.0)
    p.text(r.right() - width - 8.0, r.y + 5.0, shortcut, color, size=8.0)

fn draw_menu_check(p: &ui.Painter, r: &ui.Rect, checked: bool, color: &ui.Color):
    if checked: p.text(r.x + 3.0, r.y + 4.0, "✓", color, size=8.0)

fn draw_menu_separator(p: &ui.Painter, r: &ui.Rect, color: &ui.Color):
    let y = r.y + r.h / 2.0
    p.line(r.x + 6.0, y, r.right() - 6.0, y, color)

fn draw_root_menu(s: &MainWindow, p: &ui.Painter, fg: &ui.Color, disabled: &ui.Color, border: &ui.Color, surface: &ui.Color, hot: &ui.Color):
    let r = menu_rect(s)
    p.fill_rect(&r, surface)
    draw_outline(p, &r, border)
    let row1 = ui_geometry.root_menu_item_rect(&r, s.menu, 0)
    if s.menu == 1:
        draw_menu_item(s, p, &row1, 101.0, label(s.zh, "Settings...", "设置..."), true, fg, disabled, hot)
        draw_menu_shortcut(p, &row1, "F2", fg)
        let separator = ui_geometry.root_menu_item_rect(&r, s.menu, 1)
        draw_menu_separator(p, &separator, border)
        let row2 = ui_geometry.root_menu_item_rect(&r, s.menu, 2)
        draw_menu_item(s, p, &row2, 102.0, label(s.zh, "Exit", "退出"), true, fg, disabled, hot)
    elif s.menu == 2:
        draw_menu_item(s, p, &row1, 201.0, label(s.zh, "Always on top", "窗口始终置顶"), false, fg, disabled, hot)
        let row2 = ui_geometry.root_menu_item_rect(&r, s.menu, 1)
        let dark_text = label(s.zh, "Use dark theme", "使用深色主题")
        draw_menu_item(s, p, &row2, 202.0, dark_text, true, fg, disabled, hot)
        draw_menu_check(p, &row2, s.dark, fg)
        let row3 = ui_geometry.root_menu_item_rect(&r, s.menu, 2)
        draw_menu_item(s, p, &row3, 203.0, label(s.zh, "Confirm memory cleaning start", "清理前确认"), false, fg, disabled, hot)
        draw_menu_check(p, &row3, true, disabled)
        let separator = ui_geometry.root_menu_item_rect(&r, s.menu, 3)
        draw_menu_separator(p, &separator, border)
        let row4 = ui_geometry.root_menu_item_rect(&r, s.menu, 4)
        draw_menu_item(s, p, &row4, 204.0, label(s.zh, "Language (Language)", "语言…… (Language)"), true, fg, disabled, hot)
        p.text(row4.right() - 12.0, row4.y + 4.0, "›", fg, size=8.0)
    elif s.menu == 3:
        draw_menu_item(s, p, &row1, 301.0, label(s.zh, "Load on system startup", "开机启动"), false, fg, disabled, hot)
        let row2 = ui_geometry.root_menu_item_rect(&r, s.menu, 1)
        draw_menu_item(s, p, &row2, 302.0, label(s.zh, "Start minimized", "最小化启动"), false, fg, disabled, hot)
        let row3 = ui_geometry.root_menu_item_rect(&r, s.menu, 2)
        draw_menu_item(s, p, &row3, 303.0, label(s.zh, "Skip \"User Account Control\" prompt warning", "跳过“用户账户控制（UAC）”提示"), false, fg, disabled, hot)
        let row4 = ui_geometry.root_menu_item_rect(&r, s.menu, 3)
        draw_menu_item(s, p, &row4, 304.0, label(s.zh, "Periodically check for updates (recommended)", "自动检查更新（推荐）"), false, fg, disabled, hot)
        draw_menu_check(p, &row4, true, disabled)
    else:
        draw_menu_item(s, p, &row1, 401.0, label(s.zh, "Website", "项目网站"), false, fg, disabled, hot)
        let row2 = ui_geometry.root_menu_item_rect(&r, s.menu, 1)
        draw_menu_item(s, p, &row2, 402.0, label(s.zh, "Check for updates", "检查更新"), false, fg, disabled, hot)
        let row3 = ui_geometry.root_menu_item_rect(&r, s.menu, 2)
        draw_menu_item(s, p, &row3, 403.0, label(s.zh, "About", "关于"), false, fg, disabled, hot)
        draw_menu_shortcut(p, &row3, "F1", disabled)

fn draw_language_menu(s: &MainWindow, p: &ui.Painter, fg: &ui.Color, border: &ui.Color, surface: &ui.Color, hot: &ui.Color):
    let r = language_rect(s)
    p.fill_rect(&r, surface)
    draw_outline(p, &r, border)
    let row1 = ui_geometry.language_menu_item_rect(&r, 0)
    let row2 = ui_geometry.language_menu_item_rect(&r, 1)
    draw_menu_item(s, p, &row1, 601.0, "English", true, fg, fg, hot)
    draw_menu_item(s, p, &row2, 602.0, "简体中文", true, fg, fg, hot)
    if not s.zh: p.text(r.x + r.w - 18.0, row1.y + 5.0, "✓", fg, size=8.0)
    if s.zh: p.text(r.x + r.w - 18.0, row2.y + 5.0, "✓", fg, size=8.0)

fn draw_stats_group(s: &mut MainWindow, p: &ui.Painter, group: i64, title: string, usage: string, available: string, total: string, fg: &ui.Color, secondary: &ui.Color, group_title: &ui.Color, rule: &ui.Color, selected: &ui.Color):
    let collapsed = ui_geometry.group_is_collapsed(s.collapsed_groups, group)
    let title_y = ui_geometry.group_title_y_for_mask(group, s.height, s.collapsed_groups)
    if s.selected_group == group:
        let selection = ui_geometry.group_selection_rect(group, s.width, s.height, s.collapsed_groups)
        p.fill_rect(&selection, selected)
    let title_x = ui_geometry.metric_title_x(s.width)
    let title_width = ui.text_width(title, size=8.0)
    let rule_x = title_x + title_width + 8.0
    let rule_y = ui_geometry.group_header_rule_y_for_mask(group, s.height, s.collapsed_groups)
    let rule_right = ui_geometry.list_right_x(s.width) - 20.0
    let value_x = ui_geometry.metric_value_x(s.width)
    let row0 = ui_geometry.metric_row_y_for_mask(group, 0, s.height, s.collapsed_groups)
    let row1 = ui_geometry.metric_row_y_for_mask(group, 1, s.height, s.collapsed_groups)
    let row2 = ui_geometry.metric_row_y_for_mask(group, 2, s.height, s.collapsed_groups)
    if rule_x < rule_right: p.line(rule_x, rule_y, rule_right, rule_y, rule)
    p.text(title_x, title_y, title, group_title, size=8.0)
    let disclosure = ui_geometry.group_disclosure_rect(group, s.width, s.height, s.collapsed_groups)
    if collapsed:
        p.line(disclosure.x + 2.0, disclosure.y + 2.0, disclosure.x + 7.0, disclosure.y + 6.0, group_title)
        p.line(disclosure.x + 7.0, disclosure.y + 6.0, disclosure.x + 2.0, disclosure.y + 10.0, group_title)
    else:
        p.line(disclosure.x + 2.0, disclosure.y + 8.0, disclosure.x + 6.0, disclosure.y + 3.0, group_title)
        p.line(disclosure.x + 6.0, disclosure.y + 3.0, disclosure.x + 10.0, disclosure.y + 8.0, group_title)
    if not collapsed:
        let label0 = label(s.zh, "Usage", "已用")
        let label1 = label(s.zh, "Available", "空闲")
        let label2 = label(s.zh, "Total available", "总计")
        p.text(ui_geometry.metric_row_label_x(s.width, 0, s.zh), row0, label0, secondary, size=8.0)
        p.text(value_x, row0, usage, fg, size=8.0)
        p.text(ui_geometry.metric_row_label_x(s.width, 1, s.zh), row1, label1, secondary, size=8.0)
        p.text(value_x, row1, available, fg, size=8.0)
        p.text(ui_geometry.metric_row_label_x(s.width, 2, s.zh), row2, label2, secondary, size=8.0)
        p.text(value_x, row2, total, fg, size=8.0)
    if s.test_mode:
        let locale = label(s.zh, "en", "zh-CN")
        mr_runtime_emit(f"CI_LAYOUT_GROUP index={group} locale={locale} title={title} collapsed={collapsed} usage={usage} available={available} total={total} title_y={title_y} rule_x={rule_x} rule_y={rule_y} row0={row0} row1={row1} row2={row2}")

fn draw_clean_menu(s: &MainWindow, p: &ui.Painter, fg: &ui.Color, disabled: &ui.Color, border: &ui.Color, surface: &ui.Color, hot: &ui.Color):
    let r = clean_popup_rect(s)
    p.fill_rect(&r, surface)
    draw_outline(p, &r, border)
    # ADR-0006: the first two entries are the Linux actions that actually exist.
    # The rest stay disabled because they name Windows objects that Linux has no
    # equivalent for; leaving them listed keeps the divergence visible instead of
    # silently dropping rows the original has.
    let names_en = ["Trim this app's memory (no privilege)", "Clean page cache (needs authorization)", "Modified page list", "Standby list", "Standby list (without priority)", "Modified file cache", "Registry cache (Windows)", "Combine memory lists (Windows)", "Select user app to reclaim (experimental)", "Balanced clean"]
    let names_zh = ["释放本程序内存（无需授权）", "清理页缓存（需系统授权）", "已修改页列表", "备用列表", "无优先级备用列表", "已修改文件缓存", "注册表缓存（Windows）", "合并内存列表（Windows）", "选择用户应用回收（实验）", "均衡清理"]
    for i in 0..ui_geometry.CLEAN_MENU_ROWS:
        let row = ui_geometry.clean_menu_item_rect(&r, i)
        let target = 500.0 + f64(i)
        let mut name = names_en[i]
        if s.zh: name = names_zh[i]
        let mut enabled = i == 0 or (i == 1 and (s.clean_simulation or (s.clean_production and s.main_close_guard_ready))) or (i == 8 and xproc_available(s) and not xproc_operation_busy(s))
        if i == 9:
            # The balanced row carries its own availability answer, so a machine
            # with no eligible scope shows a disabled row instead of running and
            # then reporting zero.
            enabled = bal_entry_state(s) == 2
        draw_menu_item(s, p, &row, target, name, enabled, fg, disabled, hot)

fn draw_clean_confirmation(s: &MainWindow, p: &ui.Painter, fg: &ui.Color, secondary: &ui.Color, border: &ui.Color, surface: &ui.Color, hot: &ui.Color):
    let panel = clean_confirm_panel(s)
    p.fill_rect(&panel, surface)
    draw_outline(p, &panel, border)
    # The panel width is fixed, so every line has to fit inside it. Split the
    # explanation over two short lines instead of one long one that the panel
    # edge would clip mid-word.
    let backend_mode = if s.clean_simulation: "simulation" else: "production"
    let title_text = if s.clean_simulation: label(s.zh, "Test-only simulated clean", "仅测试模拟清理") else: label(s.zh, "Clean page cache", "清理页缓存")
    # The production warning must carry the risks the kernel documents and must
    # never promise an amount: dropping caches costs later re-reads, may not
    # touch dirty objects, and does not guarantee any free memory. The simulated
    # path keeps its own wording so a test string can never stand in for a
    # production warning.
    let body_a = if s.clean_simulation: label(s.zh, "Mock helper only; writes a temp file.", "仅使用模拟 helper，只写临时文件。") else: label(s.zh, "Drops clean page cache only.", "仅丢弃干净页缓存。")
    let body_b = if s.clean_simulation: label(s.zh, "No system memory is changed.", "不会改动系统内存。") else: label(s.zh, "Re-reads slower; no amount guaranteed.", "重读变慢；不保证释放量。")
    p.text(panel.x + 10.0, panel.y + 9.0, title_text, fg, size=8.0)
    p.text(panel.x + 10.0, panel.y + 26.0, body_a, secondary, size=8.0)
    p.text(panel.x + 10.0, panel.y + 40.0, body_b, secondary, size=8.0)
    if s.test_mode:
        let inner = panel.w - 20.0
        let mut widest = ui.text_width(title_text, size=8.0)
        let wa = ui.text_width(body_a, size=8.0)
        let wb = ui.text_width(body_b, size=8.0)
        if wa > widest: widest = wa
        if wb > widest: widest = wb
        # Report the strings that were actually drawn. Asserting their content
        # here would only re-check this same literal; the wording guarantee is
        # enforced where it can be verified, against the source, in the test suite.
        mr_runtime_emit(f"CI_CLEAN_CONFIRM_TEXT mode={backend_mode} inner_width={inner} widest_line={widest} fits={widest <= inner} line2={body_a} line3={body_b}")
    let confirm = clean_confirm_button(true)
    let cancel = clean_confirm_button(false)
    if s.clean_confirm_focus == 0: p.fill_rect(&confirm, hot)
    else: p.fill_rect(&confirm, surface)
    draw_outline(p, &confirm, border)
    p.text(confirm.x + 17.0, confirm.y + 6.0, label(s.zh, "Run", "确认"), fg, size=8.0)
    if s.clean_confirm_focus == 1: p.fill_rect(&cancel, hot)
    else: p.fill_rect(&cancel, surface)
    draw_outline(p, &cancel, border)
    p.text(cancel.x + 15.0, cancel.y + 6.0, label(s.zh, "Cancel", "取消"), fg, size=8.0)

fn xproc_bytes(bytes: i64) -> string:
    if bytes < 0: return "unavailable"
    if bytes >= 1073741824:
        let whole = bytes // 1073741824
        let tenths = (bytes % 1073741824) * 10 // 1073741824
        return f"{whole}.{tenths} GiB"
    if bytes >= 1048576:
        let whole = bytes // 1048576
        let tenths = (bytes % 1048576) * 10 // 1048576
        return f"{whole}.{tenths} MiB"
    if bytes >= 1024: return f"{bytes // 1024} KiB"
    f"{bytes} bytes"

fn xproc_button(p: &ui.Painter, rect: &ui.Rect, text: string, focused: bool, enabled: bool, fg: &ui.Color, disabled: &ui.Color, border: &ui.Color, surface: &ui.Color, hot: &ui.Color):
    if focused and enabled: p.fill_rect(rect, hot)
    else: p.fill_rect(rect, surface)
    draw_outline(p, rect, border)
    if enabled: p.text(rect.x + 8.0, rect.y + 6.0, text, fg, size=8.0)
    else: p.text(rect.x + 8.0, rect.y + 6.0, text, disabled, size=8.0)

fn draw_xproc(s: &MainWindow, p: &ui.Painter, fg: &ui.Color, secondary: &ui.Color, disabled: &ui.Color, border: &ui.Color, surface: &ui.Color, hot: &ui.Color):
    if s.xproc_view == 0: return
    let panel = xproc_panel(s)
    p.fill_rect(&panel, surface)
    draw_outline(p, &panel, border)
    let simulation_note = if s.xproc_simulation: label(s.zh, "SIMULATION — no system action", "模拟执行——不会操作系统进程") else: label(s.zh, "one user-selected process; helper rechecks identity", "仅一个手动选择的进程；helper 会重新核验身份")
    p.text(panel.x + 9.0, panel.y + 8.0, simulation_note, fg, size=8.0)
    if s.xproc_view == 1:
        let warning = label(s.zh, "Preview only; advice is not bytes freed.", "仅供预览；建议量不等于释放量。")
        let risk = label(s.zh, "PAGEOUT may use swap/I/O and stall the target.", "PAGEOUT 可能占用 swap/I/O 并使目标卡顿。")
        p.text(panel.x + 9.0, panel.y + 23.0, warning, secondary, size=8.0)
        p.text(panel.x + 9.0, panel.y + 36.0, risk, secondary, size=8.0)
        if s.xproc_preflight != 0 or s.xproc_scan_status != 0:
            p.text(panel.x + 9.0, panel.y + 82.0, xproc_preflight_text(s.zh, mr_xproc_enabled(), s.xproc_preflight, s.xproc_scan_status), secondary, size=8.0)
        else:
            let count = xproc_count(s)
            let mut visible = 0
            for row in 0..4:
                let index = s.xproc_scroll + row
                if index < count:
                    let rect = xproc_row_rect(row, &panel)
                    if index == s.xproc_selected: p.fill_rect(&rect, hot)
                    if s.xproc_focus == 0 and index == s.xproc_selected: draw_outline(p, &rect, border)
                    let name = xproc_candidate_name(s, index)
                    let app_name = xproc_candidate_app_name(s, index)
                    let process_state = xproc_candidate_state_text(s.zh, xproc_candidate_state(s, index))
                    let pid = xproc_pid(s, index)
                    let uid = xproc_uid(s, index)
                    let regions = xproc_candidate_regions(s, index)
                    let private_resident = xproc_candidate_private_resident_bytes(s, index)
                    p.text(rect.x + 4.0, rect.y + 1.0, f"{name}  PID {pid}", fg, size=8.0)
                    p.text(rect.x + 4.0, rect.y + 12.0, label(s.zh, f"UID {uid} · app {app_name}", f"UID {uid} · 应用 {app_name}"), secondary, size=8.0)
                    p.text(rect.x + 4.0, rect.y + 23.0, label(s.zh, f"{process_state} · {regions} private regions · {xproc_bytes(private_resident)} resident estimate", f"{process_state} · 私有区域 {regions} 个 · 常驻估计 {xproc_bytes(private_resident)}"), secondary, size=7.0)
                    visible += 1
            if count == 0:
                p.text(panel.x + 9.0, panel.y + 82.0, label(s.zh, "No eligible user application found.", "未找到符合条件的用户应用。"), secondary, size=8.0)
            elif visible > 0:
                p.text(panel.x + 9.0, panel.y + 197.0, label(s.zh, "Only user app scopes are listed; identity is checked again.", "仅列出用户应用作用域；操作前会再次核验身份。"), secondary, size=8.0)
        xproc_button(p, xproc_picker_refresh_rect(&panel), label(s.zh, "Refresh", "刷新"), s.xproc_focus == 1, not xproc_operation_busy(s), fg, disabled, border, surface, hot)
        let can_continue = s.xproc_selected >= 0 and s.xproc_request_id > 0 and s.xproc_target_identity_token > 0 and s.xproc_target_scope_hash > 0 and s.xproc_target_region_digest > 0 and not xproc_operation_busy(s)
        xproc_button(p, xproc_picker_continue_rect(&panel), label(s.zh, "Continue…", "继续……"), s.xproc_focus == 2, can_continue, fg, disabled, border, surface, hot)
        xproc_button(p, xproc_picker_cancel_rect(&panel), label(s.zh, "Close", "关闭"), s.xproc_focus == 3, true, fg, disabled, border, surface, hot)
    elif s.xproc_view == 2:
        let name = s.xproc_target_name
        let budget = xproc_budget(s.xproc_target_bytes, s.xproc_target_rss_bytes, s.xproc_target_private_resident_bytes, s.xproc_target_scope_bytes, s.xproc_budget_choice, s.xproc_mode_choice)
        p.text(panel.x + 9.0, panel.y + 27.0, label(s.zh, "Confirm one process and one bounded request.", "请确认单个进程和有限范围请求。"), fg, size=8.0)
        p.text(panel.x + 9.0, panel.y + 45.0, f"{name}  PID {s.xproc_target_pid}  UID {s.xproc_target_uid}", fg, size=8.0)
        p.text(panel.x + 9.0, panel.y + 60.0, xproc_confirmation_start_time(s.zh, s.xproc_target_start_time), secondary, size=8.0)
        p.text(panel.x + 9.0, panel.y + 73.0, label(s.zh, f"Application: {s.xproc_target_app_name}", f"应用：{s.xproc_target_app_name}"), secondary, size=8.0)
        if s.xproc_mode_choice == 0:
            p.text(panel.x + 9.0, panel.y + 86.0, label(s.zh, f"Request {xproc_budget_label(budget)} · RSS {xproc_bytes(s.xproc_target_rss_bytes)}", f"请求 {xproc_budget_label(budget)} · RSS {xproc_bytes(s.xproc_target_rss_bytes)}"), secondary, size=8.0)
            p.text(panel.x + 9.0, panel.y + 99.0, label(s.zh, f"Private resident: {xproc_bytes(s.xproc_target_private_resident_bytes)}" , f"私有常驻：{xproc_bytes(s.xproc_target_private_resident_bytes)}") + f" · {xproc_budget_limit_text(s.zh, s.xproc_target_bytes, s.xproc_target_rss_bytes, s.xproc_target_private_resident_bytes, s.xproc_target_scope_bytes, s.xproc_budget_choice, s.xproc_mode_choice)}", secondary, size=7.0)
        else:
            p.text(panel.x + 9.0, panel.y + 86.0, label(s.zh, f"Request {xproc_budget_label(budget)} · scope anon+file {xproc_bytes(s.xproc_target_scope_bytes)}", f"请求 {xproc_budget_label(budget)} · 作用域 匿名+文件 {xproc_bytes(s.xproc_target_scope_bytes)}"), secondary, size=7.0)
            p.text(panel.x + 9.0, panel.y + 99.0, xproc_budget_limit_text(s.zh, s.xproc_target_bytes, s.xproc_target_rss_bytes, s.xproc_target_private_resident_bytes, s.xproc_target_scope_bytes, s.xproc_budget_choice, s.xproc_mode_choice), secondary, size=7.0)
        for choice in 0..3:
            let rect = xproc_budget_rect(choice, &panel)
            let base_amount = if choice == 0: "256 MiB" elif choice == 1: "512 MiB" else: "1 GiB"
            let amount = if s.xproc_budget_choice == choice: f"✓ {base_amount}" else: base_amount
            xproc_button(p, &rect, amount, s.xproc_focus == choice, true, fg, disabled, border, surface, hot)
        for mode in 0..2:
            let rect = xproc_mode_rect(mode, &panel)
            let base_mode = if mode == 0: label(s.zh, "This process", "仅此进程") else: label(s.zh, "Whole app scope", "整个应用作用域")
            let mode_label = if s.xproc_mode_choice == mode: f"✓ {base_mode}" else: base_mode
            let mode_available = mode == 0 or s.xproc_target_scope_bytes > 0
            xproc_button(p, &rect, mode_label, s.xproc_focus == 3 + mode, mode_available, fg, disabled, border, surface, hot)
        let selection_scope = xproc_selection_scope_text(s.zh, s.xproc_mode_choice)
        p.text(panel.x + 9.0, panel.y + 163.0, selection_scope, secondary, size=7.0)
        let effect = if s.xproc_mode_choice == 0:
            label(s.zh, "PAGEOUT may use swap/I/O and slow this process.", "PAGEOUT 可能使用 swap/I/O 并使该进程变慢。")
        else:
            label(s.zh, "memory.reclaim affects every process in this app scope.", "memory.reclaim 会影响此应用作用域内的全部进程。")
        p.text(panel.x + 9.0, panel.y + 177.0, effect, secondary, size=7.0)
        p.text(panel.x + 9.0, panel.y + 191.0, label(s.zh, "Advised/requested bytes are not bytes freed.", "内核建议量不等于实际释放量。"), secondary, size=7.0)
        p.text(panel.x + 9.0, panel.y + 205.0, label(s.zh, "Observed changes may have other causes.", "观测变化也可能来自其他原因。"), secondary, size=7.0)
        let can_run = budget >= 4096
        xproc_button(p, xproc_confirm_accept_rect(&panel), label(s.zh, "Authorize and run", "授权并执行"), s.xproc_focus == 5, can_run, fg, disabled, border, surface, hot)
        xproc_button(p, xproc_confirm_cancel_rect(&panel), label(s.zh, "Cancel", "取消"), s.xproc_focus == 6, true, fg, disabled, border, surface, hot)
    elif s.xproc_view == 3:
        if s.xproc_cancel_status == 1:
            p.text(panel.x + 9.0, panel.y + 34.0, label(s.zh, "Cancellation requested; waiting for the child to stop.", "已请求取消；正在等待子进程停止。"), fg, size=8.0)
            p.text(panel.x + 9.0, panel.y + 58.0, label(s.zh, "If authorization already completed, the result may be uncertain.", "如果授权已完成，结果可能不确定。"), secondary, size=7.0)
        elif s.xproc_cancel_status == 2:
            p.text(panel.x + 9.0, panel.y + 34.0, label(s.zh, "Could not stop the authorization process.", "无法停止授权进程。"), fg, size=8.0)
            p.text(panel.x + 9.0, panel.y + 58.0, label(s.zh, "The request is still active; do not start another.", "请求仍在运行；请勿再次启动。"), secondary, size=7.0)
        else:
            p.text(panel.x + 9.0, panel.y + 34.0, xproc_waiting_text(s.zh, s.xproc_state, s.xproc_simulation), fg, size=8.0)
            let cancel_hint = if s.xproc_simulation:
                label(s.zh, "Press Escape to cancel the mock request.", "按 Escape 取消测试请求。")
            else:
                label(s.zh, "No Polkit window? Press Escape to cancel this request.", "没有 Polkit 窗口？按 Escape 取消本次请求。")
            p.text(panel.x + 9.0, panel.y + 58.0, cancel_hint, secondary, size=7.0)
        p.text(panel.x + 9.0, panel.y + 78.0, label(s.zh, "A stop request does not prove the helper did not start.", "发送停止信号不代表 helper 一定尚未启动。"), secondary, size=7.0)
        xproc_button(p, xproc_running_cancel_rect(&panel), label(s.zh, "Cancel", "取消"), s.xproc_focus == 1, s.xproc_cancel_status != 1, fg, disabled, border, surface, hot)
    else:
        let reason = if s.xproc_simulation: "simulated-partial" else: mr_xproc_result_reason()
        p.text(panel.x + 9.0, panel.y + 27.0, xproc_result_text(s.zh, s.xproc_state, s.xproc_simulation, s.xproc_mode_choice), fg, size=8.0)
        p.text(panel.x + 9.0, panel.y + 49.0, label(s.zh, f"Target PID {s.xproc_target_pid} · UID {s.xproc_target_uid}", f"目标 PID {s.xproc_target_pid} · UID {s.xproc_target_uid}"), secondary, size=8.0)
        if s.xproc_mode_choice == 0:
            p.text(panel.x + 9.0, panel.y + 68.0, label(s.zh, f"Helper selected: {xproc_bytes(s.xproc_requested_bytes)} of {xproc_budget_label(xproc_budget_limit(s.xproc_budget_choice))}", f"helper 选定：{xproc_bytes(s.xproc_requested_bytes)} / {xproc_budget_label(xproc_budget_limit(s.xproc_budget_choice))}"), fg, size=8.0)
            p.text(panel.x + 9.0, panel.y + 84.0, f"{xproc_advised_bytes_label(s.zh, s.xproc_simulation)} {xproc_bytes(s.xproc_advised_bytes)}", fg, size=8.0)
            p.text(panel.x + 9.0, panel.y + 100.0, label(s.zh, f"Regions: {s.xproc_regions} · helper calls: {s.xproc_call_count}", f"区域 {s.xproc_regions} 个 · helper 调用 {s.xproc_call_count} 次"), secondary, size=7.0)
            p.text(panel.x + 9.0, panel.y + 116.0, label(s.zh, f"Target RSS: {xproc_kib_text(s.zh, s.xproc_target_rss_before_kib)} → {xproc_kib_text(s.zh, s.xproc_target_rss_after_kib)}", f"目标 RSS：{xproc_kib_text(s.zh, s.xproc_target_rss_before_kib)} → {xproc_kib_text(s.zh, s.xproc_target_rss_after_kib)}"), secondary, size=7.0)
            p.text(panel.x + 9.0, panel.y + 132.0, label(s.zh, f"Target swap: {xproc_kib_text(s.zh, s.xproc_target_swap_before_kib)} → {xproc_kib_text(s.zh, s.xproc_target_swap_after_kib)}", f"目标 swap：{xproc_kib_text(s.zh, s.xproc_target_swap_before_kib)} → {xproc_kib_text(s.zh, s.xproc_target_swap_after_kib)}"), secondary, size=7.0)
            p.text(panel.x + 9.0, panel.y + 148.0, label(s.zh, f"Reason: {reason} · errno {s.xproc_error_code}", f"原因：{reason} · errno {s.xproc_error_code}"), secondary, size=7.0)
            if (s.xproc_state == 10 or s.xproc_state == 11) and s.xproc_requested_bytes < xproc_budget(s.xproc_target_bytes, s.xproc_target_rss_bytes, s.xproc_target_private_resident_bytes, s.xproc_target_scope_bytes, s.xproc_budget_choice, s.xproc_mode_choice):
                p.text(panel.x + 9.0, panel.y + 163.0, label(s.zh, "Helper capped the request to current eligible resident pages.", "helper 已按复核后的合格驻留页缩小请求。"), secondary, size=7.0)
            let child_exit = if s.xproc_simulation: -1 else: mr_xproc_result_exit_code()
            let child_signal = if s.xproc_simulation: 0 else: mr_xproc_result_signal()
            let exit_detail = xproc_exit_detail(s.zh, child_exit, child_signal)
            if exit_detail != "" and (s.xproc_state == 19 or s.xproc_state == 24 or s.xproc_state == 25 or s.xproc_state == 27):
                p.text(panel.x + 9.0, panel.y + 177.0, exit_detail, secondary, size=7.0)
            p.text(panel.x + 9.0, panel.y + 191.0, label(s.zh, f"MemAvailable KiB: {s.xproc_before_available} → {s.xproc_after_available}", f"MemAvailable（KiB）：{s.xproc_before_available} → {s.xproc_after_available}"), secondary, size=7.0)
            p.text(panel.x + 9.0, panel.y + 205.0, label(s.zh, "Advised bytes and observed deltas are not bytes freed.", "内核建议量和观测变化都不等于实际释放量。"), secondary, size=7.0)
        else:
            p.text(panel.x + 9.0, panel.y + 68.0, label(s.zh, f"memory.reclaim request: {xproc_bytes(s.xproc_requested_bytes)}", f"memory.reclaim 请求：{xproc_bytes(s.xproc_requested_bytes)}"), fg, size=8.0)
            p.text(panel.x + 9.0, panel.y + 86.0, label(s.zh, f"Scope current: {xproc_mib_bytes_text(s.zh, s.xproc_scope_current_before_bytes)} → {xproc_mib_bytes_text(s.zh, s.xproc_scope_current_after_bytes)}", f"作用域当前：{xproc_mib_bytes_text(s.zh, s.xproc_scope_current_before_bytes)} → {xproc_mib_bytes_text(s.zh, s.xproc_scope_current_after_bytes)}"), secondary, size=7.0)
            p.text(panel.x + 9.0, panel.y + 104.0, label(s.zh, f"Anon {xproc_mib_compact(s.xproc_scope_anon_before_bytes)}→{xproc_mib_compact(s.xproc_scope_anon_after_bytes)} · file {xproc_mib_compact(s.xproc_scope_file_before_bytes)}→{xproc_mib_compact(s.xproc_scope_file_after_bytes)} MiB", f"匿名 {xproc_mib_compact(s.xproc_scope_anon_before_bytes)}→{xproc_mib_compact(s.xproc_scope_anon_after_bytes)} · 文件 {xproc_mib_compact(s.xproc_scope_file_before_bytes)}→{xproc_mib_compact(s.xproc_scope_file_after_bytes)} MiB"), secondary, size=7.0)
            p.text(panel.x + 9.0, panel.y + 122.0, label(s.zh, f"Scope swap: {xproc_mib_bytes_text(s.zh, s.xproc_scope_swap_before_bytes)} → {xproc_mib_bytes_text(s.zh, s.xproc_scope_swap_after_bytes)}", f"作用域 swap：{xproc_mib_bytes_text(s.zh, s.xproc_scope_swap_before_bytes)} → {xproc_mib_bytes_text(s.zh, s.xproc_scope_swap_after_bytes)}"), secondary, size=7.0)
            p.text(panel.x + 9.0, panel.y + 140.0, label(s.zh, f"Regions: {s.xproc_regions} · calls: {s.xproc_call_count}", f"区域 {s.xproc_regions} 个 · 调用 {s.xproc_call_count} 次"), secondary, size=7.0)
            p.text(panel.x + 9.0, panel.y + 158.0, label(s.zh, f"Reason: {reason} · errno {s.xproc_error_code}", f"原因：{reason} · errno {s.xproc_error_code}"), secondary, size=7.0)
            let child_exit = if s.xproc_simulation: -1 else: mr_xproc_result_exit_code()
            let child_signal = if s.xproc_simulation: 0 else: mr_xproc_result_signal()
            let exit_detail = xproc_exit_detail(s.zh, child_exit, child_signal)
            if exit_detail != "" and (s.xproc_state == 19 or s.xproc_state == 24 or s.xproc_state == 25 or s.xproc_state == 27):
                p.text(panel.x + 9.0, panel.y + 174.0, exit_detail, secondary, size=7.0)
            p.text(panel.x + 9.0, panel.y + 190.0, label(s.zh, f"MemAvailable KiB: {s.xproc_before_available} → {s.xproc_after_available}", f"MemAvailable（KiB）：{s.xproc_before_available} → {s.xproc_after_available}"), secondary, size=7.0)
            p.text(panel.x + 9.0, panel.y + 205.0, label(s.zh, "Scope and MemAvailable deltas are observations.", "作用域和 MemAvailable 变化仅是观测值。"), secondary, size=7.0)
        xproc_button(p, xproc_result_close_rect(&panel), label(s.zh, "Close", "关闭"), true, true, fg, disabled, border, surface, hot)

fn draw(s: &mut MainWindow, p: &ui.Painter):
    let old_w = s.width
    let old_h = s.height
    s.width = p.width()
    s.height = p.height()
    if s.test_mode and (not s.draw_logged or old_w != s.width or old_h != s.height):
        s.draw_logged = true
        mr_runtime_emit(f"CI_DRAW width={s.width} height={s.height}")
        # Publish the two rects an external harness must click. The canvas
        # origin is the window origin (the header bar is outside the canvas),
        # so a harness only needs the window position plus these.
        let b = button_rect(s)
        mr_runtime_emit(f"CI_CLEAN_BUTTON x={b.x} y={b.y} w={b.w} h={b.h}")

    let mut surface = ui.rgb(0xffffff)
    let mut fg = ui.rgb(0x000000)
    let mut secondary = ui.rgb(0x000000)
    let mut disabled = ui.rgb(0x858585)
    let mut border = ui.rgb(0x8c8c8c)
    let mut rule = ui.rgb(0xb0b0b0)
    let mut group_title = ui.rgb(0x1e3287)
    let mut group_rule = ui.rgb(0xb2c1e0)
    let mut button_bg = ui.rgb(0xe1e1e1)
    let mut hot = ui.rgb(0xdce8f5)
    let mut pressed_bg = ui.rgb(0xc4d7ec)
    let mut selected = ui.rgb(0xe5f3ff)
    let mut column_rule = ui.rgb(0xebf4fe)
    if s.dark:
        surface = ui.rgb(0x242424)
        fg = ui.rgb(0xe9e9e9)
        secondary = ui.rgb(0xc5c5c5)
        disabled = ui.rgb(0x777777)
        border = ui.rgb(0x707070)
        rule = ui.rgb(0x5b5b5b)
        group_title = ui.rgb(0x9bbcff)
        group_rule = ui.rgb(0x48648a)
        button_bg = ui.rgb(0x3a3a3a)
        hot = ui.rgb(0x3c5066)
        pressed_bg = ui.rgb(0x485b70)
        selected = ui.rgb(0x3c5066)
        column_rule = ui.rgb(0x5b5b5b)

    p.fill_rect(&ui.rect(0.0, 0.0, s.width, s.height), &surface)
    p.text(8.0, 5.0, label(s.zh, "File", "文件"), &fg, size=8.0)
    p.text(48.0, 5.0, label(s.zh, "View", "视图"), &fg, size=8.0)
    p.text(92.0, 5.0, label(s.zh, "Settings", "设置"), &fg, size=8.0)
    p.text(160.0, 5.0, label(s.zh, "Help", "帮助"), &fg, size=8.0)
    p.line(0.0, 23.5, s.width, 23.5, rule)
    for index in 1..5:
        if menu_item_has_keyboard_focus(s.focus, index - 1): draw_outline(p, &ui_geometry.menu_bar_item_rect(index), &border)

    draw_stats_group(s, p, 0, label(s.zh, "Physical memory", "物理内存"), usage_percentage(s.mem_total - s.mem_available, s.mem_total, s.sample_ok), value(s.mem_available, s.sample_ok), value(s.mem_total, s.sample_ok), &fg, &secondary, &group_title, &group_rule, &selected)
    draw_stats_group(s, p, 1, label(s.zh, "Pagefile / Swap", "交换空间"), usage_percentage(s.swap_total - s.swap_free, s.swap_total, s.sample_ok), value(s.swap_free, s.sample_ok), value(s.swap_total, s.sample_ok), &fg, &secondary, &group_title, &group_rule, &selected)
    # Windows reads a system_cache field here; Linux has no whole-system working
    # set figure. An em dash in every cell reads as a broken panel, so the group
    # states why it is empty instead of looking like a loading failure.
    let ws_note_usage = label(s.zh, "Not available on Linux", "Linux 无此指标")
    let ws_note_available = label(s.zh, "Not available on Linux", "Linux 无此指标")
    let ws_note_total = label(s.zh, "Not available on Linux", "Linux 无此指标")
    draw_stats_group(s, p, 2, label(s.zh, "System working set", "系统工作集"), ws_note_usage, ws_note_available, ws_note_total, &fg, &secondary, &group_title, &group_rule, &selected)
    for index in 0..2:
        let x = ui_geometry.main_column_rule_x_px(index)
        p.line(x, ui_geometry.main_column_rule_top_y_px(), x, ui_geometry.main_column_rule_bottom_y_px(), &column_rule)
    if s.test_mode and not s.sample_ok and not s.sample_failure_draw_logged:
        s.sample_failure_draw_logged = true
        mr_runtime_emit("CI_DRAW_SAMPLE state=unavailable values=em-dash")

    let b = button_rect(s)
    p.fill_rect(&b, button_bg)
    if s.hover == 19.0: p.fill_rect(&b, button_bg)
    if s.hover == 20.0: p.fill_rect(&ui.rect(b.right() - ui_geometry.clean_arrow_width_px(), b.y, ui_geometry.clean_arrow_width_px(), b.h), hot)
    if s.pressed == 20.0: p.fill_rect(&ui.rect(b.right() - ui_geometry.clean_arrow_width_px(), b.y, ui_geometry.clean_arrow_width_px(), b.h), pressed_bg)
    draw_outline(p, &b, border)
    let clean_label = label(s.zh, "Clean memory", "清理内存")
    let clean_label_width = ui.text_width(clean_label, size=8.0)
    # The label keeps the normal foreground in every build. A greyed-out button
    # reads as "this control is broken"; what is actually true is that the action
    # is not available here, and that belongs in the status line where the user
    # finds the reason rather than in the label's colour alone.
    # The label keeps the normal foreground in every build: a greyed-out button
    # reads as "this control is broken", and the actual reason belongs in the
    # status line, not squeezed into the button next to the label.
    p.text(ui_geometry.clean_button_label_x(s.width, s.height, clean_label_width), b.y + 5.0, clean_label, &fg, size=8.0)
    # Centre the chevron inside the 17px drop-down cell instead of pinning it to
    # the outer edge: the divider is at right-17, so the cell runs from there to
    # the button edge and the glyph belongs in the middle of it.
    let arrow_right = b.right() - ui_geometry.clean_arrow_width_px()
    let chevron_mid = arrow_right + ui_geometry.clean_arrow_width_px() / 2.0
    p.line(arrow_right, b.y, arrow_right, b.bottom(), &border)
    p.line(chevron_mid - 5.0, b.y + 7.0, chevron_mid, b.y + 12.0, &disabled)
    p.line(chevron_mid, b.y + 12.0, chevron_mid + 5.0, b.y + 7.0, &disabled)
    if s.focus == 4.0: draw_outline(p, &ui.rect(b.right() - ui_geometry.clean_arrow_width_px(), b.y + 1.0, ui_geometry.clean_arrow_width_px() - 2.0, b.h - 2.0), &border)
    if s.status != "": p.text(ui_geometry.metric_label_x(s.width), list_y(s, 183.0), s.status, &secondary, size=8.0)

    if s.popup == 1:
        draw_root_menu(s, p, &fg, &disabled, &border, &surface, &hot)
    elif s.popup == 2:
        draw_clean_menu(s, p, &fg, &disabled, &border, &surface, &hot)
    elif s.popup == 3:
        draw_root_menu(s, p, &fg, &disabled, &border, &surface, &hot)
        draw_language_menu(s, p, &fg, &border, &surface, &hot)
    if s.clean_state == 1: draw_clean_confirmation(s, p, &fg, &secondary, &border, &surface, &hot)
    draw_xproc(s, p, &fg, &secondary, &disabled, &border, &surface, &hot)

fn value(kib: i64, available: bool) -> string:
    if not available: return "—"
    let amount = max(0, kib)
    if amount >= 1048576:
        let tenths = (amount * 10 + 524288) // 1048576
        return f"{tenths // 10}.{tenths % 10} GB"
    if amount >= 1024:
        let tenths = (amount * 10 + 512) // 1024
        return f"{tenths // 10}.{tenths % 10} MB"
    f"{amount} KB"

fn usage_percentage(used_kib: i64, total_kib: i64, available: bool) -> string:
    if not available or total_kib <= 0: return "—"
    let thousandths = memory.percent_thousandths(used_kib, total_kib)
    let whole = thousandths // 1000
    let fraction = thousandths % 1000
    if fraction < 10: return f"{whole}.00{fraction}%"
    if fraction < 100: return f"{whole}.0{fraction}%"
    f"{whole}.{fraction}%"

fn test_usage_percentage_matches_upstream_metric():
    assert(usage_percentage(1072, 15989, true) == "6.705%")
    assert(usage_percentage(1, 3, true) == "33.333%")
    assert(usage_percentage(0, 100, true) == "0.000%")
    assert(usage_percentage(1, 0, true) == "—")
    assert(usage_percentage(1, 100, false) == "—")

fn test_value_matches_upstream_scale_and_unavailable_state():
    assert(value(15728640, true) == "15.0 GB")
    assert(value(1536, true) == "1.5 MB")
    assert(value(512, true) == "512 KB")
    assert(value(512, false) == "—")

fn test_ci_sample_failure_latch_is_test_only():
    assert(suppress_ci_resample(true, true))
    assert(not suppress_ci_resample(true, false))
    assert(not suppress_ci_resample(false, true))

fn test_xproc_budget_and_result_mapping_are_fail_closed():
    assert(xproc_budget(-1, 0, 0, 0, 0, 0) == 0)
    assert(xproc_budget(0, 0, 0, 0, 0, 0) == 0)
    assert(xproc_budget(2 * 1024 * 1024 * 1024, 3 * 1024 * 1024 * 1024, 2 * 1024 * 1024 * 1024, 0, 0, 0) == 256 * 1024 * 1024)
    assert(xproc_budget(2 * 1024 * 1024 * 1024, 3 * 1024 * 1024 * 1024, 2 * 1024 * 1024 * 1024, 0, 1, 0) == 512 * 1024 * 1024)
    assert(xproc_budget(2 * 1024 * 1024 * 1024, 3 * 1024 * 1024 * 1024, 2 * 1024 * 1024 * 1024, 0, 2, 0) == 1024 * 1024 * 1024)
    assert(xproc_budget(2 * 1024 * 1024 * 1024, 128 * 1024 * 1024, 2 * 1024 * 1024 * 1024, 0, 2, 0) == 128 * 1024 * 1024)
    assert(xproc_budget(2 * 1024 * 1024 * 1024, 3 * 1024 * 1024 * 1024, 192 * 1024 * 1024, 0, 2, 0) == 192 * 1024 * 1024)
    assert(xproc_budget(2 * 1024 * 1024 * 1024, 0, 0, 768 * 1024 * 1024, 2, 1) == 768 * 1024 * 1024)
    assert(xproc_budget(2 * 1024 * 1024 * 1024, 0, 0, 2 * 1024 * 1024 * 1024, 2, 1) == 1024 * 1024 * 1024)
    assert(xproc_budget(2 * 1024 * 1024 * 1024, 0, 0, -1, 2, 1) == 0)
    assert(xproc_budget_limit(-1) == 256 * 1024 * 1024)
    assert(xproc_budget_limit(9) == 256 * 1024 * 1024)
    assert(xproc_budget_label(32 * 1024 * 1024) == "32 MiB")
    assert(xproc_budget_label(512 * 1024) == "524288 bytes")
    assert(xproc_bytes(1024 * 1024 * 1024) == "1.0 GiB")
    assert(xproc_result_state(0) == 10)
    assert(xproc_result_state(1) == 11)
    assert(xproc_result_state(2) == 12)
    assert(xproc_result_state(3) == 13)
    assert(xproc_result_state(4) == 14)
    assert(xproc_result_state(7) == 17)
    assert(xproc_result_state(8) == 18)
    assert(xproc_result_state(9) == 19)
    assert(xproc_result_state(10) == 20)
    assert(xproc_result_state(11) == 24)
    assert(xproc_result_state(12) == 25)
    assert(xproc_result_state(-2) == 19)
    assert(xproc_result_name(21) == "confirmation-cancelled")
    assert(xproc_result_name(22) == "sample-unavailable")
    assert(xproc_result_name(23) == "busy")
    assert(xproc_result_name(24) == "authorization-cancelled")
    assert(xproc_result_name(25) == "authorization-failed")

fn test_xproc_budget_limit_text_names_the_limiting_measure():
    assert(xproc_budget_limit_text(false, 2 * 1024 * 1024 * 1024, 3 * 1024 * 1024 * 1024, 192 * 1024 * 1024, 0, 2, 0) == "cap: private resident")
    assert(xproc_budget_limit_text(true, 2 * 1024 * 1024 * 1024, 3 * 1024 * 1024 * 1024, 192 * 1024 * 1024, 0, 2, 0) == "限幅：私有驻留估算")
    assert(xproc_budget_limit_text(false, 2 * 1024 * 1024 * 1024, 128 * 1024 * 1024, 2 * 1024 * 1024 * 1024, 0, 2, 0) == "cap: RSS")
    assert(xproc_budget_limit_text(false, 2 * 1024 * 1024 * 1024, 3 * 1024 * 1024 * 1024, 2 * 1024 * 1024 * 1024, 768 * 1024 * 1024, 2, 1) == "cap: app-scope charge")
    assert(xproc_selection_scope_text(false, 0) == "PAGEOUT selects present, exclusive private pages only.")
    assert(xproc_selection_scope_text(true, 0) == "PAGEOUT 只选择已驻留且独占映射的私有页。")
    assert(xproc_selection_scope_text(false, 1) == "memory.reclaim is bounded to this exact app scope.")
    assert(xproc_selection_scope_text(true, 1) == "memory.reclaim 限定在此应用作用域内。")
    assert(xproc_mib_compact(-1) == "—")
    assert(xproc_mib_compact(1572864) == "1.5")

fn test_xproc_confirmation_displays_the_selected_start_time():
    assert(xproc_confirmation_start_time(false, 44158696) == "Start time: 44158696")
    assert(xproc_confirmation_start_time(true, 44158696) == "启动时间：44158696")

fn test_xproc_candidate_process_state_text_is_explicit():
    assert(xproc_candidate_state_text(false, 82) == "running")
    assert(xproc_candidate_state_text(false, 83) == "sleeping")
    assert(xproc_candidate_state_text(false, 68) == "disk sleep")
    assert(xproc_candidate_state_text(false, 84) == "stopped")
    assert(xproc_candidate_state_text(false, 999) == "unknown")
    assert(xproc_candidate_state_text(true, 83) == "休眠中")

fn test_xproc_simulation_never_claims_a_kernel_result():
    assert(xproc_result_text(false, 10, false, 0) == "Kernel accepted the helper-selected request.")
    assert(xproc_result_text(false, 11, false, 0) == "Kernel accepted only part of the helper-selected request.")
    assert(xproc_result_text(false, 10, true, 0) == "Simulation: helper accepted its selected request.")
    assert(xproc_result_text(false, 11, true, 0) == "Simulation: helper accepted only part of its request.")
    assert(xproc_result_text(true, 11, true, 0) == "模拟：helper 只接受了部分请求。")
    assert(xproc_result_text(true, 10, false, 0) == "内核已接受 helper 实际选定的请求。")
    assert(xproc_result_text(false, 13, true, 0) == "Simulation: the mock helper reported a permission denial.")
    assert(xproc_advised_bytes_label(false, true) == "Mock bytes advised:")
    assert(xproc_advised_bytes_label(false, false) == "Bytes advised:")
    assert(xproc_helper_calls_label(false, true) == "Mock helper calls:")
    assert(xproc_helper_calls_label(false, false) == "Helper calls:")

fn test_xproc_exit_detail_keeps_pkexec_outcome_codes_distinct():
    assert(xproc_exit_detail(false, 126, 0) == "pkexec exit 126: authorization was dismissed.")
    assert(xproc_exit_detail(false, 127, 0) == "pkexec exit 127: authorization or launch failed.")
    assert(xproc_exit_detail(false, -1, 15) == "pkexec child ended by signal 15; result is unknown.")
    assert(xproc_exit_detail(false, -1, 0) == "")

fn test_xproc_cancellation_is_reported_as_uncertain():
    assert(xproc_result_state(13) == 27)
    assert(xproc_result_name(27) == "cancelled-outcome-uncertain")
    assert(xproc_result_text(false, 27, false, 0) == "The request was stopped, but authorization may already have started the helper; the result is unknown. Do not retry automatically.")
    assert(xproc_result_text(true, 27, false, 0) == "已请求停止，但授权可能已启动 helper；结果不确定，不会自动重试。")
    assert(xproc_result_text(false, 27, true, 0) == "Simulation: the mock request was cancelled; no helper or kernel action ran.")
    assert(xproc_result_text(true, 27, true, 0) == "模拟：测试请求已取消；未运行 helper 或内核操作。")

fn test_clean_operation_results_preserve_distinct_feedback():
    assert(clean_operation_busy(2))
    assert(clean_operation_busy(3))
    assert(clean_operation_busy(9))
    assert(clean_operation_busy(11))
    assert(not clean_operation_busy(0))
    assert(clean_result_state(0) == 4)
    assert(clean_result_state(1) == 6)
    assert(clean_result_state(2) == 7)
    assert(clean_result_state(3) == 8)
    assert(clean_result_state(4) == 8)
    assert(clean_result_state(5) == 10)
    assert(clean_result_state(6) == 10)
    assert(clean_result_state(7) == 10)
    assert(clean_result_state(-2) == 10)
    assert(clean_start_failure_state(1) == 11)
    assert(clean_start_failure_state(2) == 7)
    assert(clean_result_name(12) == "not-started-sample-unavailable")
    assert(not clean_simulation_can_start(11))
    assert(clean_simulation_can_start(0))
    assert(not clean_simulation_can_start(1))
    assert(not clean_simulation_can_start(2))
    assert(not clean_simulation_can_start(3))

fn test_clean_operation_result_labels_are_explicit_and_localized():
    assert(clean_result_status(false, 4) == "Simulation complete; no system changes")
    assert(clean_result_status(true, 4) == "模拟完成；未更改系统")
    assert(clean_result_status(false, 5) == "Confirmation cancelled")
    assert(clean_result_status(true, 5) == "已取消确认")
    assert(clean_result_status(false, 6) == "Authorization or execution not confirmed")
    assert(clean_result_status(false, 8) == "The helper reported failure")
    assert(clean_result_status(false, 10) == "Result is uncertain; do not retry automatically")
    assert(clean_result_status(true, 10) == "结果不确定；不会自动重试")
    assert(clean_result_status(false, 12) == "Memory sample unavailable; simulation was not started")
    assert(clean_result_name(4) == "accepted")
    assert(clean_result_name(5) == "confirmation-cancelled")
    assert(clean_result_name(6) == "authorization-unconfirmed")
    assert(clean_result_name(7) == "authorization-failed")
    assert(clean_result_name(8) == "execution-failed")
    assert(clean_result_name(10) == "uncertain")
    # Simulation wording never appears on the production path, and vice versa.
    assert(clean_progress_status(true, false, 2) == "Waiting for simulated authorization")
    assert(clean_progress_status(true, true, 2) == "正在等待模拟授权")
    assert(clean_progress_status(true, false, 9) == "Mock helper running")
    assert(clean_progress_status(true, true, 9) == "模拟 helper 正在运行")
    assert(clean_progress_status(false, false, 2) == "Waiting for authorization")
    assert(clean_progress_status(false, true, 2) == "正在等待授权")
    assert(clean_progress_status(false, false, 9) == "Reclaim helper running")
    assert(clean_progress_status(false, true, 3) == "授权已接受；helper 正在运行")
    # Success wording must not promise a byte count the kernel never reported.
    assert(clean_result_status_for(true, false, 4) == "Simulation complete; no system changes")
    assert(clean_result_status_for(false, false, 4) == "Kernel accepted the page cache reclaim request")
    assert(clean_result_status_for(false, true, 4) == "内核已接受页缓存回收请求")
    assert(clean_result_status_for(false, false, 8) == clean_result_status(false, 8))

fn suppress_ci_resample(test_mode: bool, failure_latched: bool) -> bool:
    test_mode and failure_latched

fn refresh(s: &mut MainWindow):
    # Keep the test-only injected failure visible until the bounded CI process
    # exits. Production sampling and recovery behavior are unchanged.
    if suppress_ci_resample(s.test_mode, s.ci_sample_failure_latched): return
    let snapshot = sample_for_ui(s) catch e:
        s.sample_ok = false
        s.mem_total = 0
        s.mem_available = 0
        s.swap_total = 0
        s.swap_free = 0
        s.page_cache_estimate = 0
        s.status = label(s.zh, "Cannot read /proc/meminfo", "无法读取 /proc/meminfo")
        if s.test_mode: mr_runtime_emit(f"CI_MEMORY_ERROR {e}")
        s.canvas.redraw()
        if s.test_mode: mr_runtime_emit("CI_MEMORY_INVALIDATED redraw_requested=true")
        return
    s.mem_total = snapshot.total
    s.mem_available = snapshot.available
    s.swap_total = snapshot.swap_total
    s.swap_free = snapshot.swap_free
    s.page_cache_estimate = snapshot.page_cache
    s.sample_ok = true
    s.sample_failure_draw_logged = false
    if s.test_mode:
        mr_runtime_emit(f"CI_MEMORY source=/proc/meminfo MemTotal={snapshot.total} MemAvailable={snapshot.available} CachedPageCache={snapshot.page_cache} SReclaimableSlab={snapshot.reclaimable_slab} SwapTotal={snapshot.swap_total} SwapFree={snapshot.swap_free}")
    s.canvas.redraw()

fn finish_clean_simulation(s: &mut MainWindow, bridge_result: i64):
    let state = clean_result_state(bridge_result)
    s.clean_state = state
    s.status = clean_result_status_for(s.clean_simulation, s.zh, state)
    let source = if s.clean_simulation: "mock-helper" else: "pkexec-helper"
    let marker = if s.clean_simulation: "CI_CLEAN_SIM" else: "CI_CLEAN"
    if state == 4:
        if not s.clean_simulation:
            if s.test_mode: mr_runtime_emit(f"CI_CLEAN result=accepted source={source} kernel_accepted=true bytes_measured=false")
            refresh(s)
            return
        let after = memory.sample() catch e:
            if s.test_mode: mr_runtime_emit(f"CI_CLEAN_SIM result=accepted source={source} after_sample=unavailable error={e} no_system_write=true")
            s.canvas.redraw()
            return
        let delta = after.available - s.clean_before_available
        if s.test_mode: mr_runtime_emit(f"CI_CLEAN_SIM result=accepted source={source} observed_memavailable_before_kib={s.clean_before_available} observed_memavailable_after_kib={after.available} observed_delta_kib={delta} causal_attribution=none no_system_write=true")
    elif s.test_mode:
        mr_runtime_emit(f"{marker} result={clean_result_name(state)} result_state={state} source={source} automatic_retry=false no_system_write=true")
    s.canvas.redraw()

fn sample_for_ui(s: &mut MainWindow) -> memory.Snapshot!string:
    if s.test_mode and mr_runtime_consume_sample_failure_trigger() != 0:
        s.ci_sample_failure_latched = true
        mr_runtime_emit("CI_SAMPLE_FAILURE_TRIGGER consumed=1 source=private-trigger-file")
        fail "injected non-privileged CI sample failure"
    memory.sample()?

fn set_settings_open(s: &mut MainWindow, open: bool):
    if s.settings_open == open: return
    let mode = if open: 1 else: 0
    let changed = mr_gui_window_mode(mode)
    if changed == 0 or (open and mr_gui_settings_window_exists() == 0):
        s.status = label(s.zh, "Could not open the settings window", "无法打开设置窗口")
        if s.test_mode: mr_runtime_emit(f"CI_SETTINGS_WINDOW mode={mode} action=failed")
        return
    s.settings_open = open
    s.popup = 0
    s.menu = 0
    s.pressed = 0.0
    if open:
        s.settings = settings_ui.initial(s.test_mode)
        s.settings.status = preferences_load_feedback(s.zh, s.preferences_load_status)
        let widget_preview = mr_runtime_widget_preview_resource()
        if widget_preview != 0:
            settings_ui.enable_widget_preview_checkbox(&mut s.settings, widget_preview)
        s.settings_canvas.redraw()
        if s.test_mode:
            mr_runtime_emit(f"CI_SETTINGS_WINDOW mode=settings visible=true native_toplevel=true close_handler={mr_gui_settings_close_handler_connected() != 0} resource=IDD_SETTINGS_*:260x168_dlu shell={ui_geometry.settings_window_width_px()}x{ui_geometry.settings_window_height_px()}_provisional")
    else:
        s.status = preferences_load_feedback(s.zh, s.preferences_load_status)
        if s.test_mode: mr_runtime_emit("CI_SETTINGS_WINDOW mode=main settings_hidden=true")
    s.canvas.redraw()

fn close_window(s: &mut MainWindow):
    if xproc_operation_busy(s):
        if s.test_mode: mr_runtime_emit("CI_WINDOW_CLOSE requested_cancel=true")
        xproc_request_cancel(s)
        s.canvas.redraw()
        return
    if clean_operation_busy(s.clean_state):
        s.status = label(s.zh, "Wait for the current memory operation to finish before closing.", "请等待当前内存操作完成后再关闭。")
        if s.test_mode: mr_runtime_emit("CI_WINDOW_CLOSE blocked=operation-running helper_not_signaled=true")
        s.canvas.redraw()
        return
    if s.test_mode: mr_runtime_emit("CI_WINDOW_CLOSE")
    if s.settings_open: set_settings_open(s, false)
    ui.quit()

fn tick(s: &mut MainWindow):
    s.elapsed_ms += 1000
    if mr_gui_take_main_close_request() != 0:
        if s.test_mode: mr_runtime_emit("CI_MAIN_CLOSE_REQUEST source=delete_event")
        close_window(s)
    if mr_gui_take_settings_close_request() != 0:
        if s.test_mode: mr_runtime_emit("CI_SETTINGS_CLOSE_REQUEST source=delete_event")
        set_settings_open(s, false)
        if s.test_mode: mr_runtime_emit("CI_SETTINGS_CLOSE_REQUEST_HANDLED main_visible=true")
    if clean_operation_busy(s.clean_state):
        let mock_stage = if s.clean_simulation: mr_runtime_mock_stage() else: 0
        let bridge_result = mr_poll_reclaim()
        if bridge_result != -1:
            finish_clean_simulation(s, bridge_result)
        elif mock_stage == 1 and s.clean_state == 2:
            s.clean_state = 3
            s.status = clean_progress_status(s.clean_simulation, s.zh, 3)
            if s.test_mode: mr_runtime_emit("CI_CLEAN_SIM stage=authorization-accepted backend=mock no_privilege_request=true")
            s.canvas.redraw()
        elif mock_stage == 2 and s.clean_state != 9:
            s.clean_state = 9
            s.status = clean_progress_status(s.clean_simulation, s.zh, 9)
            if s.test_mode: mr_runtime_emit("CI_CLEAN_SIM stage=helper-running helper=mock no_system_write=true")
            s.canvas.redraw()
    if xproc_operation_busy(s):
        let result = if s.xproc_simulation: mr_runtime_xproc_poll() else: mr_xproc_poll()
        if result >= 0 or result < -1:
            xproc_finish(s, result)
        elif s.xproc_simulation and mr_runtime_xproc_stage() >= 2 and s.xproc_state == 2:
            s.xproc_state = 3
            s.status = xproc_waiting_text(s.zh, s.xproc_state, true)
            if s.test_mode: mr_runtime_emit("CI_XPROC_SIM stage=mock-helper-running authorization_simulated=true helper=mock no_syscall=true")
            s.canvas.redraw()
    if s.test_mode and mr_runtime_sample_failure_requested() != 0:
        refresh(s)
    elif s.elapsed_ms % 3000 == 0:
        refresh(s)
    if not s.test_mode or s.test_timeout_ms <= 0: return
    if s.elapsed_ms >= s.test_timeout_ms:
        mr_runtime_emit("CI_QUIT source=bounded_test_timer")
        ui.quit()

fn settings_scroll_tick(s: &mut MainWindow):
    if not s.settings_open: return
    let delta = mr_gui_take_settings_scroll_steps()
    if delta == 0: return
    let x = f64(mr_gui_settings_scroll_x())
    let y = f64(mr_gui_settings_scroll_y())
    let changed = settings_ui.scroll(&mut s.settings, x, y, f64(ui_geometry.settings_client_width_px()), f64(ui_geometry.settings_client_height_px()), delta)
    if s.test_mode: mr_runtime_emit(f"CI_SETTINGS_SCROLL_DISPATCH x={x} y={y} delta={delta} changed={changed}")
    if changed: s.settings_canvas.redraw()

fn open_clean_menu(s: &mut MainWindow, source: string):
    s.popup = 2
    s.menu = 0
    s.focus = 4.0
    s.menu_focus = 500.0
    # Build the plan before drawing the rows so the balanced entry can say
    # whether there is anything worth doing instead of offering a dead action.
    bal_refresh(s)
    s.status = label(s.zh, "Choose a memory action", "请选择内存操作")
    if s.test_mode:
        mr_runtime_emit(f"CI_CLEAN_MENU open=true source={source} default_action=none")
        # Publish the button and one row rect so an external harness can click
        # them with real pointer events instead of recomputing the layout and
        # silently missing. The rows come from the same geometry function the
        # drawing code uses.
        let popup = clean_popup_rect(s)
        let row9 = ui_geometry.clean_menu_item_rect(&popup, 9)
        mr_runtime_emit(f"CI_BALANCED_ROW x={row9.x} y={row9.y} w={row9.w} h={row9.h}")
    log_popup(s, "clean", &clean_popup_rect(s))

fn activate(s: &mut MainWindow, target: f64):
    if s.xproc_view == 1:
        if target >= 900.0 and target < 932.0:
            xproc_set_selected(s, i64(target - 900.0))
            s.xproc_focus = 0
        elif target == 810.0:
            xproc_scan(s)
        elif target == 811.0 and s.xproc_selected >= 0:
            let verify_status = xproc_snapshot_verify(s)
            if verify_status != 0:
                xproc_local_failure(s, 26)
                if s.test_mode: mr_runtime_emit(f"CI_XPROC_CONFIRM rejected=true request_id={s.xproc_request_id} status={verify_status} pid={s.xproc_target_pid} helper_calls=0 authorization_started=false")
            elif xproc_audit_confirmation(s) != 0:
                xproc_local_failure(s, 26)
                if s.test_mode: mr_runtime_emit(f"CI_XPROC_CONFIRM rejected=true request_id={s.xproc_request_id} reason=audit-invalid helper_calls=0 authorization_started=false")
            else:
                s.xproc_view = 2
                s.xproc_focus = 5
                if s.test_mode: mr_runtime_emit(f"CI_XPROC_AUDIT phase=confirmation request_id={s.xproc_request_id} pid={s.xproc_target_pid} uid={s.xproc_target_uid} start_time={s.xproc_target_start_time} scope_hash={s.xproc_target_scope_hash} identity_hash={s.xproc_target_identity_token} region_digest={s.xproc_target_region_digest}")
                if s.test_mode: mr_runtime_emit(f"CI_XPROC_CONFIRM open=true request_id={s.xproc_request_id} pid={s.xproc_target_pid} uid={s.xproc_target_uid} start_time={s.xproc_target_start_time} identity_hash={s.xproc_target_identity_token} scope_hash={s.xproc_target_scope_hash} region_digest={s.xproc_target_region_digest} application={s.xproc_target_app_name} mode={s.xproc_mode_choice} budget_limit_bytes={xproc_budget_limit(s.xproc_budget_choice)} max_bytes={xproc_budget(s.xproc_target_bytes, s.xproc_target_rss_bytes, s.xproc_target_private_resident_bytes, s.xproc_target_scope_bytes, s.xproc_budget_choice, s.xproc_mode_choice)} process_rss_bytes={s.xproc_target_rss_bytes} private_resident_bytes={s.xproc_target_private_resident_bytes} scope_anon_file_bytes={s.xproc_target_scope_bytes} regions={s.xproc_target_regions} explicit_user_choice=true immutable_snapshot=true")
                if s.test_mode and s.xproc_mode_choice == 0: mr_runtime_emit(f"CI_XPROC_CONFIRM_LIMIT cap_reason={xproc_budget_limit_text(s.zh, s.xproc_target_bytes, s.xproc_target_rss_bytes, s.xproc_target_private_resident_bytes, s.xproc_target_scope_bytes, s.xproc_budget_choice, s.xproc_mode_choice)} private_resident_bytes={s.xproc_target_private_resident_bytes}")
        elif target == 812.0:
            s.xproc_view = 0
            s.status = label(s.zh, "Target selection cancelled", "已取消目标选择")
            if s.test_mode: mr_runtime_emit("CI_XPROC_PICKER open=false cancelled=true request_started=false")
        s.canvas.redraw()
        return
    elif s.xproc_view == 2:
        if target == 820.0:
            xproc_start_selected(s)
        elif target == 821.0:
            xproc_confirm_cancel(s)
        elif target >= 822.0 and target < 825.0:
            let choice = i64(target - 822.0)
            choose_xproc_budget(s, choice)
            s.xproc_focus = choice
        elif target >= 825.0 and target < 827.0:
            let mode = i64(target - 825.0)
            choose_xproc_mode(s, mode)
            s.xproc_focus = 3 + mode
        s.canvas.redraw()
        return
    elif s.xproc_view == 3:
        if target == 841.0: xproc_request_cancel(s)
        s.canvas.redraw()
        return
    elif s.xproc_view == 4:
        if target == 840.0:
            s.xproc_view = 0
            s.status = ""
            if s.test_mode: mr_runtime_emit("CI_XPROC_RESULT closed=true")
        s.canvas.redraw()
        return

    if target == 1.0 or target == 2.0 or target == 3.0 or target == 4.0:
        let selected = i64(target)
        if s.menu == selected and s.popup == 1:
            s.popup = 0
            s.menu = 0
        else:
            s.menu = selected
            s.popup = 1
            s.focus = f64(selected - 1)
            s.menu_focus = first_root_menu_target(selected)
        if s.test_mode: mr_runtime_emit(f"CI_MENU root={s.menu} open={s.popup == 1}")
        if s.popup == 1: log_popup(s, "root", &menu_rect(s))
    elif target == 20.0:
        open_clean_menu(s, "arrow")
    elif target == 19.0:
        # The whole control opens the action menu. Page cache remains an
        # explicit menu choice so the generic button cannot misroute a user
        # who intends to select a process.
        open_clean_menu(s, "button-body")
    elif target == 710.0 and s.clean_state == 1:
        if not s.sample_ok:
            s.clean_state = 12
            s.status = clean_result_status(s.zh, 12)
            if s.test_mode: mr_runtime_emit("CI_CLEAN_SIM result=not-started-sample-unavailable mock_helper_called=false no_system_write=true")
        else:
            s.clean_before_available = s.mem_available
            let start_result = if s.clean_simulation: mr_runtime_clean_simulation_start(0) else: mr_start_reclaim(0)
            if start_result == 0:
                s.clean_state = 2
                s.status = clean_progress_status(s.clean_simulation, s.zh, 2)
                let backend = if s.clean_simulation: "mock" else: "pkexec"
                let marker = if s.clean_simulation: "CI_CLEAN_SIM" else: "CI_CLEAN"
                if s.test_mode: mr_runtime_emit(f"{marker} stage=confirmed observed_memavailable_before_kib={s.clean_before_available} source=/proc/meminfo backend={backend} started=true")
            else:
                s.clean_state = clean_start_failure_state(start_result)
                s.status = clean_result_status(s.zh, s.clean_state)
                if s.test_mode: mr_runtime_emit(f"CI_CLEAN result=start-failed start_state={start_result} automatic_retry=false")
    elif target == 711.0 and s.clean_state == 1:
        s.clean_state = 5
        s.status = clean_result_status(s.zh, 5)
        if s.test_mode:
            let cancel_backend = if s.clean_simulation: "mock" else: "pkexec"
            let cancel_marker = if s.clean_simulation: "CI_CLEAN_SIM" else: "CI_CLEAN"
            let cancel_note = if s.clean_simulation: " no_system_write=true" else: ""
            mr_runtime_emit(f"{cancel_marker} result=confirmation-cancelled stage=confirmation backend={cancel_backend} helper_called=false{cancel_note}")
    elif target >= 30.0 and target < 33.0:
        let group = i64(target - 30.0)
        s.collapsed_groups = ui_geometry.toggle_group_collapse(s.collapsed_groups, group)
        if s.test_mode: mr_runtime_emit(f"CI_GROUP_COLLAPSE group={group} collapsed={ui_geometry.group_is_collapsed(s.collapsed_groups, group)}")
    elif target >= 40.0 and target < 43.0:
        s.selected_group = i64(target - 40.0)
        if s.test_mode: mr_runtime_emit(f"CI_GROUP_SELECT group={s.selected_group} selected=true")
    elif target == 101.0:
        set_settings_open(s, true)
    elif target == 102.0:
        if s.test_mode: mr_runtime_emit("CI_EXIT source=file_menu")
        ui.quit()
    elif target == 201.0 or target == 203.0:
        s.status = label(s.zh, "This Windows setting is not available yet", "此原版设置尚未实现")
        s.popup = 0
    elif target == 202.0:
        let next_theme = if s.dark: 0 else: 1
        s.popup = 0
        persist_theme(s, next_theme)
        if s.test_mode: mr_runtime_emit(f"CI_THEME dark={s.dark}")
    elif target == 204.0:
        s.popup = 3
        s.menu_focus = 601.0
        if s.test_mode: mr_runtime_emit("CI_LANGUAGE_MENU open=true")
        log_popup(s, "language", &language_rect(s))
    elif target == 301.0 or target == 302.0 or target == 303.0 or target == 304.0:
        s.status = label(s.zh, "This startup/update action is not implemented", "启动或更新操作尚未实现")
        s.popup = 0
    elif target == 401.0 or target == 402.0 or target == 403.0:
        s.status = label(s.zh, "This help action is not implemented", "帮助操作尚未实现")
        s.popup = 0
    elif target == 601.0:
        s.popup = 0
        s.menu = 0
        persist_language(s, 0)
        if s.test_mode: mr_runtime_emit("CI_LOCALE locale=en")
    elif target == 602.0:
        s.popup = 0
        s.menu = 0
        persist_language(s, 1)
        if s.test_mode: mr_runtime_emit("CI_LOCALE locale=zh-CN")
    elif target >= 500.0 and target < 500.0 + f64(ui_geometry.CLEAN_MENU_ROWS):
        let index = i64(target - 500.0)
        s.popup = 0
        if index == 0:
            if clean_self_can_start(s.clean_state):
                if s.test_mode: mr_runtime_emit("CI_CLEAN_SELF_MENU action=self-trim target=self only")
                run_self_reclaim(s)
            else:
                s.status = clean_result_status(s.zh, s.clean_state)
                if s.test_mode: mr_runtime_emit("CI_CLEAN_SELF_MENU action=skipped reason=busy")
        elif index == 1:
            if (s.clean_simulation or (s.clean_production and s.main_close_guard_ready)) and clean_simulation_can_start(s.clean_state):
                s.clean_state = 1
                s.clean_confirm_focus = 0
                s.status = ""
                if s.test_mode:
                    let confirm_mode = if s.clean_simulation: "simulation" else: "production"
                    mr_runtime_emit(f"CI_CLEAN_CONFIRM open=true mode={confirm_mode}")
            else:
                s.status = label(s.zh, "Memory cleaning is disabled because safe window-close handling or an approved action is unavailable.", "安全窗口关闭保护或已批准的清理功能不可用，内存清理已禁用。")
                if s.test_mode: mr_runtime_emit(f"CI_CLEAN_DISABLED action=none main_close_guard_ready={s.main_close_guard_ready}")
        elif index == 9:
            # The plan is shown before anything runs. There is no execute path in
            # this branch: the reclaim backend lands separately and the
            # integrator joins them. What this row must never do is claim a
            # result it did not produce.
            bal_refresh(s)
            let entry = bal_entry_state(s)
            s.bal_view = 1
            if entry != 2:
                s.bal_view = 0
                s.status = label(s.zh, "Balanced clean is unavailable; see the reason above the button.", "均衡清理不可用；原因见按钮上方的说明。")
                if s.test_mode: mr_runtime_emit(f"CI_BALANCED_DISABLED entry={entry} state={s.bal_state} action={s.bal_action}")
            elif s.bal_evidence == 0:
                s.bal_view = 0
                s.status = label(s.zh, "No pressure evidence yet; nothing will run.", "尚无压力证据，本次不执行。")
                if s.test_mode: mr_runtime_emit("CI_BALANCED_DISABLED entry=2 reason=no_evidence")
            elif s.bal_action == 0:
                # The planner decided there is nothing worth reclaiming. Say so;
                # do not run and then report a zero-byte success.
                s.bal_view = 0
                s.status = bal_plan_why_text(s)
                if s.test_mode: mr_runtime_emit(f"CI_BALANCED_DISABLED entry=2 reason=no_action state={s.bal_state}")
            else:
                # Pick the scope with the most file pages, not the first by name:
                # the first by name is arbitrary and may be the one the user just
                # interacted with, whose pages would come straight back.
                s.bal_scope_count = mr_bal_bridge_scan_scopes()
                s.bal_scope_index = pick_balanced_scope()
                if s.bal_scope_index < 0:
                    s.bal_view = 0
                    s.status = label(s.zh, "No application scope has reclaimable file pages.", "没有应用作用域存在可回收文件页。")
                    if s.test_mode: mr_runtime_emit(f"CI_BALANCED_DISABLED entry=2 reason=no_scope scanned={s.bal_scope_count}")
                elif bal_run_selected(s):
                    s.bal_view = 1
                    s.status = mr_bal_bridge_result_headline(if s.zh: 1 else: 0)
                    if s.test_mode: mr_runtime_emit(f"CI_BALANCED_PLAN state={s.bal_state} action={s.bal_action} request_bytes={s.bal_request_bytes} executed=true")
                else:
                    s.bal_view = 0
        elif index == 8:
            if clean_operation_busy(s.clean_state):
                s.status = label(s.zh, "Wait for the current memory operation to finish.", "请等待当前内存操作完成。")
            elif xproc_available(s):
                if s.test_mode: mr_runtime_emit("CI_CLEAN_ACTION index=8 action=selected-process")
                xproc_scan(s)
            else:
                if s.main_close_guard_ready:
                    s.status = label(s.zh, "Cross-process reclaim is not built into this version.", "此版本未编译跨进程回收功能。")
                else:
                    s.status = label(s.zh, "Cross-process reclaim is unavailable because safe window-close handling is missing.", "缺少安全的窗口关闭保护，跨进程回收当前不可用。")
                if s.test_mode: mr_runtime_emit(f"CI_XPROC_DISABLED action=none main_close_guard_ready={s.main_close_guard_ready}")
        else:
            s.status = label(s.zh, "This Windows cleanup API has no approved Linux equivalent", "该 Windows 清理接口没有已批准的 Linux 等价操作")
            if s.test_mode: mr_runtime_emit(f"CI_CLEAN_REGION_DISABLED index={index} action=none")
    s.canvas.redraw()
    if settings_canvas_needs_redraw(s.settings_open, target):
        s.settings_canvas.redraw()

fn move_menu_focus(s: &mut MainWindow, direction: i64):
    let mut first = 0.0
    let mut last = 0.0
    if s.popup == 2:
        first = 500.0
        last = 500.0 + f64(ui_geometry.CLEAN_MENU_ROWS) - 1.0
    elif s.popup == 3:
        first = 601.0
        last = 602.0
    elif s.popup == 1:
        let row_count = ui_geometry.root_menu_row_count(s.menu)
        let mut current_row = -1
        for row in 0..row_count:
            if root_menu_target(s.menu, row) == s.menu_focus: current_row = row
        if current_row < 0:
            s.menu_focus = first_root_menu_target(s.menu)
            return
        for _ in 0..row_count:
            current_row += direction
            if current_row < 0: current_row = row_count - 1
            if current_row >= row_count: current_row = 0
            let candidate = root_menu_target(s.menu, current_row)
            if candidate != 0.0:
                s.menu_focus = candidate
                return
    if first == 0.0: return
    if s.menu_focus < first or s.menu_focus > last:
        if direction > 0: s.menu_focus = first
        else: s.menu_focus = last
    elif direction > 0:
        s.menu_focus += 1.0
        if s.menu_focus > last: s.menu_focus = first
    else:
        s.menu_focus -= 1.0
        if s.menu_focus < first: s.menu_focus = last

fn move_xproc_focus(s: &mut MainWindow):
    if s.xproc_view == 1:
        s.xproc_focus += 1
        if s.xproc_focus > 3: s.xproc_focus = 0
    elif s.xproc_view == 2:
        s.xproc_focus += 1
        if s.xproc_focus > 6: s.xproc_focus = 0

fn move_xproc_selection(s: &mut MainWindow, direction: i64):
    let count = xproc_count(s)
    if count <= 0: return
    let mut index = s.xproc_selected
    if index < 0:
        index = if direction > 0: 0 else: count - 1
    else:
        index += direction
        if index < 0: index = 0
        if index >= count: index = count - 1
    xproc_set_selected(s, index)

fn mouse(s: &mut MainWindow, event: &ui.Mouse):
    let target = hit(s, event.x(), event.y())
    let old_hover = s.hover
    s.hover = target
    if event.down() == 1:
        s.pressed = target
        if target >= 1.0 and target <= 4.0: s.focus = target - 1.0
        if s.test_mode: mr_runtime_emit(f"CI_MOUSE_DOWN target={target}")
        s.canvas.redraw()
    elif event.up() == 1:
        let was_pressed = s.pressed
        s.pressed = 0.0
        if s.test_mode: mr_runtime_emit(f"CI_MOUSE_UP target={target}")
        if was_pressed != 0.0 and was_pressed == target:
            if s.test_mode: mr_runtime_emit(f"CI_MOUSE_ACTION target={target}")
            activate(s, target)
        else:
            if s.test_mode: mr_runtime_emit("CI_MOUSE_ACTION target=none")
        s.canvas.redraw()
    elif old_hover != target:
        if s.test_mode and target != 0.0: mr_runtime_emit(f"CI_MOUSE_HOVER target={target}")
        s.canvas.redraw()

fn key(s: &mut MainWindow, event: &ui.Key):
    if event.released(): return
    let name = event.name()
    if s.test_mode: mr_runtime_emit(f"CI_KEY name={name}")
    if s.xproc_view != 0:
        if s.xproc_view == 1:
            if name == "Escape" or name == "Esc" or name == "\x1b":
                s.xproc_view = 0
                s.status = label(s.zh, "Target selection cancelled", "已取消目标选择")
                if s.test_mode: mr_runtime_emit("CI_XPROC_PICKER open=false cancelled=true request_started=false")
            elif name == "Tab" or name == "\t":
                move_xproc_focus(s)
            elif name == "Down" or name == "Up":
                if s.xproc_focus == 0:
                    move_xproc_selection(s, if name == "Down": 1 else: -1)
                else:
                    move_xproc_focus(s)
            elif name == "Page_Down" or name == "Next":
                move_xproc_selection(s, 4)
            elif name == "Page_Up" or name == "Prior":
                move_xproc_selection(s, -4)
            elif name == "space" or name == " ":
                move_xproc_selection(s, 1)
            elif name == "Enter" or name == "Return" or name == "\r" or name == "\n":
                if s.xproc_focus == 0:
                    if s.xproc_selected < 0: move_xproc_selection(s, 1)
                    else: activate(s, 811.0)
                elif s.xproc_focus == 1: activate(s, 810.0)
                elif s.xproc_focus == 2: activate(s, 811.0)
                else: activate(s, 812.0)
        elif s.xproc_view == 2:
            if name == "Escape" or name == "Esc" or name == "\x1b":
                xproc_confirm_cancel(s)
            elif name == "Tab" or name == "\t":
                move_xproc_focus(s)
            elif (name == "Left" or name == "Right") and s.xproc_focus < 3:
                let direction = if name == "Right": 1 else: -1
                let next = max(0, min(2, s.xproc_budget_choice + direction))
                choose_xproc_budget(s, next)
                s.xproc_focus = next
            elif (name == "Left" or name == "Right") and s.xproc_focus >= 3 and s.xproc_focus < 5:
                choose_xproc_mode(s, 1 - s.xproc_mode_choice)
                s.xproc_focus = 3 + s.xproc_mode_choice
            elif name == "space" or name == " ":
                if s.xproc_focus < 3: choose_xproc_budget(s, s.xproc_focus)
                elif s.xproc_focus < 5: choose_xproc_mode(s, s.xproc_focus - 3)
                elif s.xproc_focus == 5: activate(s, 820.0)
                else: activate(s, 821.0)
            elif name == "Enter" or name == "Return" or name == "\r" or name == "\n":
                if s.xproc_focus < 3: choose_xproc_budget(s, s.xproc_focus)
                elif s.xproc_focus < 5: choose_xproc_mode(s, s.xproc_focus - 3)
                else: activate(s, if s.xproc_focus == 5: 820.0 else: 821.0)
        elif s.xproc_view == 3:
            if name == "Escape" or name == "Esc" or name == "\x1b":
                xproc_request_cancel(s)
            elif name == "Tab":
                s.xproc_focus = 1
            elif name == "space" or name == " " or name == "Enter" or name == "Return" or name == "\r" or name == "\n":
                xproc_request_cancel(s)
        elif s.xproc_view == 4 and (name == "Escape" or name == "Esc" or name == "\x1b" or name == "Enter" or name == "Return"):
            activate(s, 840.0)
        s.canvas.redraw()
        return
    if s.clean_state == 1:
        if name == "Escape" or name == "Esc" or name == "\x1b":
            activate(s, 711.0)
        elif name == "Tab" or name == "\t":
            s.clean_confirm_focus = 1 - s.clean_confirm_focus
            if s.test_mode:
                let choice = if s.clean_confirm_focus == 0: "confirm" else: "cancel"
                mr_runtime_emit(f"CI_CLEAN_CONFIRM_FOCUS choice={choice}")
        elif name == "Enter" or name == "Return" or name == "\r" or name == "\n":
            activate(s, if s.clean_confirm_focus == 0: 710.0 else: 711.0)
        s.canvas.redraw()
        return
    elif name == "Escape" or name == "Esc" or name == "\x1b":
        s.popup = 0
        s.menu = 0
        s.pressed = 0.0
        if s.test_mode: mr_runtime_emit(f"CI_MENU closed reason=Escape focus={s.focus}")
    elif name == "Tab" or name == "\t":
        s.focus = next_focus_index(s.focus)
        if s.test_mode: mr_runtime_emit(f"CI_FOCUS value={s.focus}")
    elif name == "F1":
        s.status = label(s.zh, "About page is not implemented yet", "关于页面尚未实现")
    elif name == "F2":
        set_settings_open(s, true)
    elif name == "Down" or name == "Up":
        if s.popup == 0:
            if s.focus < 4.0:
                if s.focus < 0.0: s.focus = 0.0
                s.menu = i64(s.focus) + 1
                s.popup = 1
                s.menu_focus = first_root_menu_target(s.menu)
            else:
                s.popup = 2
                s.menu_focus = 500.0
        else:
            if name == "Down": move_menu_focus(s, 1)
            else: move_menu_focus(s, -1)
        if s.test_mode: mr_runtime_emit(f"CI_FOCUS item={s.menu_focus}")
    elif name == "Right" or name == "Left":
        if s.popup == 1:
            if name == "Right": s.menu += 1
            else: s.menu -= 1
            if s.menu < 1: s.menu = 4
            if s.menu > 4: s.menu = 1
            s.focus = f64(s.menu - 1)
            s.menu_focus = first_root_menu_target(s.menu)
        elif s.popup == 3 and name == "Left":
            s.popup = 1
            s.menu_focus = 204.0
        else:
            if s.focus < 0.0: s.focus = 0.0
            elif name == "Right": s.focus += 1.0
            else: s.focus -= 1.0
            if s.focus < 0.0: s.focus = 4.0
            if s.focus > 4.0: s.focus = 0.0
        if s.test_mode: mr_runtime_emit(f"CI_FOCUS value={s.focus} item={s.menu_focus}")
    elif name == "Enter" or name == "Return" or name == "\r" or name == "\n":
        if s.popup != 0:
            activate(s, s.menu_focus)
        elif s.focus == 4.0:
            activate(s, 20.0)
        else:
            if s.focus < 0.0: s.focus = 0.0
            s.menu = i64(s.focus) + 1
            s.popup = 1
            s.menu_focus = first_root_menu_target(s.menu)
        if s.test_mode: mr_runtime_emit("CI_KEY_ACTION Enter")
    s.canvas.redraw()

fn draw_settings(s: &mut MainWindow, p: &ui.Painter):
    settings_ui.draw(&mut s.settings, p, s.zh, s.dark, p.width(), p.height())

fn settings_mouse(s: &mut MainWindow, event: &ui.Mouse):
    let width = f64(ui_geometry.settings_client_width_px())
    let height = f64(ui_geometry.settings_client_height_px())
    let target = settings_ui.hit(&s.settings, event.x(), event.y(), width, height)
    if event.down() == 1:
        settings_ui.pointer(&mut s.settings, target, true)
        if s.test_mode: mr_runtime_emit(f"CI_SETTINGS_MOUSE_DOWN target={target}")
        s.settings_canvas.redraw()
    elif event.up() == 1:
        let was_pressed = s.settings.pressed
        let action = settings_ui.release(&mut s.settings, target, s.zh)
        if s.test_mode: mr_runtime_emit(f"CI_SETTINGS_MOUSE_UP target={target}")
        if was_pressed != 0.0 and was_pressed == target:
            if action == 1: set_settings_open(s, false)
            elif action == 10: persist_language(s, 0)
            elif action == 11: persist_language(s, 1)
            elif action == 12: reset_preferences(s)
            if s.test_mode: mr_runtime_emit(f"CI_SETTINGS_MOUSE_ACTION target={target}")
        s.settings_canvas.redraw()
        s.canvas.redraw()
    else:
        let old_hover = s.settings.hover
        settings_ui.pointer(&mut s.settings, target, false)
        if old_hover != target:
            if s.test_mode: mr_runtime_emit(f"CI_SETTINGS_MOUSE_MOVE target={target}")
            s.settings_canvas.redraw()

fn settings_key(s: &mut MainWindow, event: &ui.Key):
    if event.released(): return
    let name = normalized_key_name(event.name())
    if s.test_mode: mr_runtime_emit(f"CI_SETTINGS_KEY_EVENT name={name}")
    let action = settings_ui.key(&mut s.settings, name, s.zh)
    if action == 1:
        set_settings_open(s, false)
    elif action == 10:
        persist_language(s, 0)
    elif action == 11:
        persist_language(s, 1)
    elif action == 12:
        reset_preferences(s)
        if s.test_mode:
            if s.zh: mr_runtime_emit("CI_LOCALE locale=zh-CN source=IDC_LANGUAGE_123")
            else: mr_runtime_emit("CI_LOCALE locale=en source=IDC_LANGUAGE_123")
    s.settings_canvas.redraw()
    s.canvas.redraw()

fn test_normalized_settings_key_names():
    assert(normalized_key_name("\t") == "Tab")
    assert(normalized_key_name("\r") == "Enter")
    assert(normalized_key_name("\x1b") == "Escape")
    assert(normalized_key_name("Page_Up") == "PageUp")
    assert(normalized_key_name("Page_Down") == "PageDown")

fn test_initial_menu_focus_is_hidden_and_tab_starts_at_file():
    assert(not menu_item_has_keyboard_focus(-1.0, 0))
    assert(next_focus_index(-1.0) == 0.0)
    assert(next_focus_index(4.0) == 0.0)

fn test_shared_theme_and_language_changes_redraw_open_settings():
    assert(settings_canvas_needs_redraw(true, 202.0))
    assert(settings_canvas_needs_redraw(true, 601.0))
    assert(settings_canvas_needs_redraw(true, 602.0))
    assert(not settings_canvas_needs_redraw(false, 202.0))
    assert(not settings_canvas_needs_redraw(false, 601.0))
    assert(not settings_canvas_needs_redraw(true, 204.0))

fn test_font_policy_name_reports_only_a_confirmed_result():
    assert(font_policy_name(0) == "unavailable")
    assert(font_policy_name(1) == "Liberation Sans")
    assert(font_policy_name(2) == "system-default")

fn main():
    let test_mode = mr_runtime_mode() != 0
    let preferences_status = mr_preferences_load()
    let mut initial_zh = false
    let mut initial_dark = false
    if preferences_status == 0 or preferences_status == 1:
        initial_zh = mr_preferences_language() == 1
        initial_dark = mr_preferences_theme() == 1
    let initial_language_value = if initial_zh: 1 else: 0
    let initial_theme_value = if initial_dark: 1 else: 0
    let width = ui_geometry.main_window_width_px()
    let height = ui_geometry.main_window_height_px()
    let window = ui.window("Mem Reduct", width, height)
    let canvas = ui.canvas()
    window.set_child(canvas)
    let settings_width = ui_geometry.settings_window_width_px()
    let settings_height = ui_geometry.settings_window_height_px()
    let settings_window = ui.window("Settings - Mem Reduct", settings_width, settings_height)
    let settings_canvas = ui.canvas()
    settings_window.set_child(settings_canvas)
    let font_policy = mr_gui_set_compat_font()
    let font_family = font_policy_name(font_policy)
    let fixed_size_policy = mr_gui_lock_window_sizes(width, height, settings_width, settings_height)
    let main_background_ready = mr_gui_set_main_background(if initial_dark: 1 else: 0)
    let clean_simulation = test_mode and mr_runtime_clean_simulation_enabled() != 0
    let xproc_simulation = test_mode and mr_runtime_xproc_simulation_enabled() != 0
    # Production cleaning is compiled in but stays inert unless the build opted in.
    let clean_production = not clean_simulation and mr_production_clean_enabled() != 0
    let test_timeout = mr_runtime_timeout_ms()
    let capture_scheduled = mr_runtime_schedule_capture()
    let initial_selected_group = mr_runtime_selected_group()
    if test_mode:
        mr_runtime_emit("CI_PRODUCTION_START")
        mr_runtime_emit(f"CI_TEST_TIMEOUT_MS={test_timeout}")
        mr_runtime_emit(f"CI_CAPTURE_SCHEDULED={capture_scheduled}")
        mr_runtime_emit(f"CI_WINDOW_SIZE_POLICY fixed={fixed_size_policy}")
        mr_runtime_emit(f"CI_FONT_POLICY result={font_policy} family={font_family} size_pt=8")
        mr_runtime_emit(f"CI_MAIN_BACKGROUND initialized={main_background_ready}")
        mr_runtime_emit(f"CI_PREFERENCES load_status={preferences_status} language={initial_language_value} theme={initial_theme_value} can_save={mr_preferences_can_save() != 0}")
        mr_runtime_emit(f"CI_CLEAN_SIM enabled={clean_simulation} mock_bridge_connected={clean_simulation} production_bridge_connected={clean_production}")
        mr_runtime_emit(f"CI_XPROC_SIM enabled={xproc_simulation} mock_bridge_connected={xproc_simulation} production_bridge_connected={not xproc_simulation and mr_xproc_enabled() != 0}")
        if initial_selected_group >= 0: mr_runtime_emit(f"CI_GROUP_SELECT group={initial_selected_group} selected=true source=test-fixture")
        mr_runtime_emit(f"CI_GEOMETRY resource=IDD_MAIN:224x214_dlu provisional_window={width}x{height}")
        mr_runtime_emit(f"CI_SETTINGS_GEOMETRY resource=IDD_SETTINGS_*:260x168_dlu provisional_shell={settings_width}x{settings_height} canvas={ui_geometry.settings_client_width_px()}x{ui_geometry.settings_client_height_px()}")
    let app: ui.App[MainWindow] = ui.app()
    if test_mode and mr_runtime_log_canvas_font() == 0:
        mr_runtime_emit("CI_GTK_FONT status=unavailable")
    app.on_draw(canvas, draw)
    app.on_mouse(canvas, mouse)
    app.on_key(canvas, key)
    app.on_draw(settings_canvas, draw_settings)
    app.on_mouse(settings_canvas, settings_mouse)
    app.on_key(settings_canvas, settings_key)
    app.on_close(close_window)
    let main_close_guard_ready = mr_gui_prepare_main_close() != 0
    if test_mode: mr_runtime_emit(f"CI_MAIN_CLOSE_GUARD ready={main_close_guard_ready}")
    app.every(1000, tick)
    app.every(50, settings_scroll_tick)
    let mut state = MainWindow(
        canvas: canvas, settings_canvas: settings_canvas, width: f64(width - 12), height: f64(height - 12),
        zh: initial_zh, dark: initial_dark, menu: 0, popup: 0, hover: 0.0, pressed: 0.0,
        focus: -1.0, menu_focus: 0.0, collapsed_groups: 0, selected_group: initial_selected_group, status: "", mem_total: 0, mem_available: 0, swap_total: 0,
        swap_free: 0, page_cache_estimate: 0, sample_ok: false, draw_logged: false,
        test_mode: test_mode, test_timeout_ms: test_timeout, elapsed_ms: 0, ci_sample_failure_latched: false, sample_failure_draw_logged: false,
        clean_simulation: clean_simulation, clean_production: clean_production,
        xproc_simulation: xproc_simulation, main_close_guard_ready: main_close_guard_ready, xproc_view: 0, xproc_state: 0, xproc_cancel_status: 0,
        xproc_selected: -1, xproc_scroll: 0, xproc_focus: 0, xproc_budget_choice: 0,
        xproc_mode_choice: 0, xproc_target_scope_bytes: -1, xproc_target_rss_bytes: -1,
        xproc_preflight: -1, xproc_scan_status: -1,
        xproc_target_pid: -1, xproc_target_start_time: -1, xproc_target_uid: -1,
        xproc_target_identity_token: -1, xproc_request_id: -1,
        xproc_target_scope_hash: -1, xproc_target_region_digest: -1,
        xproc_target_bytes: -1, xproc_target_private_resident_bytes: -1, xproc_target_regions: -1,
        xproc_target_name: "", xproc_target_app_name: "",
        xproc_before_available: -1, xproc_after_available: -1,
        xproc_advised_bytes: 0, xproc_requested_bytes: 0, xproc_regions: 0,
        xproc_error_code: 0, xproc_call_count: 0,
        xproc_target_rss_before_kib: -1, xproc_target_rss_after_kib: -1,
        xproc_target_swap_before_kib: -1, xproc_target_swap_after_kib: -1,
        xproc_scope_current_before_bytes: -1, xproc_scope_current_after_bytes: -1,
        xproc_scope_anon_before_bytes: -1, xproc_scope_anon_after_bytes: -1,
        xproc_scope_file_before_bytes: -1, xproc_scope_file_after_bytes: -1,
        xproc_scope_swap_before_bytes: -1, xproc_scope_swap_after_bytes: -1,
        clean_self: true,
        clean_state: 0, clean_confirm_focus: 0, clean_before_available: 0,
        bal_state: 0, bal_action: 0, bal_request_bytes: 0, bal_evidence: 0,
        bal_result_status: 0, bal_result_stop: 0, bal_result_requested: 0,
        bal_result_accepted: 0, bal_result_batches_ok: 0,
        bal_result_batches_rejected: 0, bal_result_available_delta: 0, bal_view: 0,
        bal_scope_index: -1, bal_scope_count: 0,
        preferences_load_status: preferences_status,
        settings_open: false, settings: settings_ui.initial(test_mode)
    )
    state.status = preferences_load_feedback(initial_zh, preferences_status)
    if mr_runtime_start_settings() != 0: set_settings_open(&mut state, true)
    refresh(&mut state)
    app.run(window, state)
    if test_mode: mr_runtime_emit("CI_APP_RETURNED")
