# SPDX-License-Identifier: GPL-3.0-or-later
# Mem Reduct Linux — production main window candidate.
# The original Mem Reduct 3.5.2 resources are the layout and interaction source.
# Clean memory runs through the fixed pagecache helper only when this build was
# compiled with MEMREDUCT_ENABLE_PRODUCTION_CLEAN=1 (see ADR 0005). The default
# build keeps the action disabled and says so in the button and status line.
use std/ui
use memory
use ui_geometry
use settings_ui

extern fn mr_gui_test_mode() -> i64
extern fn mr_gui_test_timeout_ms() -> i64
extern fn mr_gui_test_sample_failure_requested() -> i64
extern fn mr_gui_test_consume_sample_failure_trigger() -> i64
extern fn mr_gui_test_log_canvas_font() -> i64
extern fn mr_gui_test_start_settings() -> i64
extern fn mr_gui_test_widget_preview_resource() -> i64
extern fn mr_gui_test_schedule_capture() -> i64
extern fn mr_gui_test_selected_group() -> i64
extern fn mr_gui_test_clean_simulation_enabled() -> i64
extern fn mr_ci_emit(line: &string)
extern fn mr_production_clean_enabled() -> i64
extern fn mr_self_reclaim() -> i64
# Read-only cross-process planner (ADR-0007): scans procfs, pins pidfds, and
# reports what a later advise WOULD touch. It never writes and never advises;
# the writable half is a separate gated translation unit.
extern fn mr_crossproc_plan_status() -> i64
extern fn mr_crossproc_plan_targets() -> i64
extern fn mr_crossproc_plan_regions() -> i64
extern fn mr_crossproc_plan_bytes() -> i64
extern fn mr_crossproc_plan_error() -> i64
extern fn mr_crossproc_plan_skipped(reason: i64) -> i64
extern fn mr_self_reclaim_bytes() -> i64
extern fn mr_self_reclaim_failed_batches() -> i64
extern fn mr_self_reclaim_error() -> i64
extern fn mr_start_reclaim(mode: i64) -> i64
extern fn mr_start_reclaim_mock(mode: i64) -> i64
extern fn mr_poll_reclaim() -> i64
extern fn mr_gui_test_mock_stage() -> i64
extern fn mr_preferences_load() -> i64
extern fn mr_preferences_language() -> i64
extern fn mr_preferences_theme() -> i64
extern fn mr_preferences_values_known() -> i64
extern fn mr_preferences_can_save() -> i64
extern fn mr_preferences_set_language(language: i64) -> i64
extern fn mr_preferences_set_theme(theme: i64) -> i64
extern fn mr_preferences_reset() -> i64
extern fn mr_gui_window_mode(settings: i64) -> i64
extern fn mr_gui_take_settings_close_request() -> i64
extern fn mr_gui_settings_window_exists() -> i64
extern fn mr_gui_settings_close_handler_connected() -> i64
extern fn mr_gui_lock_window_sizes(main_width: i64, main_height: i64, settings_width: i64, settings_height: i64) -> i64
extern fn mr_gui_set_main_background(dark: i64) -> i64
extern fn mr_gui_set_compat_font() -> i64
extern fn mr_gui_take_settings_scroll_steps() -> i64
extern fn mr_gui_settings_scroll_x() -> i64
extern fn mr_gui_settings_scroll_y() -> i64

struct MainWindow:
    canvas: ui.Canvas
    settings_canvas: ui.Canvas
    width: f64
    height: f64
    zh: bool
    dark: bool
    menu: i64
    popup: i64
    hover: f64
    pressed: f64
    focus: f64
    menu_focus: f64
    collapsed_groups: i64
    selected_group: i64
    status: string
    mem_total: i64
    mem_available: i64
    swap_total: i64
    swap_free: i64
    page_cache_estimate: i64
    sample_ok: bool
    draw_logged: bool
    test_mode: bool
    test_timeout_ms: i64
    elapsed_ms: i64
    ci_sample_failure_latched: bool
    sample_failure_draw_logged: bool
    clean_simulation: bool
    clean_production: bool
    clean_self: bool
    clean_state: i64
    clean_confirm_focus: i64
    clean_before_available: i64
    preferences_load_status: i64
    settings_open: bool
    settings: settings_ui.State

fn label(zh: bool, en: string, cn: string) -> string:
    if zh: return cn
    return en

fn normalized_key_name(name: string) -> string:
    if name == "\t": return "Tab"
    if name == "\r" or name == "\n": return "Enter"
    if name == "\x1b": return "Escape"
    if name == "Page_Up" or name == "Prior": return "PageUp"
    if name == "Page_Down" or name == "Next": return "PageDown"
    name

fn next_focus_index(focus: f64) -> f64:
    let next = focus + 1.0
    if next > 4.0: return 0.0
    next

fn menu_item_has_keyboard_focus(focus: f64, index: i64) -> bool:
    focus == f64(index)

fn settings_canvas_needs_redraw(settings_open: bool, target: f64) -> bool:
    settings_open and (target == 202.0 or target == 601.0 or target == 602.0)

fn font_policy_name(policy: i64) -> string:
    if policy == 1: return "Liberation Sans"
    if policy == 2: return "system-default"
    "unavailable"

fn preferences_load_feedback(zh: bool, status: i64) -> string:
    if status == 0 or status == 1: return ""
    if status == 2: return label(zh, "Preferences are damaged; defaults are active and saving is blocked.", "设置文件已损坏；当前使用默认值并禁止保存。")
    if status == 3: return label(zh, "Preferences cannot be read; saving is blocked.", "无法读取设置文件；保存已禁用。")
    if status == 4: return label(zh, "Preferences were written by a newer version; this version will not overwrite them.", "设置来自较新版本；当前版本不会覆盖。")
    if status == 5: return label(zh, "Unsafe settings file or path; no settings were followed or changed.", "设置文件或路径不安全；未跟随或更改任何文件。")
    if status == 6: return label(zh, "Settings ownership or permissions are unsafe; saving is blocked.", "设置文件归属或权限不安全；保存已禁用。")
    if status == 7: return label(zh, "User configuration directory is unavailable; settings are not saved.", "用户配置目录不可用；设置不会保存。")
    label(zh, "Settings could not be loaded; saving is blocked.", "无法加载设置；保存已禁用。")

fn preferences_store_feedback(zh: bool, status: i64) -> string:
    if status == 0: return label(zh, "Preference saved", "设置已保存")
    if status == 1: return label(zh, "No preference change", "设置未变化")
    if status == 2: return label(zh, "Not saved; the previous preference file is unchanged.", "未保存；原设置文件保持不变。")
    if status == 3: return label(zh, "Current preference file blocked this change; reload or recover it first.", "当前设置文件阻止了此次修改；请先重新加载或恢复。")
    if status == 4: return label(zh, "New settings are visible, but crash durability is uncertain.", "新设置已可见，但断电持久性无法确认。")
    if status == 5: return label(zh, "Settings recovery is required; the existing file was preserved.", "需要恢复设置；现有文件已保留。")
    if status == 6: return label(zh, "Invalid preference value; nothing was saved.", "设置值无效；未保存。")
    label(zh, "Settings could not be saved.", "设置保存失败。")

fn preferences_store_may_apply(status: i64, values_known: bool) -> bool:
    status == 0 or status == 1 or (status == 4 and values_known)

fn apply_stored_preferences(s: &mut MainWindow, status: i64):
    let known = mr_preferences_values_known() != 0
    if preferences_store_may_apply(status, known):
        let language = mr_preferences_language()
        let theme = mr_preferences_theme()
        if language == 0 or language == 1:
            if theme == 0 or theme == 1:
                s.zh = language == 1
                s.dark = theme == 1
                s.preferences_load_status = 1
                mr_gui_set_main_background(if s.dark: 1 else: 0)
                s.status = preferences_store_feedback(s.zh, status)
                if s.settings_open: s.settings.status = s.status
                s.canvas.redraw()
                if s.settings_open: s.settings_canvas.redraw()
                return
    s.status = preferences_store_feedback(s.zh, status)
    if s.settings_open: s.settings.status = s.status
    s.canvas.redraw()
    if s.settings_open: s.settings_canvas.redraw()

fn persist_language(s: &mut MainWindow, language: i64):
    let result = mr_preferences_set_language(language)
    if s.test_mode: mr_ci_emit(f"CI_PREFERENCE_SAVE field=language value={language} status={result} known={mr_preferences_values_known() != 0}")
    apply_stored_preferences(s, result)

fn persist_theme(s: &mut MainWindow, theme: i64):
    let result = mr_preferences_set_theme(theme)
    if s.test_mode: mr_ci_emit(f"CI_PREFERENCE_SAVE field=theme value={theme} status={result} known={mr_preferences_values_known() != 0}")
    apply_stored_preferences(s, result)

fn reset_preferences(s: &mut MainWindow):
    let result = mr_preferences_reset()
    if s.test_mode: mr_ci_emit(f"CI_PREFERENCE_RESET status={result} known={mr_preferences_values_known() != 0}")
    apply_stored_preferences(s, result)

fn root_menu_target(menu: i64, row: i64) -> f64:
    if menu == 1:
        if row == 0: return 101.0
        if row == 2: return 102.0
    elif menu == 2:
        if row == 0: return 201.0
        if row == 1: return 202.0
        if row == 2: return 203.0
        if row == 4: return 204.0
    elif menu == 3:
        if row == 0: return 301.0
        if row == 1: return 302.0
        if row == 2: return 303.0
        if row == 3: return 304.0
    elif menu == 4:
        if row == 0: return 401.0
        if row == 1: return 402.0
        if row == 2: return 403.0
    return 0.0

fn first_root_menu_target(menu: i64) -> f64:
    for row in 0..ui_geometry.root_menu_row_count(menu):
        let target = root_menu_target(menu, row)
        if target != 0.0: return target
    0.0

fn menu_rect(s: &MainWindow) -> ui.Rect:
    ui_geometry.menu_root_rect(s.width, s.height, s.menu)

fn language_rect(s: &MainWindow) -> ui.Rect:
    ui_geometry.language_popup_rect(s.width, s.height)

fn button_rect(s: &MainWindow) -> ui.Rect:
    ui_geometry.clean_button_rect(s.width, s.height)

fn list_y(s: &MainWindow, dlu: f64) -> f64:
    ui_geometry.y_at_dlu(dlu, s.height)

fn clean_popup_rect(s: &MainWindow) -> ui.Rect:
    let b = button_rect(s)
    ui_geometry.clean_popup_rect(s.width, s.height, &b)

fn clean_confirm_panel(s: &MainWindow) -> ui.Rect:
    ui.rect((s.width - 249.0) / 2.0, (s.height - 104.0) / 2.0, 249.0, 104.0)

fn clean_confirm_button(confirm: bool) -> ui.Rect:
    if confirm: return ui.rect(112.0, 200.0, 78.0, 24.0)
    ui.rect(197.0, 200.0, 70.0, 24.0)

fn clean_operation_busy(state: i64) -> bool:
    state == 2 or state == 3 or state == 9 or state == 11

fn clean_progress_status(simulation: bool, zh: bool, state: i64) -> string:
    if simulation:
        if state == 2: return label(zh, "Waiting for simulated authorization", "正在等待模拟授权")
        if state == 3: return label(zh, "Mock authorization accepted", "模拟授权已接受")
        return label(zh, "Mock helper running", "模拟 helper 正在运行")
    if state == 2: return label(zh, "Waiting for authorization", "正在等待授权")
    if state == 3: return label(zh, "Authorization accepted; helper running", "授权已接受；helper 正在运行")
    label(zh, "Reclaim helper running", "回收 helper 正在运行")

fn clean_result_status_for(simulation: bool, zh: bool, state: i64) -> string:
    if state == 4 and not simulation:
        return label(zh, "Kernel accepted the page cache reclaim request", "内核已接受页缓存回收请求")
    clean_result_status(zh, state)

fn clean_result_state(result: i64) -> i64:
    if result == 0: return 4
    if result == 1: return 6
    if result == 2: return 7
    if result == 3 or result == 4: return 8
    if result == 5 or result == 6 or result == 7: return 10
    if result < 0: return 10
    7

fn clean_start_failure_state(result: i64) -> i64:
    if result == 1: return 11
    7

fn clean_result_status(zh: bool, state: i64) -> string:
    if state == 4: return label(zh, "Simulation complete; no system changes", "模拟完成；未更改系统")
    if state == 5: return label(zh, "Confirmation cancelled", "已取消确认")
    if state == 6: return label(zh, "Authorization or execution not confirmed", "授权或执行结果未确认")
    if state == 7: return label(zh, "Authorization or helper launch failed", "授权失败或 helper 无法启动")
    if state == 8: return label(zh, "The helper reported failure", "helper 执行失败")
    if state == 10: return label(zh, "Result is uncertain; do not retry automatically", "结果不确定；不会自动重试")
    if state == 11: return label(zh, "Another operation is already running", "已有操作正在运行")
    if state == 12: return label(zh, "Memory sample unavailable; simulation was not started", "内存采样不可用；未启动模拟")
    label(zh, "Operation is in progress", "操作正在进行")

# ADR-0006 action 2 result states. Kept separate from the page-cache states
# because the two actions have different costs and different guarantees.
fn clean_self_status_name(state: i64) -> string:
    if state == 20: return "self-trimmed"
    if state == 21: return "unsupported"
    if state == 22: return "failed"
    "not-started"

fn clean_self_status_text(zh: bool, state: i64) -> string:
    if state == 20: return label(zh, "This app's own memory was paged out", "已释放本程序自身内存")
    if state == 21: return label(zh, "This kernel cannot page out memory", "当前内核不支持释放内存")
    if state == 22: return label(zh, "This app's memory could not be paged out", "无法释放本程序内存")
    label(zh, "Trimming this app's memory...", "正在释放本程序内存……")

fn clean_self_state_for(result: i64) -> i64:
    if result == 0: return 20
    if result == 1: return 21
    22

fn clean_result_name(state: i64) -> string:
    if state == 4: return "accepted"
    if state == 5: return "confirmation-cancelled"
    if state == 6: return "authorization-unconfirmed"
    if state == 7: return "authorization-failed"
    if state == 8: return "execution-failed"
    if state == 10: return "uncertain"
    if state == 11: return "already-running"
    if state == 12: return "not-started-sample-unavailable"
    "in-progress"

# ADR-0006 action 2, self mode: page out this process's own memory. It needs no
# privilege, cannot reach another process, and is therefore always available.
fn clean_self_can_start(state: i64) -> bool:
    state != 1 and not clean_operation_busy(state)

# Runs ADR-0006 action 2 in self mode. No helper, no authorization, no other
# process: mr_self_reclaim only ever targets this process. The byte count is the
# length the kernel accepted, not a measurement, so it is reported as such.
fn run_self_reclaim(s: &mut MainWindow):
    let result = mr_self_reclaim()
    let state = clean_self_state_for(result)
    s.clean_state = state
    # The self trim never touches another process, so it is also the natural
    # moment to run the read-only cross-process planner (ADR-0007): same
    # unprivileged context, no advice issued, output purely observational. The
    # status line reports what a FUTURE gated advise would have considered,
    # which is the review-required visibility the cross-process work must show
    # before any writable path is ever enabled.
    let plan_status = mr_crossproc_plan_status()
    let preview = label(s.zh, " cross-process preview: ", " 跨进程预览：")
    # 0 OK and 5 NO_CANDIDATES are both completed scans -- 5 is the honest
    # answer when every process belongs to another user. 3 stops at a budget
    # but the plan is still usable. Only a genuinely failed scan (procfs
    # unreadable, reentrant call, bad argument) shows "unavailable".
    if plan_status == 0 or plan_status == 5 or plan_status == 3:
        let bytes = mr_crossproc_plan_bytes()
        let mb = bytes / 1048576
        let targets = mr_crossproc_plan_targets()
        let regions = mr_crossproc_plan_regions()
        let detail_en = f"{targets} processes / {regions} regions / ~{mb} MiB candidate (read-only)"
        let detail_zh = f"{targets} 进程 / {regions} 区域 / 约 {mb} MiB 候选（只读）"
        let body = label(s.zh, detail_en, detail_zh)
        s.status = clean_self_status_text(s.zh, state) + preview + body
    else:
        # The scan itself failed; say so instead of showing a stale count.
        let body = label(s.zh, "scan unavailable", "扫描不可用")
        s.status = clean_self_status_text(s.zh, state) + preview + body
    if s.test_mode:
        mr_ci_emit(f"CI_CLEAN_SELF result={clean_self_status_name(state)} result_state={state} status={result} accepted_bytes={mr_self_reclaim_bytes()} failed_batches={mr_self_reclaim_failed_batches()} error={mr_self_reclaim_error()} target=self only other_processes=false no_privilege=true")
        mr_ci_emit(f"CI_CROSSPROC_PREVIEW status={plan_status} targets={mr_crossproc_plan_targets()} regions={mr_crossproc_plan_regions()} bytes={mr_crossproc_plan_bytes()} error={mr_crossproc_plan_error()} skipped_shared={mr_crossproc_plan_skipped(7)} skipped_writable={mr_crossproc_plan_skipped(8)} readonly=true no_advice_issued=true")
    s.canvas.redraw()

fn clean_simulation_can_start(state: i64) -> bool:
    state != 1 and not clean_operation_busy(state)

fn log_popup(s: &MainWindow, kind: string, r: &ui.Rect):
    if not s.test_mode: return
    let fits = r.x >= 2.0 and r.y >= 2.0 and r.right() <= s.width - 2.0 and r.bottom() <= s.height - 2.0
    let locale = label(s.zh, "en", "zh-CN")
    mr_ci_emit(f"CI_POPUP kind={kind} menu={s.menu} locale={locale} x={r.x} y={r.y} w={r.w} h={r.h} canvas={s.width}x{s.height} fits={fits}")

fn menu_item_at(s: &MainWindow, x: f64, y: f64) -> f64:
    if s.popup == 2:
        let r = clean_popup_rect(s)
        for row in 0..8:
            if ui_geometry.clean_menu_item_rect(&r, row).contains(x, y): return 500.0 + f64(row)
        return 0.0
    if s.popup == 3:
        let r = language_rect(s)
        for row in 0..2:
            if ui_geometry.language_menu_item_rect(&r, row).contains(x, y): return 601.0 + f64(row)
        return 0.0
    if s.popup == 1 and s.menu > 0:
        let r = menu_rect(s)
        for row in 0..ui_geometry.root_menu_row_count(s.menu):
            let target = root_menu_target(s.menu, row)
            if target != 0.0 and ui_geometry.root_menu_item_rect(&r, s.menu, row).contains(x, y): return target
    return 0.0

fn hit(s: &MainWindow, x: f64, y: f64) -> f64:
    if s.clean_state == 1:
        if clean_confirm_button(true).contains(x, y): return 710.0
        if clean_confirm_button(false).contains(x, y): return 711.0
        return 0.0
    if y >= 0.0 and y < 24.0:
        for index in 1..5:
            if ui_geometry.menu_bar_item_rect(index).contains(x, y): return f64(index)
    let item = menu_item_at(s, x, y)
    if item != 0.0: return item
    if s.popup == 1 or s.popup == 2 or s.popup == 3:
        if s.popup == 1 and menu_rect(s).contains(x, y): return 0.0
        if s.popup == 2 and clean_popup_rect(s).contains(x, y): return 0.0
        if s.popup == 3 and language_rect(s).contains(x, y): return 0.0
    for group in 0..3:
        if ui_geometry.group_disclosure_rect(group, s.width, s.height, s.collapsed_groups).contains(x, y):
            return 30.0 + f64(group)
        if ui_geometry.group_selection_rect(group, s.width, s.height, s.collapsed_groups).contains(x, y):
            return 40.0 + f64(group)
    let b = button_rect(s)
    if b.contains(x, y):
        if x >= b.right() - ui_geometry.clean_arrow_width_px(): return 20.0
        return 19.0
    return 0.0

fn draw_outline(p: &ui.Painter, r: &ui.Rect, color: &ui.Color):
    p.begin()
    p.add_rect(r)
    p.stroke(color, 1.0)

fn draw_menu_item(s: &MainWindow, p: &ui.Painter, r: &ui.Rect, target: f64, text: string, enabled: bool, fg: &ui.Color, disabled: &ui.Color, hot: &ui.Color):
    if enabled and (s.hover == target or s.menu_focus == target):
        p.fill_rect(r, hot)
    if enabled:
        p.text(r.x + 8.0, r.y + 5.0, text, fg, size=8.0)
    else:
        p.text(r.x + 8.0, r.y + 5.0, text, disabled, size=8.0)

fn draw_menu_shortcut(p: &ui.Painter, r: &ui.Rect, shortcut: string, color: &ui.Color):
    let width = ui.text_width(shortcut, size=8.0)
    p.text(r.right() - width - 8.0, r.y + 5.0, shortcut, color, size=8.0)

fn draw_menu_check(p: &ui.Painter, r: &ui.Rect, checked: bool, color: &ui.Color):
    if checked: p.text(r.x + 3.0, r.y + 4.0, "✓", color, size=8.0)

fn draw_menu_separator(p: &ui.Painter, r: &ui.Rect, color: &ui.Color):
    let y = r.y + r.h / 2.0
    p.line(r.x + 6.0, y, r.right() - 6.0, y, color)

fn draw_root_menu(s: &MainWindow, p: &ui.Painter, fg: &ui.Color, disabled: &ui.Color, border: &ui.Color, surface: &ui.Color, hot: &ui.Color):
    let r = menu_rect(s)
    p.fill_rect(&r, surface)
    draw_outline(p, &r, border)
    let row1 = ui_geometry.root_menu_item_rect(&r, s.menu, 0)
    if s.menu == 1:
        draw_menu_item(s, p, &row1, 101.0, label(s.zh, "Settings...", "设置..."), true, fg, disabled, hot)
        draw_menu_shortcut(p, &row1, "F2", fg)
        let separator = ui_geometry.root_menu_item_rect(&r, s.menu, 1)
        draw_menu_separator(p, &separator, border)
        let row2 = ui_geometry.root_menu_item_rect(&r, s.menu, 2)
        draw_menu_item(s, p, &row2, 102.0, label(s.zh, "Exit", "退出"), true, fg, disabled, hot)
    elif s.menu == 2:
        draw_menu_item(s, p, &row1, 201.0, label(s.zh, "Always on top", "窗口始终置顶"), false, fg, disabled, hot)
        let row2 = ui_geometry.root_menu_item_rect(&r, s.menu, 1)
        let dark_text = label(s.zh, "Use dark theme", "使用深色主题")
        draw_menu_item(s, p, &row2, 202.0, dark_text, true, fg, disabled, hot)
        draw_menu_check(p, &row2, s.dark, fg)
        let row3 = ui_geometry.root_menu_item_rect(&r, s.menu, 2)
        draw_menu_item(s, p, &row3, 203.0, label(s.zh, "Confirm memory cleaning start", "清理前确认"), false, fg, disabled, hot)
        draw_menu_check(p, &row3, true, disabled)
        let separator = ui_geometry.root_menu_item_rect(&r, s.menu, 3)
        draw_menu_separator(p, &separator, border)
        let row4 = ui_geometry.root_menu_item_rect(&r, s.menu, 4)
        draw_menu_item(s, p, &row4, 204.0, label(s.zh, "Language (Language)", "语言…… (Language)"), true, fg, disabled, hot)
        p.text(row4.right() - 12.0, row4.y + 4.0, "›", fg, size=8.0)
    elif s.menu == 3:
        draw_menu_item(s, p, &row1, 301.0, label(s.zh, "Load on system startup", "开机启动"), false, fg, disabled, hot)
        let row2 = ui_geometry.root_menu_item_rect(&r, s.menu, 1)
        draw_menu_item(s, p, &row2, 302.0, label(s.zh, "Start minimized", "最小化启动"), false, fg, disabled, hot)
        let row3 = ui_geometry.root_menu_item_rect(&r, s.menu, 2)
        draw_menu_item(s, p, &row3, 303.0, label(s.zh, "Skip \"User Account Control\" prompt warning", "跳过“用户账户控制（UAC）”提示"), false, fg, disabled, hot)
        let row4 = ui_geometry.root_menu_item_rect(&r, s.menu, 3)
        draw_menu_item(s, p, &row4, 304.0, label(s.zh, "Periodically check for updates (recommended)", "自动检查更新（推荐）"), false, fg, disabled, hot)
        draw_menu_check(p, &row4, true, disabled)
    else:
        draw_menu_item(s, p, &row1, 401.0, label(s.zh, "Website", "项目网站"), false, fg, disabled, hot)
        let row2 = ui_geometry.root_menu_item_rect(&r, s.menu, 1)
        draw_menu_item(s, p, &row2, 402.0, label(s.zh, "Check for updates", "检查更新"), false, fg, disabled, hot)
        let row3 = ui_geometry.root_menu_item_rect(&r, s.menu, 2)
        draw_menu_item(s, p, &row3, 403.0, label(s.zh, "About", "关于"), false, fg, disabled, hot)
        draw_menu_shortcut(p, &row3, "F1", disabled)

fn draw_language_menu(s: &MainWindow, p: &ui.Painter, fg: &ui.Color, border: &ui.Color, surface: &ui.Color, hot: &ui.Color):
    let r = language_rect(s)
    p.fill_rect(&r, surface)
    draw_outline(p, &r, border)
    let row1 = ui_geometry.language_menu_item_rect(&r, 0)
    let row2 = ui_geometry.language_menu_item_rect(&r, 1)
    draw_menu_item(s, p, &row1, 601.0, "English", true, fg, fg, hot)
    draw_menu_item(s, p, &row2, 602.0, "简体中文", true, fg, fg, hot)
    if not s.zh: p.text(r.x + r.w - 18.0, row1.y + 5.0, "✓", fg, size=8.0)
    if s.zh: p.text(r.x + r.w - 18.0, row2.y + 5.0, "✓", fg, size=8.0)

fn draw_stats_group(s: &mut MainWindow, p: &ui.Painter, group: i64, title: string, usage: string, available: string, total: string, fg: &ui.Color, secondary: &ui.Color, group_title: &ui.Color, rule: &ui.Color, selected: &ui.Color):
    let collapsed = ui_geometry.group_is_collapsed(s.collapsed_groups, group)
    let title_y = ui_geometry.group_title_y_for_mask(group, s.height, s.collapsed_groups)
    if s.selected_group == group:
        let selection = ui_geometry.group_selection_rect(group, s.width, s.height, s.collapsed_groups)
        p.fill_rect(&selection, selected)
    let title_x = ui_geometry.metric_title_x(s.width)
    let title_width = ui.text_width(title, size=8.0)
    let rule_x = title_x + title_width + 8.0
    let rule_y = ui_geometry.group_header_rule_y_for_mask(group, s.height, s.collapsed_groups)
    let rule_right = ui_geometry.list_right_x(s.width) - 20.0
    let value_x = ui_geometry.metric_value_x(s.width)
    let row0 = ui_geometry.metric_row_y_for_mask(group, 0, s.height, s.collapsed_groups)
    let row1 = ui_geometry.metric_row_y_for_mask(group, 1, s.height, s.collapsed_groups)
    let row2 = ui_geometry.metric_row_y_for_mask(group, 2, s.height, s.collapsed_groups)
    if rule_x < rule_right: p.line(rule_x, rule_y, rule_right, rule_y, rule)
    p.text(title_x, title_y, title, group_title, size=8.0)
    let disclosure = ui_geometry.group_disclosure_rect(group, s.width, s.height, s.collapsed_groups)
    if collapsed:
        p.line(disclosure.x + 2.0, disclosure.y + 2.0, disclosure.x + 7.0, disclosure.y + 6.0, group_title)
        p.line(disclosure.x + 7.0, disclosure.y + 6.0, disclosure.x + 2.0, disclosure.y + 10.0, group_title)
    else:
        p.line(disclosure.x + 2.0, disclosure.y + 8.0, disclosure.x + 6.0, disclosure.y + 3.0, group_title)
        p.line(disclosure.x + 6.0, disclosure.y + 3.0, disclosure.x + 10.0, disclosure.y + 8.0, group_title)
    if not collapsed:
        let label0 = label(s.zh, "Usage", "已用")
        let label1 = label(s.zh, "Available", "空闲")
        let label2 = label(s.zh, "Total available", "总计")
        p.text(ui_geometry.metric_row_label_x(s.width, 0, s.zh), row0, label0, secondary, size=8.0)
        p.text(value_x, row0, usage, fg, size=8.0)
        p.text(ui_geometry.metric_row_label_x(s.width, 1, s.zh), row1, label1, secondary, size=8.0)
        p.text(value_x, row1, available, fg, size=8.0)
        p.text(ui_geometry.metric_row_label_x(s.width, 2, s.zh), row2, label2, secondary, size=8.0)
        p.text(value_x, row2, total, fg, size=8.0)
    if s.test_mode:
        let locale = label(s.zh, "en", "zh-CN")
        mr_ci_emit(f"CI_LAYOUT_GROUP index={group} locale={locale} title={title} collapsed={collapsed} usage={usage} available={available} total={total} title_y={title_y} rule_x={rule_x} rule_y={rule_y} row0={row0} row1={row1} row2={row2}")

fn draw_clean_menu(s: &MainWindow, p: &ui.Painter, fg: &ui.Color, disabled: &ui.Color, border: &ui.Color, surface: &ui.Color, hot: &ui.Color):
    let r = clean_popup_rect(s)
    p.fill_rect(&r, surface)
    draw_outline(p, &r, border)
    # ADR-0006: the first two entries are the Linux actions that actually exist.
    # The rest stay disabled because they name Windows objects that Linux has no
    # equivalent for; leaving them listed keeps the divergence visible instead of
    # silently dropping rows the original has.
    let names_en = ["Trim this app's memory (no privilege)", "Clean page cache (needs authorization)", "Modified page list", "Standby list", "Standby list (without priority)", "Modified file cache", "Registry cache (Windows)", "Combine memory lists (Windows)"]
    let names_zh = ["释放本程序内存（无需授权）", "清理页缓存（需系统授权）", "已修改页列表", "备用列表", "无优先级备用列表", "已修改文件缓存", "注册表缓存（Windows）", "合并内存列表（Windows）"]
    for i in 0..8:
        let row = ui_geometry.clean_menu_item_rect(&r, i)
        let target = 500.0 + f64(i)
        let mut name = names_en[i]
        if s.zh: name = names_zh[i]
        let enabled = i == 0 or (i == 1 and (s.clean_simulation or s.clean_production))
        draw_menu_item(s, p, &row, target, name, enabled, fg, disabled, hot)

fn draw_clean_confirmation(s: &MainWindow, p: &ui.Painter, fg: &ui.Color, secondary: &ui.Color, border: &ui.Color, surface: &ui.Color, hot: &ui.Color):
    let panel = clean_confirm_panel(s)
    p.fill_rect(&panel, surface)
    draw_outline(p, &panel, border)
    # The panel width is fixed, so every line has to fit inside it. Split the
    # explanation over two short lines instead of one long one that the panel
    # edge would clip mid-word.
    let backend_mode = if s.clean_simulation: "simulation" else: "production"
    let title_text = if s.clean_simulation: label(s.zh, "Test-only simulated clean", "仅测试模拟清理") else: label(s.zh, "Clean page cache", "清理页缓存")
    # The production warning must carry the risks the kernel documents and must
    # never promise an amount: dropping caches costs later re-reads, may not
    # touch dirty objects, and does not guarantee any free memory. The simulated
    # path keeps its own wording so a test string can never stand in for a
    # production warning.
    let body_a = if s.clean_simulation: label(s.zh, "Mock helper only; writes a temp file.", "仅使用模拟 helper，只写临时文件。") else: label(s.zh, "Drops clean page cache only.", "仅丢弃干净页缓存。")
    let body_b = if s.clean_simulation: label(s.zh, "No system memory is changed.", "不会改动系统内存。") else: label(s.zh, "Files re-read slower; no free amount promised.", "文件将变慢重读；不保证释放量。")
    p.text(panel.x + 10.0, panel.y + 9.0, title_text, fg, size=8.0)
    p.text(panel.x + 10.0, panel.y + 26.0, body_a, secondary, size=8.0)
    p.text(panel.x + 10.0, panel.y + 40.0, body_b, secondary, size=8.0)
    if s.test_mode:
        let inner = panel.w - 20.0
        let mut widest = ui.text_width(title_text, size=8.0)
        let wa = ui.text_width(body_a, size=8.0)
        let wb = ui.text_width(body_b, size=8.0)
        if wa > widest: widest = wa
        if wb > widest: widest = wb
        # Report the strings that were actually drawn. Asserting their content
        # here would only re-check this same literal; the wording guarantee is
        # enforced where it can be verified, against the source, in the test suite.
        mr_ci_emit(f"CI_CLEAN_CONFIRM_TEXT mode={backend_mode} inner_width={inner} widest_line={widest} fits={widest <= inner} line2={body_a} line3={body_b}")
    let confirm = clean_confirm_button(true)
    let cancel = clean_confirm_button(false)
    if s.clean_confirm_focus == 0: p.fill_rect(&confirm, hot)
    else: p.fill_rect(&confirm, surface)
    draw_outline(p, &confirm, border)
    p.text(confirm.x + 17.0, confirm.y + 6.0, label(s.zh, "Run", "确认"), fg, size=8.0)
    if s.clean_confirm_focus == 1: p.fill_rect(&cancel, hot)
    else: p.fill_rect(&cancel, surface)
    draw_outline(p, &cancel, border)
    p.text(cancel.x + 15.0, cancel.y + 6.0, label(s.zh, "Cancel", "取消"), fg, size=8.0)

fn draw(s: &mut MainWindow, p: &ui.Painter):
    let old_w = s.width
    let old_h = s.height
    s.width = p.width()
    s.height = p.height()
    if s.test_mode and (not s.draw_logged or old_w != s.width or old_h != s.height):
        s.draw_logged = true
        mr_ci_emit(f"CI_DRAW width={s.width} height={s.height}")

    let mut surface = ui.rgb(0xffffff)
    let mut fg = ui.rgb(0x000000)
    let mut secondary = ui.rgb(0x000000)
    let mut disabled = ui.rgb(0x858585)
    let mut border = ui.rgb(0x8c8c8c)
    let mut rule = ui.rgb(0xb0b0b0)
    let mut group_title = ui.rgb(0x1e3287)
    let mut group_rule = ui.rgb(0xb2c1e0)
    let mut button_bg = ui.rgb(0xe1e1e1)
    let mut hot = ui.rgb(0xdce8f5)
    let mut pressed_bg = ui.rgb(0xc4d7ec)
    let mut selected = ui.rgb(0xe5f3ff)
    let mut column_rule = ui.rgb(0xebf4fe)
    if s.dark:
        surface = ui.rgb(0x242424)
        fg = ui.rgb(0xe9e9e9)
        secondary = ui.rgb(0xc5c5c5)
        disabled = ui.rgb(0x777777)
        border = ui.rgb(0x707070)
        rule = ui.rgb(0x5b5b5b)
        group_title = ui.rgb(0x9bbcff)
        group_rule = ui.rgb(0x48648a)
        button_bg = ui.rgb(0x3a3a3a)
        hot = ui.rgb(0x3c5066)
        pressed_bg = ui.rgb(0x485b70)
        selected = ui.rgb(0x3c5066)
        column_rule = ui.rgb(0x5b5b5b)

    p.fill_rect(&ui.rect(0.0, 0.0, s.width, s.height), &surface)
    p.text(8.0, 5.0, label(s.zh, "File", "文件"), &fg, size=8.0)
    p.text(48.0, 5.0, label(s.zh, "View", "视图"), &fg, size=8.0)
    p.text(92.0, 5.0, label(s.zh, "Settings", "设置"), &fg, size=8.0)
    p.text(160.0, 5.0, label(s.zh, "Help", "帮助"), &fg, size=8.0)
    p.line(0.0, 23.5, s.width, 23.5, rule)
    for index in 1..5:
        if menu_item_has_keyboard_focus(s.focus, index - 1): draw_outline(p, &ui_geometry.menu_bar_item_rect(index), &border)

    draw_stats_group(s, p, 0, label(s.zh, "Physical memory", "物理内存"), usage_percentage(s.mem_total - s.mem_available, s.mem_total, s.sample_ok), value(s.mem_available, s.sample_ok), value(s.mem_total, s.sample_ok), &fg, &secondary, &group_title, &group_rule, &selected)
    draw_stats_group(s, p, 1, label(s.zh, "Pagefile / Swap", "交换空间"), usage_percentage(s.swap_total - s.swap_free, s.swap_total, s.sample_ok), value(s.swap_free, s.sample_ok), value(s.swap_total, s.sample_ok), &fg, &secondary, &group_title, &group_rule, &selected)
    # Windows reads a system_cache field here; Linux has no whole-system working
    # set figure. An em dash in every cell reads as a broken panel, so the group
    # states why it is empty instead of looking like a loading failure.
    let ws_note_usage = label(s.zh, "Not available on Linux", "Linux 无此指标")
    let ws_note_available = label(s.zh, "Not available on Linux", "Linux 无此指标")
    let ws_note_total = label(s.zh, "Not available on Linux", "Linux 无此指标")
    draw_stats_group(s, p, 2, label(s.zh, "System working set", "系统工作集"), ws_note_usage, ws_note_available, ws_note_total, &fg, &secondary, &group_title, &group_rule, &selected)
    for index in 0..2:
        let x = ui_geometry.main_column_rule_x_px(index)
        p.line(x, ui_geometry.main_column_rule_top_y_px(), x, ui_geometry.main_column_rule_bottom_y_px(), &column_rule)
    if s.test_mode and not s.sample_ok and not s.sample_failure_draw_logged:
        s.sample_failure_draw_logged = true
        mr_ci_emit("CI_DRAW_SAMPLE state=unavailable values=em-dash")

    let b = button_rect(s)
    p.fill_rect(&b, button_bg)
    if s.hover == 19.0: p.fill_rect(&b, button_bg)
    if s.hover == 20.0: p.fill_rect(&ui.rect(b.right() - ui_geometry.clean_arrow_width_px(), b.y, ui_geometry.clean_arrow_width_px(), b.h), hot)
    if s.pressed == 20.0: p.fill_rect(&ui.rect(b.right() - ui_geometry.clean_arrow_width_px(), b.y, ui_geometry.clean_arrow_width_px(), b.h), pressed_bg)
    draw_outline(p, &b, border)
    let clean_label = label(s.zh, "Clean memory", "清理内存")
    let clean_label_width = ui.text_width(clean_label, size=8.0)
    # The label keeps the normal foreground in every build. A greyed-out button
    # reads as "this control is broken"; what is actually true is that the action
    # is not available here, and that belongs in the status line where the user
    # finds the reason rather than in the label's colour alone.
    # The label keeps the normal foreground in every build: a greyed-out button
    # reads as "this control is broken", and the actual reason belongs in the
    # status line, not squeezed into the button next to the label.
    p.text(ui_geometry.clean_button_label_x(s.width, s.height, clean_label_width), b.y + 5.0, clean_label, &fg, size=8.0)
    # Centre the chevron inside the 17px drop-down cell instead of pinning it to
    # the outer edge: the divider is at right-17, so the cell runs from there to
    # the button edge and the glyph belongs in the middle of it.
    let arrow_right = b.right() - ui_geometry.clean_arrow_width_px()
    let chevron_mid = arrow_right + ui_geometry.clean_arrow_width_px() / 2.0
    p.line(arrow_right, b.y, arrow_right, b.bottom(), &border)
    p.line(chevron_mid - 5.0, b.y + 7.0, chevron_mid, b.y + 12.0, &disabled)
    p.line(chevron_mid, b.y + 12.0, chevron_mid + 5.0, b.y + 7.0, &disabled)
    if s.focus == 4.0: draw_outline(p, &ui.rect(b.right() - ui_geometry.clean_arrow_width_px(), b.y + 1.0, ui_geometry.clean_arrow_width_px() - 2.0, b.h - 2.0), &border)
    if s.status != "": p.text(ui_geometry.metric_label_x(s.width), list_y(s, 183.0), s.status, &secondary, size=8.0)

    if s.popup == 1:
        draw_root_menu(s, p, &fg, &disabled, &border, &surface, &hot)
    elif s.popup == 2:
        draw_clean_menu(s, p, &fg, &disabled, &border, &surface, &hot)
    elif s.popup == 3:
        draw_root_menu(s, p, &fg, &disabled, &border, &surface, &hot)
        draw_language_menu(s, p, &fg, &border, &surface, &hot)
    if s.clean_state == 1: draw_clean_confirmation(s, p, &fg, &secondary, &border, &surface, &hot)

fn value(kib: i64, available: bool) -> string:
    if not available: return "—"
    let amount = max(0, kib)
    if amount >= 1048576:
        let tenths = (amount * 10 + 524288) // 1048576
        return f"{tenths // 10}.{tenths % 10} GB"
    if amount >= 1024:
        let tenths = (amount * 10 + 512) // 1024
        return f"{tenths // 10}.{tenths % 10} MB"
    f"{amount} KB"

fn usage_percentage(used_kib: i64, total_kib: i64, available: bool) -> string:
    if not available or total_kib <= 0: return "—"
    let thousandths = memory.percent_thousandths(used_kib, total_kib)
    let whole = thousandths // 1000
    let fraction = thousandths % 1000
    if fraction < 10: return f"{whole}.00{fraction}%"
    if fraction < 100: return f"{whole}.0{fraction}%"
    f"{whole}.{fraction}%"

fn test_usage_percentage_matches_upstream_metric():
    assert(usage_percentage(1072, 15989, true) == "6.705%")
    assert(usage_percentage(1, 3, true) == "33.333%")
    assert(usage_percentage(0, 100, true) == "0.000%")
    assert(usage_percentage(1, 0, true) == "—")
    assert(usage_percentage(1, 100, false) == "—")

fn test_value_matches_upstream_scale_and_unavailable_state():
    assert(value(15728640, true) == "15.0 GB")
    assert(value(1536, true) == "1.5 MB")
    assert(value(512, true) == "512 KB")
    assert(value(512, false) == "—")

fn test_ci_sample_failure_latch_is_test_only():
    assert(suppress_ci_resample(true, true))
    assert(not suppress_ci_resample(true, false))
    assert(not suppress_ci_resample(false, true))

fn test_clean_operation_results_preserve_distinct_feedback():
    assert(clean_operation_busy(2))
    assert(clean_operation_busy(3))
    assert(clean_operation_busy(9))
    assert(clean_operation_busy(11))
    assert(not clean_operation_busy(0))
    assert(clean_result_state(0) == 4)
    assert(clean_result_state(1) == 6)
    assert(clean_result_state(2) == 7)
    assert(clean_result_state(3) == 8)
    assert(clean_result_state(4) == 8)
    assert(clean_result_state(5) == 10)
    assert(clean_result_state(6) == 10)
    assert(clean_result_state(7) == 10)
    assert(clean_result_state(-2) == 10)
    assert(clean_start_failure_state(1) == 11)
    assert(clean_start_failure_state(2) == 7)
    assert(clean_result_name(12) == "not-started-sample-unavailable")
    assert(not clean_simulation_can_start(11))
    assert(clean_simulation_can_start(0))
    assert(not clean_simulation_can_start(1))
    assert(not clean_simulation_can_start(2))
    assert(not clean_simulation_can_start(3))

fn test_clean_operation_result_labels_are_explicit_and_localized():
    assert(clean_result_status(false, 4) == "Simulation complete; no system changes")
    assert(clean_result_status(true, 4) == "模拟完成；未更改系统")
    assert(clean_result_status(false, 5) == "Confirmation cancelled")
    assert(clean_result_status(true, 5) == "已取消确认")
    assert(clean_result_status(false, 6) == "Authorization or execution not confirmed")
    assert(clean_result_status(false, 8) == "The helper reported failure")
    assert(clean_result_status(false, 10) == "Result is uncertain; do not retry automatically")
    assert(clean_result_status(true, 10) == "结果不确定；不会自动重试")
    assert(clean_result_status(false, 12) == "Memory sample unavailable; simulation was not started")
    assert(clean_result_name(4) == "accepted")
    assert(clean_result_name(5) == "confirmation-cancelled")
    assert(clean_result_name(6) == "authorization-unconfirmed")
    assert(clean_result_name(7) == "authorization-failed")
    assert(clean_result_name(8) == "execution-failed")
    assert(clean_result_name(10) == "uncertain")
    # Simulation wording never appears on the production path, and vice versa.
    assert(clean_progress_status(true, false, 2) == "Waiting for simulated authorization")
    assert(clean_progress_status(true, true, 2) == "正在等待模拟授权")
    assert(clean_progress_status(true, false, 9) == "Mock helper running")
    assert(clean_progress_status(true, true, 9) == "模拟 helper 正在运行")
    assert(clean_progress_status(false, false, 2) == "Waiting for authorization")
    assert(clean_progress_status(false, true, 2) == "正在等待授权")
    assert(clean_progress_status(false, false, 9) == "Reclaim helper running")
    assert(clean_progress_status(false, true, 3) == "授权已接受；helper 正在运行")
    # Success wording must not promise a byte count the kernel never reported.
    assert(clean_result_status_for(true, false, 4) == "Simulation complete; no system changes")
    assert(clean_result_status_for(false, false, 4) == "Kernel accepted the page cache reclaim request")
    assert(clean_result_status_for(false, true, 4) == "内核已接受页缓存回收请求")
    assert(clean_result_status_for(false, false, 8) == clean_result_status(false, 8))

fn suppress_ci_resample(test_mode: bool, failure_latched: bool) -> bool:
    test_mode and failure_latched

fn refresh(s: &mut MainWindow):
    # Keep the test-only injected failure visible until the bounded CI process
    # exits. Production sampling and recovery behavior are unchanged.
    if suppress_ci_resample(s.test_mode, s.ci_sample_failure_latched): return
    let snapshot = sample_for_ui(s) catch e:
        s.sample_ok = false
        s.mem_total = 0
        s.mem_available = 0
        s.swap_total = 0
        s.swap_free = 0
        s.page_cache_estimate = 0
        s.status = label(s.zh, "Cannot read /proc/meminfo", "无法读取 /proc/meminfo")
        if s.test_mode: mr_ci_emit(f"CI_MEMORY_ERROR {e}")
        s.canvas.redraw()
        if s.test_mode: mr_ci_emit("CI_MEMORY_INVALIDATED redraw_requested=true")
        return
    s.mem_total = snapshot.total
    s.mem_available = snapshot.available
    s.swap_total = snapshot.swap_total
    s.swap_free = snapshot.swap_free
    s.page_cache_estimate = snapshot.page_cache
    s.sample_ok = true
    s.sample_failure_draw_logged = false
    if s.test_mode:
        mr_ci_emit(f"CI_MEMORY source=/proc/meminfo MemTotal={snapshot.total} MemAvailable={snapshot.available} CachedPageCache={snapshot.page_cache} SReclaimableSlab={snapshot.reclaimable_slab} SwapTotal={snapshot.swap_total} SwapFree={snapshot.swap_free}")
    s.canvas.redraw()

fn finish_clean_simulation(s: &mut MainWindow, bridge_result: i64):
    let state = clean_result_state(bridge_result)
    s.clean_state = state
    s.status = clean_result_status_for(s.clean_simulation, s.zh, state)
    let source = if s.clean_simulation: "mock-helper" else: "pkexec-helper"
    let marker = if s.clean_simulation: "CI_CLEAN_SIM" else: "CI_CLEAN"
    if state == 4:
        if not s.clean_simulation:
            if s.test_mode: mr_ci_emit(f"CI_CLEAN result=accepted source={source} kernel_accepted=true bytes_measured=false")
            refresh(s)
            return
        let after = memory.sample() catch e:
            if s.test_mode: mr_ci_emit(f"CI_CLEAN_SIM result=accepted source={source} after_sample=unavailable error={e} no_system_write=true")
            s.canvas.redraw()
            return
        let delta = after.available - s.clean_before_available
        if s.test_mode: mr_ci_emit(f"CI_CLEAN_SIM result=accepted source={source} observed_memavailable_before_kib={s.clean_before_available} observed_memavailable_after_kib={after.available} observed_delta_kib={delta} causal_attribution=none no_system_write=true")
    elif s.test_mode:
        mr_ci_emit(f"{marker} result={clean_result_name(state)} result_state={state} source={source} automatic_retry=false no_system_write=true")
    s.canvas.redraw()

fn sample_for_ui(s: &mut MainWindow) -> memory.Snapshot!string:
    if s.test_mode and mr_gui_test_consume_sample_failure_trigger() != 0:
        s.ci_sample_failure_latched = true
        mr_ci_emit("CI_SAMPLE_FAILURE_TRIGGER consumed=1 source=private-trigger-file")
        fail "injected non-privileged CI sample failure"
    memory.sample()?

fn set_settings_open(s: &mut MainWindow, open: bool):
    if s.settings_open == open: return
    let mode = if open: 1 else: 0
    let changed = mr_gui_window_mode(mode)
    if changed == 0 or (open and mr_gui_settings_window_exists() == 0):
        s.status = label(s.zh, "Could not open the settings window", "无法打开设置窗口")
        if s.test_mode: mr_ci_emit(f"CI_SETTINGS_WINDOW mode={mode} action=failed")
        return
    s.settings_open = open
    s.popup = 0
    s.menu = 0
    s.pressed = 0.0
    if open:
        s.settings = settings_ui.initial(s.test_mode)
        s.settings.status = preferences_load_feedback(s.zh, s.preferences_load_status)
        let widget_preview = mr_gui_test_widget_preview_resource()
        if widget_preview != 0:
            settings_ui.enable_widget_preview_checkbox(&mut s.settings, widget_preview)
        s.settings_canvas.redraw()
        if s.test_mode:
            mr_ci_emit(f"CI_SETTINGS_WINDOW mode=settings visible=true native_toplevel=true close_handler={mr_gui_settings_close_handler_connected() != 0} resource=IDD_SETTINGS_*:260x168_dlu shell={ui_geometry.settings_window_width_px()}x{ui_geometry.settings_window_height_px()}_provisional")
    else:
        s.status = preferences_load_feedback(s.zh, s.preferences_load_status)
        if s.test_mode: mr_ci_emit("CI_SETTINGS_WINDOW mode=main settings_hidden=true")
    s.canvas.redraw()

fn tick(s: &mut MainWindow):
    s.elapsed_ms += 1000
    if mr_gui_take_settings_close_request() != 0:
        if s.test_mode: mr_ci_emit("CI_SETTINGS_CLOSE_REQUEST source=delete_event")
        set_settings_open(s, false)
        if s.test_mode: mr_ci_emit("CI_SETTINGS_CLOSE_REQUEST_HANDLED main_visible=true")
    if clean_operation_busy(s.clean_state):
        let mock_stage = if s.clean_simulation: mr_gui_test_mock_stage() else: 0
        let bridge_result = mr_poll_reclaim()
        if bridge_result != -1:
            finish_clean_simulation(s, bridge_result)
        elif mock_stage == 1 and s.clean_state == 2:
            s.clean_state = 3
            s.status = clean_progress_status(s.clean_simulation, s.zh, 3)
            if s.test_mode: mr_ci_emit("CI_CLEAN_SIM stage=authorization-accepted backend=mock no_privilege_request=true")
            s.canvas.redraw()
        elif mock_stage == 2 and s.clean_state != 9:
            s.clean_state = 9
            s.status = clean_progress_status(s.clean_simulation, s.zh, 9)
            if s.test_mode: mr_ci_emit("CI_CLEAN_SIM stage=helper-running helper=mock no_system_write=true")
            s.canvas.redraw()
    if s.test_mode and mr_gui_test_sample_failure_requested() != 0:
        refresh(s)
    elif s.elapsed_ms % 3000 == 0:
        refresh(s)
    if not s.test_mode or s.test_timeout_ms <= 0: return
    if s.elapsed_ms >= s.test_timeout_ms:
        mr_ci_emit("CI_QUIT source=bounded_test_timer")
        ui.quit()

fn settings_scroll_tick(s: &mut MainWindow):
    if not s.settings_open: return
    let delta = mr_gui_take_settings_scroll_steps()
    if delta == 0: return
    let x = f64(mr_gui_settings_scroll_x())
    let y = f64(mr_gui_settings_scroll_y())
    let changed = settings_ui.scroll(&mut s.settings, x, y, f64(ui_geometry.settings_client_width_px()), f64(ui_geometry.settings_client_height_px()), delta)
    if s.test_mode: mr_ci_emit(f"CI_SETTINGS_SCROLL_DISPATCH x={x} y={y} delta={delta} changed={changed}")
    if changed: s.settings_canvas.redraw()

fn activate(s: &mut MainWindow, target: f64):
    if target == 1.0 or target == 2.0 or target == 3.0 or target == 4.0:
        let selected = i64(target)
        if s.menu == selected and s.popup == 1:
            s.popup = 0
            s.menu = 0
        else:
            s.menu = selected
            s.popup = 1
            s.focus = f64(selected - 1)
            s.menu_focus = first_root_menu_target(selected)
        if s.test_mode: mr_ci_emit(f"CI_MENU root={s.menu} open={s.popup == 1}")
        if s.popup == 1: log_popup(s, "root", &menu_rect(s))
    elif target == 20.0:
        s.popup = 2
        s.menu = 0
        s.focus = 4.0
        s.menu_focus = 500.0
        s.status = label(s.zh, "Cleaning is not enabled in this build", "当前版本尚未开放内存清理")
        if s.test_mode: mr_ci_emit("CI_CLEAN_MENU open=true")
        log_popup(s, "clean", &clean_popup_rect(s))
    elif target == 19.0:
        if (s.clean_simulation or s.clean_production) and clean_simulation_can_start(s.clean_state):
            s.clean_state = 1
            s.clean_confirm_focus = 0
            s.status = ""
            if s.test_mode:
                let confirm_mode = if s.clean_simulation: "simulation" else: "production"
                mr_ci_emit(f"CI_CLEAN_CONFIRM open=true mode={confirm_mode}")
        else:
            s.status = if clean_operation_busy(s.clean_state): clean_result_status(s.zh, s.clean_state) else: label(s.zh, "Cleaning is disabled pending safety review", "安全验收完成前，清理操作保持禁用")
            if s.test_mode: mr_ci_emit("CI_CLEAN_DISABLED action=none")
    elif target == 710.0 and s.clean_state == 1:
        if not s.sample_ok:
            s.clean_state = 12
            s.status = clean_result_status(s.zh, 12)
            if s.test_mode: mr_ci_emit("CI_CLEAN_SIM result=not-started-sample-unavailable mock_helper_called=false no_system_write=true")
        else:
            s.clean_before_available = s.mem_available
            let start_result = if s.clean_simulation: mr_start_reclaim_mock(0) else: mr_start_reclaim(0)
            if start_result == 0:
                s.clean_state = 2
                s.status = clean_progress_status(s.clean_simulation, s.zh, 2)
                let backend = if s.clean_simulation: "mock" else: "pkexec"
                let marker = if s.clean_simulation: "CI_CLEAN_SIM" else: "CI_CLEAN"
                if s.test_mode: mr_ci_emit(f"{marker} stage=confirmed observed_memavailable_before_kib={s.clean_before_available} source=/proc/meminfo backend={backend} started=true")
            else:
                s.clean_state = clean_start_failure_state(start_result)
                s.status = clean_result_status(s.zh, s.clean_state)
                if s.test_mode: mr_ci_emit(f"CI_CLEAN result=start-failed start_state={start_result} automatic_retry=false")
    elif target == 711.0 and s.clean_state == 1:
        s.clean_state = 5
        s.status = clean_result_status(s.zh, 5)
        if s.test_mode:
            let cancel_backend = if s.clean_simulation: "mock" else: "pkexec"
            let cancel_marker = if s.clean_simulation: "CI_CLEAN_SIM" else: "CI_CLEAN"
            let cancel_note = if s.clean_simulation: " no_system_write=true" else: ""
            mr_ci_emit(f"{cancel_marker} result=confirmation-cancelled stage=confirmation backend={cancel_backend} helper_called=false{cancel_note}")
    elif target >= 30.0 and target < 33.0:
        let group = i64(target - 30.0)
        s.collapsed_groups = ui_geometry.toggle_group_collapse(s.collapsed_groups, group)
        if s.test_mode: mr_ci_emit(f"CI_GROUP_COLLAPSE group={group} collapsed={ui_geometry.group_is_collapsed(s.collapsed_groups, group)}")
    elif target >= 40.0 and target < 43.0:
        s.selected_group = i64(target - 40.0)
        if s.test_mode: mr_ci_emit(f"CI_GROUP_SELECT group={s.selected_group} selected=true")
    elif target == 101.0:
        set_settings_open(s, true)
    elif target == 102.0:
        if s.test_mode: mr_ci_emit("CI_EXIT source=file_menu")
        ui.quit()
    elif target == 201.0 or target == 203.0:
        s.status = label(s.zh, "This Windows setting is not available yet", "此原版设置尚未实现")
        s.popup = 0
    elif target == 202.0:
        let next_theme = if s.dark: 0 else: 1
        s.popup = 0
        persist_theme(s, next_theme)
        if s.test_mode: mr_ci_emit(f"CI_THEME dark={s.dark}")
    elif target == 204.0:
        s.popup = 3
        s.menu_focus = 601.0
        if s.test_mode: mr_ci_emit("CI_LANGUAGE_MENU open=true")
        log_popup(s, "language", &language_rect(s))
    elif target == 301.0 or target == 302.0 or target == 303.0 or target == 304.0:
        s.status = label(s.zh, "This startup/update action is not implemented", "启动或更新操作尚未实现")
        s.popup = 0
    elif target == 401.0 or target == 402.0 or target == 403.0:
        s.status = label(s.zh, "This help action is not implemented", "帮助操作尚未实现")
        s.popup = 0
    elif target == 601.0:
        s.popup = 0
        s.menu = 0
        persist_language(s, 0)
        if s.test_mode: mr_ci_emit("CI_LOCALE locale=en")
    elif target == 602.0:
        s.popup = 0
        s.menu = 0
        persist_language(s, 1)
        if s.test_mode: mr_ci_emit("CI_LOCALE locale=zh-CN")
    elif target >= 500.0 and target < 508.0:
        let index = i64(target - 500.0)
        s.popup = 0
        if index == 0:
            if clean_self_can_start(s.clean_state):
                if s.test_mode: mr_ci_emit("CI_CLEAN_SELF_MENU action=self-trim target=self only")
                run_self_reclaim(s)
            else:
                s.status = clean_result_status(s.zh, s.clean_state)
                if s.test_mode: mr_ci_emit("CI_CLEAN_SELF_MENU action=skipped reason=busy")
        elif index == 1:
            if (s.clean_simulation or s.clean_production) and clean_simulation_can_start(s.clean_state):
                s.clean_state = 1
                s.clean_confirm_focus = 0
                s.status = ""
                if s.test_mode:
                    let confirm_mode = if s.clean_simulation: "simulation" else: "production"
                    mr_ci_emit(f"CI_CLEAN_CONFIRM open=true mode={confirm_mode}")
            else:
                s.status = label(s.zh, "Page cache cleaning is disabled pending safety review", "安全验收完成前，页缓存清理保持禁用")
                if s.test_mode: mr_ci_emit("CI_CLEAN_DISABLED action=none")
        else:
            s.status = label(s.zh, "This Windows cleanup API has no approved Linux equivalent", "该 Windows 清理接口没有已批准的 Linux 等价操作")
            if s.test_mode: mr_ci_emit(f"CI_CLEAN_REGION_DISABLED index={index} action=none")
    s.canvas.redraw()
    if settings_canvas_needs_redraw(s.settings_open, target):
        s.settings_canvas.redraw()

fn move_menu_focus(s: &mut MainWindow, direction: i64):
    let mut first = 0.0
    let mut last = 0.0
    if s.popup == 2:
        first = 500.0
        last = 507.0
    elif s.popup == 3:
        first = 601.0
        last = 602.0
    elif s.popup == 1:
        let row_count = ui_geometry.root_menu_row_count(s.menu)
        let mut current_row = -1
        for row in 0..row_count:
            if root_menu_target(s.menu, row) == s.menu_focus: current_row = row
        if current_row < 0:
            s.menu_focus = first_root_menu_target(s.menu)
            return
        for _ in 0..row_count:
            current_row += direction
            if current_row < 0: current_row = row_count - 1
            if current_row >= row_count: current_row = 0
            let candidate = root_menu_target(s.menu, current_row)
            if candidate != 0.0:
                s.menu_focus = candidate
                return
    if first == 0.0: return
    if s.menu_focus < first or s.menu_focus > last:
        if direction > 0: s.menu_focus = first
        else: s.menu_focus = last
    elif direction > 0:
        s.menu_focus += 1.0
        if s.menu_focus > last: s.menu_focus = first
    else:
        s.menu_focus -= 1.0
        if s.menu_focus < first: s.menu_focus = last

fn mouse(s: &mut MainWindow, event: &ui.Mouse):
    let target = hit(s, event.x(), event.y())
    let old_hover = s.hover
    s.hover = target
    if event.down() == 1:
        s.pressed = target
        if target >= 1.0 and target <= 4.0: s.focus = target - 1.0
        if s.test_mode: mr_ci_emit(f"CI_MOUSE_DOWN target={target}")
        s.canvas.redraw()
    elif event.up() == 1:
        let was_pressed = s.pressed
        s.pressed = 0.0
        if s.test_mode: mr_ci_emit(f"CI_MOUSE_UP target={target}")
        if was_pressed != 0.0 and was_pressed == target:
            if s.test_mode: mr_ci_emit(f"CI_MOUSE_ACTION target={target}")
            activate(s, target)
        else:
            if s.test_mode: mr_ci_emit("CI_MOUSE_ACTION target=none")
        s.canvas.redraw()
    elif old_hover != target:
        if s.test_mode and target != 0.0: mr_ci_emit(f"CI_MOUSE_HOVER target={target}")
        s.canvas.redraw()

fn key(s: &mut MainWindow, event: &ui.Key):
    if event.released(): return
    let name = event.name()
    if s.test_mode: mr_ci_emit(f"CI_KEY name={name}")
    if s.clean_state == 1:
        if name == "Escape" or name == "Esc" or name == "\x1b":
            activate(s, 711.0)
        elif name == "Tab" or name == "\t":
            s.clean_confirm_focus = 1 - s.clean_confirm_focus
            if s.test_mode:
                let choice = if s.clean_confirm_focus == 0: "confirm" else: "cancel"
                mr_ci_emit(f"CI_CLEAN_CONFIRM_FOCUS choice={choice}")
        elif name == "Enter" or name == "Return" or name == "\r" or name == "\n":
            activate(s, if s.clean_confirm_focus == 0: 710.0 else: 711.0)
        s.canvas.redraw()
        return
    elif name == "Escape" or name == "Esc" or name == "\x1b":
        s.popup = 0
        s.menu = 0
        s.pressed = 0.0
        if s.test_mode: mr_ci_emit(f"CI_MENU closed reason=Escape focus={s.focus}")
    elif name == "Tab" or name == "\t":
        s.focus = next_focus_index(s.focus)
        if s.test_mode: mr_ci_emit(f"CI_FOCUS value={s.focus}")
    elif name == "F1":
        s.status = label(s.zh, "About page is not implemented yet", "关于页面尚未实现")
    elif name == "F2":
        set_settings_open(s, true)
    elif name == "Down" or name == "Up":
        if s.popup == 0:
            if s.focus < 4.0:
                if s.focus < 0.0: s.focus = 0.0
                s.menu = i64(s.focus) + 1
                s.popup = 1
                s.menu_focus = first_root_menu_target(s.menu)
            else:
                s.popup = 2
                s.menu_focus = 500.0
        else:
            if name == "Down": move_menu_focus(s, 1)
            else: move_menu_focus(s, -1)
        if s.test_mode: mr_ci_emit(f"CI_FOCUS item={s.menu_focus}")
    elif name == "Right" or name == "Left":
        if s.popup == 1:
            if name == "Right": s.menu += 1
            else: s.menu -= 1
            if s.menu < 1: s.menu = 4
            if s.menu > 4: s.menu = 1
            s.focus = f64(s.menu - 1)
            s.menu_focus = first_root_menu_target(s.menu)
        elif s.popup == 3 and name == "Left":
            s.popup = 1
            s.menu_focus = 204.0
        else:
            if s.focus < 0.0: s.focus = 0.0
            elif name == "Right": s.focus += 1.0
            else: s.focus -= 1.0
            if s.focus < 0.0: s.focus = 4.0
            if s.focus > 4.0: s.focus = 0.0
        if s.test_mode: mr_ci_emit(f"CI_FOCUS value={s.focus} item={s.menu_focus}")
    elif name == "Enter" or name == "Return" or name == "\r" or name == "\n":
        if s.popup != 0:
            activate(s, s.menu_focus)
        elif s.focus == 4.0:
            activate(s, 20.0)
        else:
            if s.focus < 0.0: s.focus = 0.0
            s.menu = i64(s.focus) + 1
            s.popup = 1
            s.menu_focus = first_root_menu_target(s.menu)
        if s.test_mode: mr_ci_emit("CI_KEY_ACTION Enter")
    s.canvas.redraw()

fn draw_settings(s: &mut MainWindow, p: &ui.Painter):
    settings_ui.draw(&mut s.settings, p, s.zh, s.dark, p.width(), p.height())

fn settings_mouse(s: &mut MainWindow, event: &ui.Mouse):
    let width = f64(ui_geometry.settings_client_width_px())
    let height = f64(ui_geometry.settings_client_height_px())
    let target = settings_ui.hit(&s.settings, event.x(), event.y(), width, height)
    if event.down() == 1:
        settings_ui.pointer(&mut s.settings, target, true)
        if s.test_mode: mr_ci_emit(f"CI_SETTINGS_MOUSE_DOWN target={target}")
        s.settings_canvas.redraw()
    elif event.up() == 1:
        let was_pressed = s.settings.pressed
        let action = settings_ui.release(&mut s.settings, target, s.zh)
        if s.test_mode: mr_ci_emit(f"CI_SETTINGS_MOUSE_UP target={target}")
        if was_pressed != 0.0 and was_pressed == target:
            if action == 1: set_settings_open(s, false)
            elif action == 10: persist_language(s, 0)
            elif action == 11: persist_language(s, 1)
            elif action == 12: reset_preferences(s)
            if s.test_mode: mr_ci_emit(f"CI_SETTINGS_MOUSE_ACTION target={target}")
        s.settings_canvas.redraw()
        s.canvas.redraw()
    else:
        let old_hover = s.settings.hover
        settings_ui.pointer(&mut s.settings, target, false)
        if old_hover != target:
            if s.test_mode: mr_ci_emit(f"CI_SETTINGS_MOUSE_MOVE target={target}")
            s.settings_canvas.redraw()

fn settings_key(s: &mut MainWindow, event: &ui.Key):
    if event.released(): return
    let name = normalized_key_name(event.name())
    if s.test_mode: mr_ci_emit(f"CI_SETTINGS_KEY_EVENT name={name}")
    let action = settings_ui.key(&mut s.settings, name, s.zh)
    if action == 1:
        set_settings_open(s, false)
    elif action == 10:
        persist_language(s, 0)
    elif action == 11:
        persist_language(s, 1)
    elif action == 12:
        reset_preferences(s)
        if s.test_mode:
            if s.zh: mr_ci_emit("CI_LOCALE locale=zh-CN source=IDC_LANGUAGE_123")
            else: mr_ci_emit("CI_LOCALE locale=en source=IDC_LANGUAGE_123")
    s.settings_canvas.redraw()
    s.canvas.redraw()

fn test_normalized_settings_key_names():
    assert(normalized_key_name("\t") == "Tab")
    assert(normalized_key_name("\r") == "Enter")
    assert(normalized_key_name("\x1b") == "Escape")
    assert(normalized_key_name("Page_Up") == "PageUp")
    assert(normalized_key_name("Page_Down") == "PageDown")

fn test_initial_menu_focus_is_hidden_and_tab_starts_at_file():
    assert(not menu_item_has_keyboard_focus(-1.0, 0))
    assert(next_focus_index(-1.0) == 0.0)
    assert(next_focus_index(4.0) == 0.0)

fn test_shared_theme_and_language_changes_redraw_open_settings():
    assert(settings_canvas_needs_redraw(true, 202.0))
    assert(settings_canvas_needs_redraw(true, 601.0))
    assert(settings_canvas_needs_redraw(true, 602.0))
    assert(not settings_canvas_needs_redraw(false, 202.0))
    assert(not settings_canvas_needs_redraw(false, 601.0))
    assert(not settings_canvas_needs_redraw(true, 204.0))

fn test_font_policy_name_reports_only_a_confirmed_result():
    assert(font_policy_name(0) == "unavailable")
    assert(font_policy_name(1) == "Liberation Sans")
    assert(font_policy_name(2) == "system-default")

fn close_window(s: &mut MainWindow):
    if s.test_mode: mr_ci_emit("CI_WINDOW_CLOSE")
    if s.settings_open: set_settings_open(s, false)
    ui.quit()

fn main():
    let test_mode = mr_gui_test_mode() != 0
    let preferences_status = mr_preferences_load()
    let mut initial_zh = false
    let mut initial_dark = false
    if preferences_status == 0 or preferences_status == 1:
        initial_zh = mr_preferences_language() == 1
        initial_dark = mr_preferences_theme() == 1
    let initial_language_value = if initial_zh: 1 else: 0
    let initial_theme_value = if initial_dark: 1 else: 0
    let width = ui_geometry.main_window_width_px()
    let height = ui_geometry.main_window_height_px()
    let window = ui.window("Mem Reduct", width, height)
    let canvas = ui.canvas()
    window.set_child(canvas)
    let settings_width = ui_geometry.settings_window_width_px()
    let settings_height = ui_geometry.settings_window_height_px()
    let settings_window = ui.window("Settings - Mem Reduct", settings_width, settings_height)
    let settings_canvas = ui.canvas()
    settings_window.set_child(settings_canvas)
    let font_policy = mr_gui_set_compat_font()
    let font_family = font_policy_name(font_policy)
    let fixed_size_policy = mr_gui_lock_window_sizes(width, height, settings_width, settings_height)
    let main_background_ready = mr_gui_set_main_background(if initial_dark: 1 else: 0)
    let clean_simulation = test_mode and mr_gui_test_clean_simulation_enabled() != 0
    # Production cleaning is compiled in but stays inert unless the build opted in.
    let clean_production = not clean_simulation and mr_production_clean_enabled() != 0
    let test_timeout = mr_gui_test_timeout_ms()
    let capture_scheduled = mr_gui_test_schedule_capture()
    let initial_selected_group = mr_gui_test_selected_group()
    if test_mode:
        mr_ci_emit("CI_PRODUCTION_START")
        mr_ci_emit(f"CI_TEST_TIMEOUT_MS={test_timeout}")
        mr_ci_emit(f"CI_CAPTURE_SCHEDULED={capture_scheduled}")
        mr_ci_emit(f"CI_WINDOW_SIZE_POLICY fixed={fixed_size_policy}")
        mr_ci_emit(f"CI_FONT_POLICY result={font_policy} family={font_family} size_pt=8")
        mr_ci_emit(f"CI_MAIN_BACKGROUND initialized={main_background_ready}")
        mr_ci_emit(f"CI_PREFERENCES load_status={preferences_status} language={initial_language_value} theme={initial_theme_value} can_save={mr_preferences_can_save() != 0}")
        mr_ci_emit(f"CI_CLEAN_SIM enabled={clean_simulation} mock_bridge_connected={clean_simulation} production_bridge_connected={clean_production}")
        if initial_selected_group >= 0: mr_ci_emit(f"CI_GROUP_SELECT group={initial_selected_group} selected=true source=test-fixture")
        mr_ci_emit(f"CI_GEOMETRY resource=IDD_MAIN:224x214_dlu provisional_window={width}x{height}")
        mr_ci_emit(f"CI_SETTINGS_GEOMETRY resource=IDD_SETTINGS_*:260x168_dlu provisional_shell={settings_width}x{settings_height} canvas={ui_geometry.settings_client_width_px()}x{ui_geometry.settings_client_height_px()}")
    let app: ui.App[MainWindow] = ui.app()
    if test_mode and mr_gui_test_log_canvas_font() == 0:
        mr_ci_emit("CI_GTK_FONT status=unavailable")
    app.on_draw(canvas, draw)
    app.on_mouse(canvas, mouse)
    app.on_key(canvas, key)
    app.on_draw(settings_canvas, draw_settings)
    app.on_mouse(settings_canvas, settings_mouse)
    app.on_key(settings_canvas, settings_key)
    app.on_close(close_window)
    app.every(1000, tick)
    app.every(50, settings_scroll_tick)
    let mut state = MainWindow(
        canvas: canvas, settings_canvas: settings_canvas, width: f64(width - 12), height: f64(height - 12),
        zh: initial_zh, dark: initial_dark, menu: 0, popup: 0, hover: 0.0, pressed: 0.0,
        focus: -1.0, menu_focus: 0.0, collapsed_groups: 0, selected_group: initial_selected_group, status: "", mem_total: 0, mem_available: 0, swap_total: 0,
        swap_free: 0, page_cache_estimate: 0, sample_ok: false, draw_logged: false,
        test_mode: test_mode, test_timeout_ms: test_timeout, elapsed_ms: 0, ci_sample_failure_latched: false, sample_failure_draw_logged: false,
        clean_simulation: clean_simulation, clean_production: clean_production,
        clean_self: true,
        clean_state: 0, clean_confirm_focus: 0, clean_before_available: 0,
        preferences_load_status: preferences_status,
        settings_open: false, settings: settings_ui.initial(test_mode)
    )
    state.status = preferences_load_feedback(initial_zh, preferences_status)
    if mr_gui_test_start_settings() != 0: set_settings_open(&mut state, true)
    refresh(&mut state)
    app.run(window, state)
    if test_mode: mr_ci_emit("CI_APP_RETURNED")
