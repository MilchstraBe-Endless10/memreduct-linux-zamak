# Read-only check of the fixed privileged chain (helper / polkit action /
# pkexec). Lets the window name the missing component instead of showing the
# unattributable "outcome unconfirmed" that a bare pkexec 126/127 produces.
extern fn mr_reclaim_preflight() -> i64
extern fn mr_self_reclaim() -> i64
# Read-only cross-process planner (ADR-0007): scans procfs, pins pidfds, and
# reports what a later advise WOULD touch. It never writes and never advises;
# the writable half is a separate gated translation unit.
extern fn mr_crossproc_plan_status() -> i64
extern fn mr_crossproc_plan_targets() -> i64
extern fn mr_crossproc_plan_regions() -> i64
extern fn mr_crossproc_plan_bytes() -> i64
extern fn mr_crossproc_plan_error() -> i64
extern fn mr_crossproc_plan_skipped(reason: i64) -> i64
# Read-only enumeration of the user's own processes (Issue #12, M1.1). It lists
# what a reclaim COULD cover; it never touches any process. The helper re-derives
# all of it independently from the kernel and may still refuse.
extern fn mr_cand_scan_run() -> i64
extern fn mr_cand_count() -> i64
extern fn mr_cand_scanned() -> i64
extern fn mr_cand_skipped(reason: i64) -> i64
