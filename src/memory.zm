# /proc/meminfo comes from the kernel. All values are KiB.
use std/fs
use std/string

pub struct Snapshot:
    total: i64
    available: i64
    page_cache: i64
    reclaimable_slab: i64
    swap_total: i64
    swap_free: i64

    pub fn used(&self) -> i64:
        max(0, self.total - self.available)

    pub fn percent(&self) -> i64:
        percent_hundredths(self.used(), self.total) // 100

    pub fn swap_used(&self) -> i64:
        max(0, self.swap_total - self.swap_free)

fn parse_kib_value(raw: &string, key: &string) -> i64!string:
    let fields = raw.words()
    if len(fields) < 2: fail f"missing value or unit for {key}"
    if fields[1] != "kB": fail f"invalid unit for {key}; expected kB"
    let value = string.parse_i64(fields[0]) catch e:
        fail f"invalid value for {key}"
    if value < 0: fail f"negative value for {key}"
    value

pub fn read_key(text: &string, key: &string) -> i64!string:
    for line in text.lines():
        let parts = line.split(":")
        if len(parts) < 2: continue
        if parts[0] != key: continue
        return parse_kib_value(&parts[1], key)?
    fail f"missing field {key}"

fn read_optional_key(text: &string, key: &string) -> i64!string:
    for line in text.lines():
        let parts = line.split(":")
        if len(parts) < 2: continue
        if parts[0] != key: continue
        return parse_kib_value(&parts[1], key)?
    0

pub fn parse(text: &string) -> Snapshot!string:
    let total = read_key(text, "MemTotal")?
    let available = read_key(text, "MemAvailable")?
    let swap_total = read_key(text, "SwapTotal")?
    let swap_free = read_key(text, "SwapFree")?
    let page_cache = read_optional_key(text, "Cached")?
    let reclaimable_slab = read_optional_key(text, "SReclaimable")?
    if total <= 0 or available > total:
        fail "无效或不完整的 /proc/meminfo"
    if swap_free > swap_total:
        fail "SwapFree exceeds SwapTotal"
    Snapshot(
        total: total,
        available: available,
        page_cache: page_cache,
        reclaimable_slab: reclaimable_slab,
        swap_total: swap_total,
        swap_free: swap_free
    )

pub fn sample() -> Snapshot!string:
    let text = fs.read("/proc/meminfo")?
    parse(text)?

pub fn mib(kib: i64) -> i64:
    kib // 1024

pub fn percent_hundredths(used_kib: i64, total_kib: i64) -> i64:
    if total_kib <= 0: return 0
    (max(0, used_kib) * 10000) // total_kib

pub fn percent_thousandths(used_kib: i64, total_kib: i64) -> i64:
    if total_kib <= 0: return 0
    (max(0, used_kib) * 100000 + total_kib // 2) // total_kib

fn test_read_key() -> !string:
    let sample = "MemTotal:      4096000 kB\nMemAvailable: 2048000 kB\nCached: 12345 kB\n"
    assert read_key(sample, "Cached")? == 12345
    let mut missing_rejected = false
    read_key(sample, "Missing") catch e:
        missing_rejected = true
    assert missing_rejected

fn test_parse_and_used() -> !string:
    let input = "MemTotal: 8192000 kB\nMemAvailable: 4096000 kB\nCached: 1024000 kB\nSReclaimable: 256000 kB\nSwapTotal: 2097152 kB\nSwapFree: 1048576 kB\n"
    let snapshot = parse(input)?
    assert snapshot.percent() == 50
    assert snapshot.page_cache == 1024000
    assert snapshot.reclaimable_slab == 256000
    assert snapshot.swap_used() == 1048576

fn test_percent_hundredths():
    assert percent_hundredths(1072, 15989) == 670
    assert percent_hundredths(1, 3) == 3333
    assert percent_hundredths(-1, 100) == 0
    assert percent_hundredths(1, 0) == 0

fn test_percent_thousandths():
    assert percent_thousandths(1072, 15989) == 6705
    assert percent_thousandths(1, 3) == 33333
    assert percent_thousandths(-1, 100) == 0
    assert percent_thousandths(1, 0) == 0

fn test_rejects_invalid():
    let mut rejected = false
    parse("Cached: 1 kB\n") catch e:
        rejected = true
    assert rejected

fn test_zero_swap_is_valid_but_missing_swap_is_not() -> !string:
    let no_swap = "MemTotal: 1024 kB\nMemAvailable: 512 kB\nSwapTotal: 0 kB\nSwapFree: 0 kB\n"
    let snapshot = parse(no_swap)?
    assert snapshot.swap_total == 0
    assert snapshot.swap_free == 0
    let mut missing_rejected = false
    parse("MemTotal: 1024 kB\nMemAvailable: 512 kB\nSwapTotal: 0 kB\n") catch e:
        missing_rejected = true
    assert missing_rejected

fn test_rejects_missing_required_fields():
    let mut missing_total_rejected = false
    parse("MemAvailable: 512 kB\nSwapTotal: 0 kB\nSwapFree: 0 kB\n") catch e:
        missing_total_rejected = true
    assert missing_total_rejected
    let mut missing_available_rejected = false
    parse("MemTotal: 1024 kB\nSwapTotal: 0 kB\nSwapFree: 0 kB\n") catch e:
        missing_available_rejected = true
    assert missing_available_rejected
    let mut missing_swap_total_rejected = false
    parse("MemTotal: 1024 kB\nMemAvailable: 512 kB\nSwapFree: 0 kB\n") catch e:
        missing_swap_total_rejected = true
    assert missing_swap_total_rejected

fn test_rejects_malformed_negative_and_inconsistent_values():
    let mut malformed = false
    parse("MemTotal: invalid kB\nMemAvailable: 512 kB\nSwapTotal: 0 kB\nSwapFree: 0 kB\n") catch e:
        malformed = true
    assert malformed
    let mut negative = false
    parse("MemTotal: 1024 kB\nMemAvailable: -1 kB\nSwapTotal: 0 kB\nSwapFree: 0 kB\n") catch e:
        negative = true
    assert negative
    let mut available_exceeds_total = false
    parse("MemTotal: 1024 kB\nMemAvailable: 1025 kB\nSwapTotal: 0 kB\nSwapFree: 0 kB\n") catch e:
        available_exceeds_total = true
    assert available_exceeds_total
    let mut negative_swap_total = false
    parse("MemTotal: 1024 kB\nMemAvailable: 512 kB\nSwapTotal: -1 kB\nSwapFree: 0 kB\n") catch e:
        negative_swap_total = true
    assert negative_swap_total
    let mut negative_swap_free = false
    parse("MemTotal: 1024 kB\nMemAvailable: 512 kB\nSwapTotal: 0 kB\nSwapFree: -1 kB\n") catch e:
        negative_swap_free = true
    assert negative_swap_free
    let mut inconsistent_swap = false
    parse("MemTotal: 1024 kB\nMemAvailable: 512 kB\nSwapTotal: 0 kB\nSwapFree: 1 kB\n") catch e:
        inconsistent_swap = true
    assert inconsistent_swap

fn test_optional_cache_components_default_to_zero() -> !string:
    let input = "MemTotal: 1024 kB\nMemAvailable: 512 kB\nSwapTotal: 0 kB\nSwapFree: 0 kB\n"
    let snapshot = parse(input)?
    assert snapshot.page_cache == 0
    assert snapshot.reclaimable_slab == 0

fn test_rejects_non_kib_meminfo_values():
    let mut wrong_required_unit = false
    parse("MemTotal: 1 MB\nMemAvailable: 512 kB\nSwapTotal: 0 kB\nSwapFree: 0 kB\n") catch e:
        wrong_required_unit = true
    assert wrong_required_unit
    let mut wrong_optional_unit = false
    parse("MemTotal: 1024 kB\nMemAvailable: 512 kB\nCached: 2 MB\nSwapTotal: 0 kB\nSwapFree: 0 kB\n") catch e:
        wrong_optional_unit = true
    assert wrong_optional_unit
